use tkbluetooth;

BlueToothServer bts;

if(bts.create(1/*portNr*/))
{
   for(;;)
   {
      if(bts.waitForClient(100/*millisec*/))
      {
         if(bts.acceptClient())
         {
            BlueToothAddress clientAddr <= bts.clientAddress;
            trace "[dbg] client connected from "+clientAddr;

            Buffer buf;
            buf.size = 128;
            for(;;)
            {
               if(bts.recv(buf) > 0)
               {
                  if(0 != buf.peekI8(0))
                  {
                     // trace "xxx recvd "+buf.offset+" bytes from client";
                     String s = "hello from server";
                     buf.offset = 0;
                     buf.writeString(s, 0, s.length);
                     if(bts.send(buf) <= 0)
                        break;
                  }
                  else
                     break;
               }
               else
                  break;
            }
            bts.closeClient();
            trace "[dbg] client disconnected";
         }
      }
   }
}
