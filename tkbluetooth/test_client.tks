use tkbluetooth;


BlueToothClient btc;

btc.scanTest();

BlueToothAddress *localAddr;
localAddr <= btc.localAddress;
if(null != localAddr)
{
   trace "[dbg] localAddr="+localAddr;
}

trace "[dbg] localName=\""+btc.localName+"\"";

// String remoteName = "raspberrypi";
String remoteName = "HAMW006";
BlueToothAddress *remoteAddr;
remoteAddr <= btc.findAddrByName(remoteName);

if(null != remoteAddr)
{
   trace "[dbg] resolve remote name \""+remoteName+"\" to "+remoteAddr;

   if(btc.connect(remoteAddr, 1/*portNr*/))
   {
      trace "[dbg] connect() succeeded.";

      Buffer buf;
      buf.size = 128;
      String s = "hello from client";
      int t = milliSeconds();
      int iter = 0;
      loop(600)
      {
         buf.offset = 0;
         buf.writeString(s, 0, s.length);
         btc.send(buf);
         btc.recv(buf);
         // String sReply; buf.offset = 0; buf.readString(sReply, 128);
         // trace "xxx sReply["+iter+"] = \""+sReply+"\"";
         iter++;
      }
      t = milliSeconds() - t;
      trace "[dbg] 600 roundtrips took "+t+" milliseconds";
      buf.offset = 0;
      buf.i8 = 0;
      btc.send(buf);
      btc.close();
   }
   else
   {
      trace "[---] connect() FAILED.";
   }
}
else
{
   trace "[---] failed to resolve remote name \""+remoteName+"\"";
}
