use tkbluetooth;

class BTCProcess {
   Process process;

   protected method readUntilMarker(String _r, String _marker) : boolean {
      _r.empty();

      int i;

      for(i=0; i < 10; i++)
      {
         int avail = process.getNumAvail(1000);
         trace "xxx readUntilString: avail="+avail;
         String res;
         process.readString(res, 16384);
         _r.append(res);
         if(_r & _marker)
         {
            trace "xxx readUntilString: found marker";
            return true;
         }
      }

      return false;
   }

   protected method waitForPrompt() : boolean {
      String r;
      return readUntilMarker(r, "[bluetooth]");
   }

   public method listDevices() {
      // process.exec("/bin/ls", null);
      process.exec("/usr/bin/bluetoothctl", null);

      String res = "";

      // TKS.sleep(500);

      trace "xxx listDevices: wait startup";
      if(readUntilMarker(res, "[bluetooth]"))
      {
         trace "xxx res.length="+res.length;
         res.replaceChar(27, ' ');
         trace "xxx res=\""+res+"\"";

         process.writeString("devices\n");

         trace "xxx listDevices: wait devices";
         if(readUntilMarker(res, "[bluetooth]"))
         {
            trace "xxx res.length="+res.length;
            res.replaceChar(27, ' ');
            trace "xxx res=\""+res+"\"";

            process.writeString("quit\n");
         }
      }

      process.kill();
      trace "xxx exiting";
      exit(10);
   }
   
}

function ProcessTest() {
   BTCProcess process;
   process.listDevices();
}

ProcessTest();
