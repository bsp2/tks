   public static DrawActiveTabBorder(float _x, float _y, float _w, float _h) {
      sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_LIGHT));

      if(BeginLines(6))
      {
         sdvg_Vertex2f(_x, _y+_h-1);
         sdvg_Vertex2f(_x, _y+2   );

         sdvg_Vertex2f(_x,   _y+2);
         sdvg_Vertex2f(_x+2, _y  );

         sdvg_Vertex2f(_x+2,        _y);
         sdvg_Vertex2f(_x+_w-3+2+1, _y);
         sdvg_End();
      }

      sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_DIM));
      if(BeginPointsSquare(2))
      {
         sdvg_Vertex2f(_x+_w-2+2-1, _y+1);
         sdvg_Vertex2f(_x+_w+1-1,   _y+2);
         sdvg_End();
      }

      sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_DARK));
      if(BeginLineStrip(2))
      {
         sdvg_Vertex2f(_x+_w-1+2, _y+2   );
         sdvg_Vertex2f(_x+_w-1+2, _y+_h-1);
         sdvg_End();
      }
   }

   public static DrawInactiveTabBorder(int _x, float _y,
                                       float _w, float _h,
                                       boolean _bLastActive,
                                       boolean _bNextActive
                                       ) {

      if(!_bLastActive)
      {
         sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_WINDOW_BG));
         if(BeginPointsSquare(3))
         {
            sdvg_Vertex2f(_x+2, _y);
            sdvg_Vertex2f(_x+3, _y);
            sdvg_Vertex2f(_x+2, _y+1);
            sdvg_End();
         }
      }

      sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_LIGHT));
      int maxVerts = 19;
      BeginLines(maxVerts);
      if(!_bLastActive)
      {
         sdvg_Vertex2f(_x+2, _y+_h-1);
         sdvg_Vertex2f(_x+2, _y+2   );

         sdvg_Vertex2f(_x+2,   _y+2);
         sdvg_Vertex2f(_x+2+2, _y  );

         sdvg_Vertex2f(_x+2+2, _y);
         if(_bNextActive)
            sdvg_Vertex2f(_x+_w-3, _y);
         else
            sdvg_Vertex2f(_x+_w-1, _y);
      }
      else
      {
         sdvg_Vertex2f(_x+2, _y);
         sdvg_Vertex2f(_x+_w-1, _y);
      }

      if(_bNextActive)
      {
         sdvg_Vertex2f(_x+2+2, _y);
         sdvg_Vertex2f(_x+_w, _y);
      }
      else
      {
         sdvg_Vertex2f(_x+2+_w-3, _y);
         sdvg_Vertex2f(_x+2+_w-1, _y+2);
         sdvg_End();

         sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_DIM));
         BeginLines(maxVerts);
         sdvg_Vertex2f(_x+2+_w-2, _y);
         sdvg_Vertex2f(_x+2+_w-1, _y+2);
         sdvg_Vertex2f(_x+2+_w-1, _y+2);
         sdvg_Vertex2f(_x+2+_w-1, _y+_h-1);
         sdvg_End();

         sdvg_SetColorARGB(lnf_colors.get(LookAndFeel.COLOR_BORDER_DARK));
         BeginLines(maxVerts);
         sdvg_Vertex2f(_x+2+_w-1, _y+2);
         sdvg_Vertex2f(_x+2+_w-1, _y+_h-1);
      }
      sdvg_End();
   }

