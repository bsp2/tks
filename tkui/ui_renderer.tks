   //          (and just keep the basic primitives in this class)
   static IntArray *lnf_colors;

   static Texture tex_pattern_1111;  define int LINE_PATTERN_1111 = 0;  // 2#0001000100010001
   static Texture tex_pattern_3333;  define int LINE_PATTERN_3333 = 1;  // 2#0011001100110011
   static Texture tex_pattern_5555;  define int LINE_PATTERN_5555 = 2;  // 2#0101010101010101
   static Texture tex_pattern_7777;  define int LINE_PATTERN_7777 = 3;  // 2#0111011101110111
   static Texture tex_pattern_9999;  define int LINE_PATTERN_9999 = 4;  // 2#1001100110011001
   static Texture tex_pattern_1313;  define int LINE_PATTERN_1313 = 5;  // 2#0001001100010011

   static Texture *[] pattern_textures = [tex_pattern_1111,
                                          tex_pattern_3333,
                                          tex_pattern_5555,
                                          tex_pattern_7777,
                                          tex_pattern_9999,
                                          tex_pattern_1313
                                          ];


   static Init() {
      trace "[dbg] UIRenderer::Init: b_glcore="+b_glcore;
      sdvg_SetScratchBufferSize(sdvg_scratchbuffer_size);
      sdvg_SetGLSLVersion(b_glcore/*bV3*/, false/*bGLES*/, null/*sVersionStringOrNull*/);
      zglEnableGLCore(b_glcore);
      sdvg_Init(b_glcore);
   }

   static OnOpen() {
      zglEnableGLCore(UIRenderer.b_glcore);
      sdvg_OnOpen();
      CreateLinePatternTextures();
   }

   static Exit() {
      sdvg_Exit();
   }

   static CreateLinePatternTex(Texture _tex, int _patLen, int _pattern) {
      _tex.unload();
      _tex.alloc(128,1,1);
      _tex.flags = TEX_MODULATE | TEX_ALPHA;
      int x = 0;
      loop(_tex.sx)
         _tex.setXY32(x++, 0, (_pattern & (1 << (x % _patLen))) ? 255 : 0);
      _tex.upload();
   }

   static CreateLinePatternTextures() {
      CreateLinePatternTex(tex_pattern_1111, 16, #1111);
      CreateLinePatternTex(tex_pattern_3333, 16, #3333);
      CreateLinePatternTex(tex_pattern_5555, 16, #5555);
      CreateLinePatternTex(tex_pattern_7777, 16, #7777);
      CreateLinePatternTex(tex_pattern_9999, 16, #9999);
      CreateLinePatternTex(tex_pattern_1313, 16, #1313);
   }

   static BeginFilledTrianglesEx(int _numVertices, boolean _bBuiltinShader) : boolean {
      if(_bBuiltinShader)
         sdvg_BindShader(0);
      // else: custom shader must have "u_transform", "u_color_fill", "a_vertex"
      return sdvg_BeginFilledTriangles(_numVertices);
   }

   static BeginFilledTriangles(int _numVertices) : boolean {
      return BeginFilledTrianglesEx(_numVertices, true/*bBuiltinShader*/);
   }

