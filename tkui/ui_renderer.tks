   static BeginPointsSquare(int _numPoints) : boolean {
      if(0 == _numPoints)
      {
         trace "[!!!] UIRenderer.BeginPointsSquare: numPoints == 0 !!";
         return false;
      }
      return sdvg_BeginPointsSquare(_numPoints);
   }

