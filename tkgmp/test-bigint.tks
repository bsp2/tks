use "tkgmp";

BigInt a,b,c;
a=6;
b=2;
c=a+b;
trace "a="+a+" b="+b+" c=a+b="+c;

c=a/b;
trace "a="+a+" b="+b+" c=a/b="+c;

BigInt d;
d="314159111222333444555666777888999000";
trace "d="+d;
d.base=2;
trace "d_base2="+d;
d.base=16;
trace "d_base16="+d;
d.base=36;
trace "d_base36="+d;
d.base=10;
d=d*b;
trace "d=d*b="+d;
d=d*2;
trace "d=d*2="+d;

trace "Serializing test";
Buffer buff;
buff.size=1024;
buff<<d;

trace "Serialized "+buff.offset+" bytes.";


BigInt e;
buff.offset=0;
e<<buff;

trace "After deserialising e="+e;
d=d*-1.0;
trace "d=-d="+d;
buff.offset=0;
buff<<d;
trace "Serialized "+buff.offset+" bytes.";
buff.offset=0;
e<<buff;
trace "now e="+e+" d="+d;
