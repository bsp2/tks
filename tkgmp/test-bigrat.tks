use tkgmp;

BigRat a,b;
a=1;
a.canonicalize();
b=2;
b.canonicalize();
a=a+b;

trace "a="+a;
a=a/2;
trace "unnu a="+a;

b="4/7";
trace "b="+b;

trace "a+b="+(a+b);
trace "a="+a;
trace "b="+b;
b.numerator="12";
b.canonicalize();
trace "b="+b;
trace "b.denumerator="+(b.denumerator);
b=5;
b.denumerator=125;
trace "---"+b;
b.canonicalize();
trace "b="+b;
