   // <ui_show.png>
   public method showAudioTrackMenu(boolean _bFocusFirst) {
      // // if(null != getSelectedModelClip())
      if(1)
      {
         pm_audiotrack <= PopupMenu.New(this);
         PopupMenuButton *pmb;
         PopupMenu pm <= pm_audiotrack;
         PopupMenu *spm;

         int audioTrackIdx = -1;
         SampleTimelineModelTrack modelTrack <= getSelectedModelTrack();
         if(null != modelTrack)
            audioTrackIdx = current_project.findAudioTrackIndexByUniqueId(modelTrack.audio_track_unique_id);

         pmb <= pm.addRadioButton(" *:<first record-enabled audio track>",
                                  (-1 == audioTrackIdx),
                                  "audiotrack_0"
                                  );

         AudioTrack *audioTrack;
         Integer audioTrackNr = 1;
         foreach audioTrack in current_project.audio_tracks
         {
            pmb <= pm.addRadioButton(audioTrackNr.printf("%2d")+":"+audioTrack.name+" ("+audioTrack.unique_id+")",
                                     ((audioTrackIdx+1) == audioTrackNr),
                                     "audiotrack_"+audioTrackNr
                                     );
            audioTrackNr++;
         }

         // Recording panel
         if(null == f_audiotrackmenu)
         {
            f_audiotrackmenu <= new SampleTimelineAudioTrackMenuForm;
            f_audiotrackmenu.initSampleTimelineAudioTrackMenuForm(this/*parentForm*/);
         }

         pm.addSeparator();
         pm.addItemLayer(f_audiotrackmenu);

         f_audiotrackmenu.setModelTrack(modelTrack);
         if(null != modelTrack)
         {
            f_audiotrackmenu.setRecordingMode(modelTrack.rec_mode);
            f_audiotrackmenu.setVoiceModuloNumVoices(modelTrack.rec_num_voices);
         }
         else
         {
            // not reachable ?!
            f_audiotrackmenu.setRecordingMode(SampleTimelineModelTrack.REC_DEFAULT);
            f_audiotrackmenu.setVoiceModuloNumVoices(1);
         }

         pm.resizeToMinimum();
         pm.showNearMouse(-10, -10);
         if(_bFocusFirst)
            pm.focusNextMenuItem();

         Global.Print("Show audio-track menu");
      }
      else
      {
         Global.Warning("No clip selected");
      }
   }

   // <ui_kbd.png>
   public virtual onKey(Key _k) : boolean {
      // trace "[>>>] SampleTimelineForm::onKey: key="+_k.name+" pressed="+_k.pressed+" mod="+_k.mod;

      switch(_k.pressed)
      {
         case 'a':
            if(_k.modNone())
            {
               if(sample_timeline_editor.timelineHaveSelection())
               {
                  showSelectionContextMenu(true/*bFocusFirst*/, true/*bAddEditItem*/);
               }
               else
               {
                  showContextMenu(true/*bFocusFirst*/);
               }
               return true;
            }
            break;

         case 'c':
            if(_k.modAltOnly())
            {
               handleCopyTimelineToClipboard();
               return true;
            }
            break;

         case 'g':
            if(_k.modNone())
            {
               cb_sync_loop_to_selection.toggleSelectionAction();
               return true;
            }
            break;

         case 'r':
            if(_k.modCtrl())
            {
               handleCloneOrAllocClipSample(_k.modShift()/*bPreferEmpty*/);
               return true;
            }
            break;

         case 'v':
            if(_k.modAltOnly())
            {
               handlePasteTimelineFromClipboard();
               return true;
            }
            break;

         case VKEY_SPACE:
            handleToggleReplay(!_k.modNone()/*bCursor*/);
            return true;

         case VKEY_HOME:
            if(_k.modNone())
            {
               cf_model.selectNextOptionAction();
               return true;
            }
            break;

         case VKEY_END:
            if(_k.modNone())
            {
               cf_model.selectPreviousOptionAction();
               return true;
            }
            break;
      }

      // Try SampleView
      if(sv_wave.onKey(_k))
         return true;

      return XMLForm::onKey(_k);
   }

   // <ui_mouse.png>
   public virtual onMouseClick(MouseEvent _ev) : boolean {
      if(_ev.isRightButton())
      {
         boolean bHaveSelection = sample_timeline_editor.timelineHaveSelection();
         // // trace "xxx SampletimelineForm::onMouseClick: haveSel="+bHaveSelection;
         if(!bHaveSelection)
         {
            sample_timeline_editor.timelineSelectClipAtXY(_ev.mouse_rel_x - sample_timeline_editor.position_x,
                                                          _ev.mouse_rel_y - sample_timeline_editor.position_y
                                                          );
         }
         // // trace "xxx SampletimelineForm::onMouseClick: 2 haveSel="+sample_timeline_editor.timelineHaveSelection();
         if(sample_timeline_editor.timelineHaveSelection())
         {
            showSelectionContextMenu(false/*bFocusFirst*/, true/*bAddEditItem*/);
         }
         else
         {
            showContextMenu(false/*bFocusFirst*/);
         }
         return true;
      }
      return XMLForm::onMouseClick(_ev);
   }

   // <ui_mouse.png>
   public virtual onMouse(MouseEvent _ev) : boolean {
      if(_ev.wheelUp() || _ev.wheelDown())
      {
         return true;
      }
      return XMLForm::onMouse(_ev);
   }

  // <ui_consume.png>
   public virtual consumeAction(Action _action) : boolean {
      ActionProvider ap <= _action.getActionProvider();
      String acName <= _action.getActionName();
      PageProject pgProject <= root_form.pg_project;

      if(TA_REDRAW == acName)
      {
         sample_timeline_editor.redraw();
         return true;
      }

      switch(@(ap))
      {
         default:
            boolean bMod = ((Dial.ACTION_MODVALUECHANGING == acName) ||
                            (Dial.ACTION_MODVALUECHANGED  == acName)
                            );
            if(tryHandleLaneSendLevelChanged(ap, bMod))
               return true;
            if(tryHandleLaneSendPanChanged(ap, bMod))
               return true;
            return false;

         case @(pm_context):
            Global.Debug("pm_context acName="+acName);
            switch(acName)
            {
               case PopupMenu.ACTION_CANCEL:
               case "":
                  Global.Print("Close context menu.");
                  refocusDefault();
                  return true;

               case "replay_toggle_loop":
                  handleToggleReplay(false/*bCursor*/);
                  refocusDefault();
                  return true;

               case "replay_toggle_cursor":
                  handleToggleReplay(true/*bCursor*/);
                  refocusDefault();
                  return true;

               case "loop_set_clips":
                  sample_timeline_editor.handleSetLoop(false/*bPreferRegion*/, true/*bKbdSelectNone*/);
                  refocusDefault();
                  return true;

               case "loop_set_region":
                  sample_timeline_editor.handleSetLoop(true/*bPreferRegion*/, true/*bKbdSelectNone*/);
                  refocusDefault();
                  return true;

               case "select_until_end":
                  sample_timeline_editor.timelineSelectUntilEnd();
                  redraw();
                  refocusDefault();
                  return true;

               case "select_cycle":
                  sample_timeline_editor.timelineToggleSelectTrackClipsOrAllClips();
                  redraw();
                  refocusDefault();
                  return true;

               case "select_none":
                  sample_timeline_editor.timelineSelectNone();
                  redraw();
                  refocusDefault();
                  return true;

               case "clip_copy":
                  sample_timeline_editor.handleClipCopy();
                  refocusDefault();
                  return true;

               case "clip_cut":
                  sample_timeline_editor.handleClipCut();
                  refocusDefault();
                  return true;

               case "timeline_copy":
                  handleCopyTimelineToClipboard();
                  refocusDefault();
                  return true;

               case "clip_paste":
                  sample_timeline_editor.handleClipPaste(false/*bShift*/);
                  refocusDefault();
                  return true;

               case "clip_paste_shift":
                  sample_timeline_editor.handleClipPaste(true/*bShift*/);
                  refocusDefault();
                  return true;

               case "timeline_paste":
                  handlePasteTimelineFromClipboard();
                  refocusDefault();
                  return true;

               case "insert_space":
                  sample_timeline_editor.timelineShiftClipsBySelection(false/*bAllTracks*/, false/*bDelete*/);
                  refocusDefault();
                  redraw();
                  return true;

               case "insert_space_all_tracks":
                  sample_timeline_editor.timelineShiftClipsBySelection(true/*bAllTracks*/, false/*bDelete*/);
                  refocusDefault();
                  redraw();
                  return true;

               case "delete":
                  sample_timeline_editor.handleDelete(false/*bAllTracks*/);
                  refocusDefault();
                  return true;

               case "delete_all_tracks":
                  sample_timeline_editor.handleDelete(true/*bAllTracks*/);
                  refocusDefault();
                  return true;

               case "undo":
                  sample_timeline_editor.timelineUndo();
                  refocusDefault();
                  return true;

               case "redo":
                  sample_timeline_editor.timelineRedo();
                  refocusDefault();
                  return true;

                  // Misc submenu
               case "misc_snap_toggle":
                  sample_timeline_editor.timelineToggleSnap();
                  refocusDefault();
                  return true;

               case "misc_snap_units":
                  sample_timeline_editor.timelineCycleSnapUnits();
                  refocusDefault();
                  return true;

               case "misc_normalize_waveform_display":
                  sample_timeline_editor.toggleNormalizeClipWaveformDisplay();
                  refocusDefault();
                  return true;

               case "misc_draw_clip_labels":
                  sample_timeline_editor.timelineToggleDrawClipLabels();
                  refocusDefault();
                  return true;

                  // Mode submenu
               case "mode_select":
                  sample_timeline_editor.handleKeyQ();
                  refocusDefault();
                  return true;

               case "mode_draw":
                  sample_timeline_editor.handleKeyW(false/*bShift*/, true/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "mode_erase":
                  sample_timeline_editor.handleKeyE(true/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "mode_razor":
                  sample_timeline_editor.handleKeyR(true/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "mode_expand_or_split":
                  sample_timeline_editor.handleKeyRShift();
                  refocusDefault();
                  return true;

               case "mode_mute":
                  sample_timeline_editor.handleKeyT(true/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

            }
            return true;

         case @(pm_selection):
            Global.Debug("pm_selection acName="+acName);
            switch(acName)
            {
               case PopupMenu.ACTION_CANCEL:
               case "":
                  Global.Print("Close selection menu.");
                  refocusDefault();
                  return true;

               case "edit_clip_sample":
                  sample_timeline_editor.timelineEditFirstSelectedClip();
                  return true;

               case "loop_set_clips":
                  sample_timeline_editor.handleSetLoop(false/*bPreferRegion*/, true/*bKbdSelectNone*/);
                  refocusDefault();
                  return true;

               case "loop_set_region":
                  sample_timeline_editor.handleSetLoop(true/*bPreferRegion*/, true/*bKbdSelectNone*/);
                  refocusDefault();
                  return true;

               case "select_until_end":
                  sample_timeline_editor.timelineSelectUntilEnd();
                  redraw();
                  refocusDefault();
                  return true;

               case "select_cycle":
                  sample_timeline_editor.timelineToggleSelectTrackClipsOrAllClips();
                  redraw();
                  refocusDefault();
                  return true;

               case "select_none":
                  sample_timeline_editor.timelineSelectNone();
                  redraw();
                  refocusDefault();
                  return true;

               case "clip_copy":
                  sample_timeline_editor.handleClipCopy();
                  refocusDefault();
                  return true;

               case "clip_cut":
                  sample_timeline_editor.handleClipCut();
                  refocusDefault();
                  return true;

               case "clip_erase":
                  sample_timeline_editor.handleKeyE(false/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "clip_razor":
                  sample_timeline_editor.handleKeyR(false/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "clip_mute":
                  sample_timeline_editor.handleKeyT(false/*bAllowModeChange*/);
                  refocusDefault();
                  return true;

               case "clip_merge":
                  sample_timeline_editor.timelineMergeClipsFromKbdSelection();
                  sample_timeline_editor.timelineMarkAsModified();
                  refocusDefault();
                  return true;
            }
            return true;

         case @(pm_audiotrack):
            Global.Debug("pm_audiotrack acName="+acName+" ap="+#(ap));
            switch(acName)
            {
               case PopupMenu.ACTION_CANCEL:
               case "":
                  Global.Print("Close audio-track menu.");
                  refocusDefault();
                  return true;

               default:
                  if(acName <= "audiotrack_")
                  {
                     handleAudioTrackChanged(int(acName.replace("audiotrack_","")) - 1);
                     refocusDefault();
                  }
                  break;
            }
            return true;

         case @(cf_model):
            if(ComboField.ACTION_OPTIONADDED == acName)
            {
               // should not be reachable
               refocusDefault();
            }
            else if(ComboField.ACTION_OPTIONSELECTED == acName)
            {
               handleModelChanged();
            }
            else if(ComboField.ACTION_OPTIONRESELECTED == acName)
            {
               refocusDefault();
            }
            else if(ComboField.ACTION_OPTIONREMOVED == acName)
            {
               // should not be reachable
               refocusDefault();
            }
            else
            {
               // Rename model
               if(ComboField.ACTION_OPTIONEDITED/*char typed*/ == acName)
               {
               }
               else if(ComboField.ACTION_OPTIONRENAMED == acName)
               {
                  handleModelNameChanged(cf_model.getSelectedOptionName());
                  refocusDefault();
               }
            }
            return true;

         case @(fp_canvas_size):
            handleCanvasSizeChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_bpm):
            handleBeatsPerMinuteChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(cb_use_project_bpm):
            handleUseProjectBPMChanged();
            return true;

         case @(fp_sig_beats):
            handleSigBeatsChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(cm_sig_notelen):
            handleSigNotelenChanged();
            return true;

         case @(cb_sync_loop_to_selection):
            handleSyncLoopToSelectionChanged();
            return true;

         case @(tf_track_name):
            handleTrackNameChanged();
            if(TextField.ACTION_TEXTENTERED == acName)
               refocusDefault();
            return true;

         case @(bt_track_new):
            handleTrackNew();
            return true;

         case @(bt_track_delete):
            if(Button.ACTION_HOLD_CLICK == acName)
            {
               handleTrackDelete();
            }
            else
            {
               Global.Warning("hold-click to delete track");
            }
            return true;

         case @(tf_clip_name):
            trace "xxx tf_clip_name: acName=\""+acName+"\"";
            handleClipNameChanged();
            if(TextField.ACTION_TEXTENTERED == acName)
               refocusDefault();
            return true;

         case @(bt_clip_name_from_sample):
            handleCopyClipNameFromSample();
            return true;

         case @(fp_clip_fade_in):
            handleClipFadeInChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_fade_out):
            handleClipFadeOutChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_offset):
            handleClipOffsetChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(cb_clip_release):
            handleEnableClipReleaseChanged();
            return true;

         case @(fp_clip_vel_on):
            handleClipVelOnChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_vel_off):
            handleClipVelOffChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_cc_mw):
            handleClipCCMWChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_cc_bc):
            handleClipCCBCChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_cc_fc):
            handleClipCCFCChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(fp_clip_cc_ex):
            handleClipCCEXChanged();
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            return true;

         case @(bt_clip_sample):
            if(Button.ACTION_HOLD_CLICK == acName)
            {
               handleCloneOrAllocClipSample(false/*bPreferEmpty*/);
            }
            else
            {
               handleEditClipSample();
            }
            return true;

         case @(bt_clip_sample_rec):
            if(Button.ACTION_HOLD_CLICK == acName)
            {
               showAudioTrackMenu(false/*bFocusFirst*/);
            }
            else
            {
               if(bt_clip_sample_rec.getToggleState())
               {
                  // Start recording
                  handleToggleClipRec();
               }
               else
               {
                  // Stop recording
                  handleToggleReplay(false/*bCursor*/);
               }
            }
            return true;

         case @(cb_track_master_volume):
            handleTrackMasterVolumeChanged();
            return true;

         case @(sv_wave):
            if(SampleView.ACTION_WAVEFORM_CHANGED == acName)
            {
               Sample sample <= getSelectedSample();
               if(null != sample)
               {
                  sample.markWaveformAsModified();
                  sample.analyzeAndUpdatePartials();
                  showClipDetails(getSelectedEditorClip(), true/*bWidgets*/, false/*bSampleView*/);
                  current_project.markAsModified();
                  redraw();
               }
            }
            else if(SampleView.ACTION_HIGHLIGHT_CHANGED == acName)
            {
               handleHLChanged(sv_wave.getSortedHighlightStart(),
                               sv_wave.getSortedHighlightLength()
                               );
            }
            return true;
      }

      return Form::consumeAction(_action);
   }

}
