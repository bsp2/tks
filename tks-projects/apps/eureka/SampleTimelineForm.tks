   // <method.png>
   public method addOverlays() {
      // Layer lRoot <= getRoot();
      // trace "xxx SampleTimelineForm::addOverlays: root="+#(lRoot)+" data="+#(sample_timeline_editor.data);
      root_form.addOverlay(sample_timeline_editor.data);
