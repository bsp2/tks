   // <ui_handle.png>
   protected method handleCloneOrAllocClipSample(boolean _bPreferEmpty) {
      SampleTimelineEditorClip editorClip <= getSelectedEditorClip();
      if(null != editorClip)
      {
         SampleTimelineModelClip   modelClip   <= editorClip.model_clip;
         SampleTimelineEditorTrack editorTrack <= editorClip.parent_track;
         SampleTimelineModelTrack  modelTrack  <= editorTrack.model_track;
         Sample sampleOrNull <= current_project.getSampleByIdx(modelClip.sample_idx);
         Sample *sampleNew;
         local String sampleName;
         if(null != sampleOrNull)
         {
            if(_bPreferEmpty)
            {
               // Create new, empty sample the size of the currently selected clip
               sampleName = modelTrack.name;
               sampleNew <= current_project.newEmptyAudioClipSample16th(sampleOrNull.namespace_idx,
                                                                        sampleName,
                                                                        -1/*idxHint*/,
                                                                        sampleOrNull.getWaveformNum16ths(),
                                                                        sampleOrNull.getWaveformNumChannels()
                                                                        );
            }
            else
            {
               // Create a copy of the currently selected clip sample
               sampleNew <= current_project.cloneSample(sampleOrNull);
            }
         }
         else
         {
            // Create new, empty sample
            sampleName = modelTrack.name;
            int nspIdx = SampleTimelineEditorTrack.GenerateAudioClipSampleNameAndNamespaceIdxFromTrackName(sampleName/*nameInOut*/);
            int numCh = modelTrack.findPreferredNumCh();
            sampleNew <= current_project.newEmptyAudioClipSample16th(nspIdx,
                                                                     sampleName,
                                                                     -1/*idxHint*/,
                                                                     (64+8)/*num16ths*/,
                                                                     numCh
                                                                     );
         }

         // Update clip
         if(null != sampleNew)
         {
            modelClip.setSampleIdx(current_project.getSampleIdx(sampleNew));

            // Update / redraw timeline
            sampleNew.markWaveformAsModified();
            sampleNew.analyzeAndUpdatePartials();
            showClipDetails(getSelectedEditorClip(), true/*bWidgets*/, true/*bSampleView*/);
            current_project.markAsModified();
            redraw();
         }
      }
   }

   // <ui_handle.png>
   protected =replay= method handleHLChanged(int _start, int _len) {
      // // trace "xxx SampleTimelineForm::handleHLChanged: start="+_start+" len="+_len;
      if(_start >= 0 && _len >= 4096)
      {
         if(null != current_sample)
         {
            SampleTimelineModelClip modelClip <= getSelectedModelClip();
            if(null != modelClip)  // should not be null
            {
               StWaveform wf <= current_sample.waveform;

               float numFramesPerUnit = sample_timeline.getNumFramesPerUnit(wf.sampleRate);

               modelClip.offset = round(_start / numFramesPerUnit);
               modelClip.end = modelClip.start + round(_len / numFramesPerUnit);

               sample_timeline_editor.timelineUpdate();
            }
         }
      }
   }

   // <method.png>
   public method handleTimelineKbdSelectionChanged() {
      // copy timeline selection rectangle to SampleView selection
      int selStart = sample_timeline_editor.kbd_selection_units_start_sorted;
      int selEnd   = sample_timeline_editor.kbd_selection_units_end_sorted;
      // trace "[trc] SampleTimelineForm::handleTimelineKbdSelectionChanged: selStart="+selStart+" endEnd="+selEnd;

      if(selEnd > selStart)
      {
         if(null != current_sample)
         {
            SampleTimelineModelClip modelClip <= getSelectedModelClip();
            if(null != modelClip)  // should not be null
            {
               StWaveform wf <= current_sample.waveform;

               selStart -= modelClip.start;
               selEnd   -= modelClip.start;

               if(selStart >= 0)
               {
                  float numFramesPerUnit = sample_timeline.getNumFramesPerUnit(wf.sampleRate);
                  int offStart = selStart * numFramesPerUnit;
                  int offEnd   = selEnd   * numFramesPerUnit;

                  sv_wave.setSelection(offStart, offEnd);
                  sv_wave.redraw();
                  return true;
               }
            }
         }
      }
      sv_wave.selectNone();
   }

   // <ui_handle.png>
   protected method handleCopyTimelineToClipboard() {
      if(null != sample_timeline_edit_model)
      {
         if(null == timeline_clipboard)
            timeline_clipboard <= new Buffer;

         sample_timeline_edit_model.saveStateToBuffer(timeline_clipboard);

         Global.Print("Copy timeline to clipboard ("+timeline_clipboard.size+" bytes)");
      }
      else
      {
         Global.Warning("Timeline model is unused");
      }
   }

   // <ui_handle.png>
   protected method handlePasteTimelineFromClipboard() {
      if(null != sample_timeline_edit_model)
      {
         if(null != timeline_clipboard)
         {
            if(sample_timeline_edit_model.loadStateFromBuffer(timeline_clipboard))
            {
               showTrack(parent_track);
               Global.Print("Paste timeline from clipboard ("+timeline_clipboard.size+" bytes)");
            }
            else
            {
               Global.Error("Failed to paste timeline state from clipboard");
            }
         }
         else
         {
            Global.Warning("Timeline clipboard is empty");
         }
      }
      else
      {
         Global.Error("Failed to paste timeline state: model is null");
      }
   }

   // <ui_handle.png>
   protected method handleToggleReplay(boolean _bCursor) {
      if(null != sample_timeline)
      {
         Global.Debug2("SampleTimelineForm::handleToggleReplay: current_rec_sample="+#(current_rec_sample));
         if(null != current_rec_sample && replay.b_seq_playing)
         {
            // Stop (=> handleStopClipRec())
            replay.toggleSeq(true/*bRec*/);
         }
         else
         {
            sample_timeline.toggleReplay(_bCursor
                                         ? sample_timeline_editor.cursor_units/*playPos*/
                                         : sample_timeline.loop_start
                                         );
         }

      }
   }

   // <method.png>
   protected =replay= method tryCreateClipAtCursorPos() {
      SampleTimelineModelTrack modelTrack <= getSelectedModelTrack();
      if(null != modelTrack)
      {
         int unitsPerBeat = sample_timeline_editor.num_units_per_beat;
         trace "xxx sample_timeline_editor.num_beats_per_bar="+sample_timeline_editor.num_beats_per_bar;
         int unitsPerBar = unitsPerBeat * sample_timeline_editor.num_beats_per_bar * 2;
         int start = sample_timeline_editor.cursor_units;
         int end = sample_timeline_editor.cursor_units + unitsPerBar;
         if(null == modelTrack.findClipInRange(start, end))
         {
            SampleTimelineModelClip modelClip <= modelTrack.newClipInitAutoId(start, end);
            sample_timeline_editor.timelineUpdate();
            sample_timeline_editor.timelineSelectClipUnderCursor(true/*bTouch*/);
            sample_timeline_editor.timelineSetLoop(start, end-start);
            sample_timeline_editor.timelineMarkAsModified();
         }
      }
   }

   // <ui_handle.png>
   public method handleToggleClipRec() : boolean {
      // called from UI thread by onTriadKey() handler
      if(null != sample_timeline)
      {
         if(null == getSelectedModelClip())
         {
            tryCreateClipAtCursorPos();
         }

         if(null != getSelectedModelClip())
         {
            if(!root_form.isAudioRecording())
            {
               // Lazy-alloc sample
               SampleTimelineEditorClip editorClip <= getSelectedEditorClip();
               if(null != editorClip && null == current_sample)
               {
                  handleCloneOrAllocClipSample(true/*bPreferEmpty*/);
               }

               if(null != current_sample)
               {
                  if(current_sample.b_audio_clip)
                  {
                     // Auto-record-enable audio-track
                     SampleTimelineModelTrack modelTrack <= getSelectedModelTrack();
                     if(null != modelTrack)
                     {
                        AudioTrack audioTrack <= current_project.findAudioTrackByUniqueId(modelTrack.audio_track_unique_id);
                        if(null != audioTrack)
                        {
                           current_project.setRecordEnableSingleAudioTrack(audioTrack);
                        }
                        // else: record from first enabled audio-track
                     }

                     // Find first record-enable audio-track
                     //  (todo) support recording to multiple clip samples from multiple audio-tracks
                     //  (todo) support audio-track selection (TBD)
                     AudioTrack *atrack;
                     AudioTrack atrackRec <= null;
                     foreach atrack in current_project.audio_tracks
                     {
                        if(atrack.b_record)
                        {
                           atrackRec <= atrack;
                           break;
                        }
                     }
                     if(null != atrackRec)
                     {
                        if(current_sample.waveform.getNumChannels() == (atrackRec.b_stereo ? 2 : 1))
                        {
                           current_rec_sample <= current_sample;
                           current_rec_atrack <= atrackRec;
                           current_rec_sample.b_clip_recording = true;
                           Global.Debug("SampleTimelineForm::handleToggleClipRec: start");
                           replay.queueStartSampleTimeline_Sync(sample_timeline);
                           // // root_form.toggleAudioRecording();  // prepare recording
                           root_form.enableRecCheckBoxForClipRecording();
                           current_project.prepareRecord();
                           bt_clip_sample_rec.setToggleState(true);

                           if(null != modelTrack)
                           {
                              int autoMuteNum16ths = 0;
                              switch(modelTrack.rec_mode)
                              {
                                 default:
                                 case SampleTimelineModelTrack.REC_DEFAULT:
                                    Global.Debug("SampleTimelineModelTrack.REC_DEFAULT: latency="+STConfig.atrk_rec_skip_num_frames);
                                    SysEx.QueueSendSeqStart();
                                    break;

                                 case SampleTimelineModelTrack.REC_AUTO_MUTE:
                                    if(null != editorClip)
                                    {
                                       autoMuteNum16ths = editorClip.timelineClipGetNum16ths();
                                    }
                                    Global.Debug("SampleTimelineModelTrack.REC_AUTO_MUTE: latency="+STConfig.atrk_rec_skip_num_frames+" autoMuteNum16th="+autoMuteNum16ths);
                                    SysEx.QueueSendSeqStartVoiceModuloAutoMute(0/*numVoices*/,
                                                                               0/*moduloAdvance16ths*/,
                                                                               autoMuteNum16ths
                                                                               );
                                    break;

                                 case SampleTimelineModelTrack.REC_AUTO_MUTE_DISCARD:
                                    if(null != editorClip)
                                    {
                                       autoMuteNum16ths = editorClip.timelineClipGetNum16ths() * 2;
                                    }
                                    Global.Debug("SampleTimelineModelTrack.REC_AUTO_MUTE_DISCARD: latency="+STConfig.atrk_rec_skip_num_frames+" autoMuteNum16th="+autoMuteNum16ths);
                                    SysEx.QueueSendSeqStartVoiceModuloAutoMute(0/*numVoices*/,
                                                                               0/*moduloAdvance16ths*/,
                                                                               autoMuteNum16ths
                                                                               );
                                    break;

                                 case SampleTimelineModelTrack.REC_VOICE_MODULO:
                                    int moduloAdvance16ths = editorClip.timelineClipGetNum16ths();
                                    Global.Debug("SampleTimelineModelTrack.REC_VOICE_MODULO: latency="+STConfig.atrk_rec_skip_num_frames+" modelTrack.rec_num_voices="+modelTrack.rec_num_voices+" moduloAdvance16ths="+moduloAdvance16ths);
                                    SysEx.QueueSendSeqStartVoiceModuloAutoMute(modelTrack.rec_num_voices,
                                                                               moduloAdvance16ths,
                                                                               0/*autoMuteNum16ths*/
                                                                               );
                                    break;
                              }
                              // wait for SEQ_START_ACK before starting timeline replay and audio track recording
                           }
                           else
                           {
                              SysEx.QueueSendSeqStart();
                              // wait for SEQ_START_ACK before starting timeline replay and audio track recording
                           }

                           // replay.toggleSeq(true/*bRec*/);
                           // sample_timeline.toggleReplay(sample_timeline.loop_start, STConfig.sample_timeline_clip_rec_skip_num_frames);
                           Global.Print("Start clip rec (src atrack=\""+atrackRec.name+"\")");
                           return true;
                        }
                        else
                        {
                           Global.Warning("Rec<start>: sample<=>atrack channel count mismatch");
                        }
                     }
                     else
                     {
                        Global.Warning("Rec<start>: no record-enabled audio track found");
                     }
                  }
                  else
                  {
                     Global.Warning("Rec: sample must be an audio clip (\"A\")");
                  }
               }
               else
               {
                  Global.Warning("Rec: no current sample");
               }
            }
            else
            {
               // trace "[dbg] SampleTimelineForm::handleToggleClipRec: stop";
               Global.Warning("Rec: audiotrack recording already active");
            }
         }
         else
         {
            Global.Warning("Rec: no clip");
         }
      }
      else
      {
         Global.Warning("Rec: no timeline");
      }
      bt_clip_sample_rec.setToggleState(false);
      return false;
   }

   // <ui_handle.png>
   public method handleStopClipRec() {
      // called from UI thread by RootForm::handleStopRecord()
      if(null != current_rec_sample && null != current_rec_atrack)
      {
         AudioClip clip <= current_rec_atrack.clip;
         clip.lazyMergeSegments();
         FloatArray fa <= clip.getCurrentSampleData();
         if(null != fa)
         {
            unsetCurrentSample();
            current_rec_sample.replaceClipWaveformData_Sync(fa, STConfig.sample_timeline_clip_rec_skip_num_frames);
            int newNumFrames = current_rec_sample.waveform.getNumFrames();
            float newNumSec = newNumFrames / (current_rec_sample.waveform.getSampleRate());
            current_rec_sample.b_clip_recording = false;

            SampleTimelineEditorClip editorClip <= getSelectedEditorClip();
            if(null != editorClip)
            {
               showClipDetails(editorClip, false/*bWidgets*/, true/*bSampleView*/); // update SampleView highlight
               ta_redraw.schedule();

               // Mix / Overdub modulo voices
               SampleTimelineModelTrack modelTrack <= getSelectedModelTrack();
               if(null != modelTrack)
               {
                  int numUnits = editorClip.timelineClipGetLen();
                  StWaveform wf <= current_rec_sample.waveform;
                  float numFramesF = sample_timeline.getNumFramesPerUnit(wf.sampleRate) * numUnits;
                  int numFrames = numFramesF + 0.5f;
                  int availNumFrames = sv_wave.getNumFrames();

                  if(SampleTimelineModelTrack.REC_AUTO_MUTE_DISCARD == modelTrack.rec_mode)
                  {
                     sv_wave.setSelection(numFrames, availNumFrames);
                     sv_wave.cutSelection();
                     Global.Print("Discard first cycle (numFrames="+numFrames+" availNumFrames="+availNumFrames+")");
                  }
                  else if(SampleTimelineModelTrack.REC_VOICE_MODULO == modelTrack.rec_mode)
                  {
                     Global.Debug2("handleStopClipRec: availNumFrames="+availNumFrames+" reqNumFrames="+numFrames);
                     if(availNumFrames >= numFrames)
                     {
                        if(modelTrack.rec_num_voices >= 2)
                        {
                           int voiceIdx = 1;
                           int numVoicesDone = 1;
                           loop(modelTrack.rec_num_voices - 1)
                           {
                              int srcOff = numFramesF * voiceIdx + 0.5f;
                              if( ((srcOff + numFrames) <= availNumFrames) || 
                                  ((numVoicesDone+1) == modelTrack.rec_num_voices)
                                  )
                              {
                                 Global.Debug2("handleStopClipRec: mix voice "+(voiceIdx+1)+"/"+modelTrack.rec_num_voices+" srcOff="+srcOff+" numFrames="+numFrames);
                                 sv_wave.setSelection(srcOff, srcOff + numFrames);
                                 sv_wave.copySelection();
                                 sv_wave.setSelection(0, numFrames);
                                 sv_wave.addClipboardToSelection();
                                 numVoicesDone++;
                              }
                              // Next voice
                              voiceIdx++;
                           }
                           Global.Debug2("handleStopClipRec: trim overdub voice 2.."+numVoicesDone+" area ("+numFrames+","+(availNumFrames-numFrames)+")");
                           if(availNumFrames > (numFrames*2))
                           {
                              // env release, reverb trails etc
                              sv_wave.setSelection(numFrames*1.5, numFrames*2);
                              sv_wave.silenceSelection(true/*bUndoBegin*/);
                              sv_wave.setSelection(numFrames*2, availNumFrames);  // env release, reverb trails etc
                              sv_wave.cutSelection();
                           }
                           else
                           {
                              sv_wave.setSelection(numFrames, availNumFrames);
                              sv_wave.cutSelection();
                           }
                           Global.Print("Overdub-mix "+numVoicesDone+" voice"+Utils.GetPluralString(numVoicesDone));
                        }
                     }
                  }
               }
            }

            current_rec_sample <= null;
            current_rec_atrack <= null;

            Global.SuccessShort("Rec: finish clip recording ("+(int(newNumSec*100)/100.0f)+" sec)");
         }
         bt_clip_sample_rec.setToggleState(false);
      }
   }

   // <ui_handle.png>
   protected method handleAudioTrackChanged(int _audioTrackIdx) {
      Global.Debug("SampleTimelineForm::handleAudioTrackChanged: audioTrackIdx="+_audioTrackIdx);
      AudioTrack audioTrack <= current_project.getAudioTrackByIdx(_audioTrackIdx);
      SampleTimelineModelTrack modelTrack <= getSelectedModelTrack();
      if(null != modelTrack)
      {
         if(null != audioTrack)
         {
            Global.Debug("SampleTimelineForm::handleAudioTrackChanged: audioTrack.name=\""+audioTrack.name+"\" unique_id="+audioTrack.unique_id);
            modelTrack.audio_track_unique_id = audioTrack.unique_id;
            bt_clip_sample_rec.setCaption(String(_audioTrackIdx+1));
            // // updateAudioTrackSelection();
         }
         else
         {
            // Select default input (currently enabled audio tracks)
            modelTrack.audio_track_unique_id = -1;
            bt_clip_sample_rec.setCaption("*");
            // // updateAudioTrackSelection();
         }
         // else: should not be reachable
      }
      else
      {
         Global.Warning("No timeline track selected");
      }
   }

