   // <ui_hide.png>
   public method leaveForm() {
      removeOverlays();
      ta_redraw.cancel();

      replay.unsetQueuedStartSampleTimeline_Sync();

      if(null != current_rec_sample)
      {
         Global.Print("Cancel clip recording");
         current_rec_sample.b_clip_recording = false;
         current_rec_sample <= null;
         current_rec_atrack <= null;
      }
   }

   // <method.png>
   public virtual recursiveOnResize() {
