function MMUtil_FadeOutHighNotes(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_ADD);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_KEYBOARD_P);
      _zone.setMMAmt(mmIdx, -0.37f);
      _zone.setMMCurve(mmIdx, -0.33f);
      _zone.setMMSlewUp(mmIdx, 0.5f * (100.0/99.9f));  // (note) slew needed in mono realloc / free running osc mode
      _zone.setMMSlewDown(mmIdx, 0.5f * (100.0/99.9f));
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_VOLUME);
   }
}

