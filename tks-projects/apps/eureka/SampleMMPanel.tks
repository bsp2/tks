function MMUtil_PitchMiniEnv(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_ADD);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CONST_0);
      _zone.setMMAmt(mmIdx, 0.25f);
      _zone.setMMCurve(mmIdx, -0.65f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.3f * (100.0/99.9f));
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_ONE);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_FREQ);
   }
}

