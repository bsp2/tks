      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_REPLACE);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CONST_1);
      _zone.setMMAmt(mmIdx, 0.3f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_GLOBAL_REG1_INC);
   }
   mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 9 : 2);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_REPLACE);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CONST_1);
      _zone.setMMAmt(mmIdx, 0.8f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_GLOBAL_REG1_DCY);
   }
}

