module MSampleMMPanel;

use namespace ui;
use namespace st2;

boolean b_prefer_9_to_16_tmp;  // valid during MMUtil_* exec

function MMUtil_Variation(StSample _zone) {
   // (note) 'Variation' should be first modmatrix entry
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 0);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_REPLACE);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CC1_MODWHEEL_ON);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_VARIATION);
   }
}

function MMUtil_ConstantPitch(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_ADD);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_KEYBOARD_PM);
      _zone.setMMAmt(mmIdx, -1.0f/8);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_FREQ);
   }
}

