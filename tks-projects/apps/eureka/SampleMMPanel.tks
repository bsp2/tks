function MMUtil_ModSeq1CustomFreqLFO(StSample _zone) {
   // (note) set modseq1 One=0 Slew=100% Scl/Off=2/-1
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_LFO_FREQ);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_MODSEQ1_STEP);
   }
   mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 9 : 2);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_MODSEQ1);
      _zone.setMMAmt(mmIdx, 0.015f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_FREQ);
   }
}

function MMUtil_ModSeq2VelocityToVolumeLut(StSample _zone) {
   // (note) set modseq2 One=1 Slew=100%
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_VELOCITY);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_MODSEQ2_STEP);
   }
   mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 9 : 2);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_MODSEQ2);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_VOLUME_MUL);
   }
}

function MMUtil_ModSeq3Arpeggio(StSample _zone) {
   // (note) set modseq3 scl=24 off=-12
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_MODSEQ3);
      _zone.setMMAmt(mmIdx, 1.0f / (4*12));
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_FREQ);
   }
}

function MMUtil_ModSeq3FCToPatch(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CC4_FOOTCTL);
      _zone.setMMAmt(mmIdx, 127.0f);  // abs, clipped to 0..15
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_MODSEQ3_PATCH);
   }
}

function MMUtil_GranularWaveScan(StSample _zone, float _zoneRel) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   int loopLen = _zone.firstLoopLen;
   _zone.startEndFadeNumFrames = (1 << log2(loopLen / 2));
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CONST_1);
      _zone.setMMAmt(mmIdx, _zoneRel);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_SAMPLE_OFFSET);
   }
   mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 9 : 2);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CC1_MODWHEEL);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_SAMPLE_SHIFT_EOL);
   }
}

function MMUtil_LFOAuxTo2DWavetableXRel(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_LFO_AUX);
      _zone.setMMAmt(mmIdx, 0.9f);  // abs, clipped to 0..15
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_WT_2D_X_REL);
   }
}

function MMUtil_ModWheelToPlugin1Mod2(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_CC1_MODWHEEL);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_PLUGIN_1_MOD_2);
   }
}

function MMUtil_VelocityToPlugin1Mod2(StSample _zone) {
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_VELOCITY);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.0f);
      _zone.setMMSlewDown(mmIdx, 0.0f);
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_PLUGIN_1_MOD_2);
   }
}


// <class.png>
class SampleMMPanel : Panel {

   protected PopupMenu *pm_mm_context;

   protected boolean b_prefer_9_to_16;


   // <method.png>
   protected method mmUtilExec(Function _fxn) {
      PageSample pgSample <= root_form.pg_sample;
      Sample sample <= pgSample.getSelectedSample();
      if(null != sample)
      {
         b_prefer_9_to_16_tmp = b_prefer_9_to_16;
         PointerArray aZones <= pgSample.getSelectedZones();
         StSample *s;
         foreach s in aZones
            _fxn.eval({s});
         Global.Print("mmUtilExec: update "+aZones.numElements+" zone"+Utils.GetPluralString(aZones.numElements));
         sample.markParamsAsModified();
         pgSample.handleSelectSample(false/*bStopAudio*/);
      }
   }

   // <method.png>
   protected method mmUtilExecRel(Function _fxn) {
      PageSample pgSample <= root_form.pg_sample;
      Sample sample <= pgSample.getSelectedSample();
      if(null != sample)
      {
         b_prefer_9_to_16_tmp = b_prefer_9_to_16;
         PointerArray aZones <= pgSample.getSelectedZones();
         StSample *s;
         float rel = 0.0;
         float relStep = (1.0 / aZones.numElements);
         foreach s in aZones
         {
            _fxn.eval({s, rel});
            rel += relStep;
         }
         Global.Print("mmUtilExecRel: update "+aZones.numElements+" zone"+Utils.GetPluralString(aZones.numElements));
         sample.markParamsAsModified();
         pgSample.handleSelectSample(false/*bStopAudio*/);
      }
   }

   // <ui_show.png>
   protected method showMMContextMenu(boolean _bFocusFirst) {
      Global.Debug("SampleMMPanel::showMMContextMenu: bFocusFirst="+_bFocusFirst);

      pm_mm_context <= PopupMenu.New(this);
      PopupMenuButton *pmb;
      PopupMenu pm <= pm_mm_context;
      PopupMenu *spm;

      // Variation
      pmb <= pm.addDefaultButton("Variation",
                                 "mmutil_variation"
                                 );
      pmb.setToolTipCaption("ModWheel to Variation");

      // Pitch
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Pitch", deref spm);

      pmb <= spm.addDefaultButton("Constant pitch",
                                 "mmutil_constant_pitch"
                                 );
      pmb.setToolTipCaption("Constant Pitch / Cancel Osc Tracking");

      pmb <= spm.addDefaultButton("ModWheel to Freq LFO Amount (Vibrato)",
                                 "mmutil_modwheel_to_lfo_freq_amt"
                                 );
      pmb.setToolTipCaption("ModWheel to Freq LFO Amount (Vibrato)");

      pmb <= spm.addDefaultButton("Pressure to Freq LFO Amount (Vibrato)",
                                 "mmutil_pressure_to_lfo_freq_amt"
                                 );
      pmb.setToolTipCaption("Pressure to Freq LFO Amount (Vibrato)");

      pmb <= spm.addDefaultButton("Pitch Mini Decay Env",
                                 "mmutil_pitch_minienv"
                                 );
      pmb.setToolTipCaption("Pitch Mini Decay Env");

      // Volume
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Volume", deref spm);

      pmb <= spm.addDefaultButton("Velocity to Volume (+)",
                                  "mmutil_volveladd"
                                  );
      pmb.setToolTipCaption("Velocity to Volume (+)");

      pmb <= spm.addDefaultButton("Velocity to Volume (*)",
                                  "mmutil_volvelmul"
                                  );
      pmb.setToolTipCaption("Velocity to Volume (*)");

      pmb <= spm.addDefaultButton("Fade-Out High Notes",
                                  "mmutil_fadeout_high_notes"
                                  );
      pmb.setToolTipCaption("Fade-Out High Notes");

      pmb <= spm.addDefaultButton("Volume Env Decay High Notes",
                                  "mmutil_volenv_decay_high_notes"
                                  );
      pmb.setToolTipCaption("Volume Env Decay High Notes");

      pmb <= spm.addDefaultButton("Volume Mini Decay Env",
                                  "mmutil_volminienv"
                                  );
      pmb.setToolTipCaption("Volume Mini Decay Envelope");

      pmb <= spm.addDefaultButton("Volume Mini Decay Env (Fast)",
                                  "mmutil_volminienv_fast"
                                  );
      pmb.setToolTipCaption("Volume Mini Decay Envelope (Fast)");

      pmb <= spm.addDefaultButton("Volume Slew Mono",
                                  "mmutil_volslewmono"
                                  );
      pmb.setToolTipCaption("Volume Slew Mono\n\n (note) Sample Realloc Mode (\"R\") should be enabled\n (note) Sample free running OSC mode should be enabled\n (note) volume env intensity should be 0%");
      // \n (note) volume ramp up/down should be >4

      pmb <= spm.addDefaultButton("ModWheel to Volume LFO Amount (Tremolo)",
                                 "mmutil_modwheel_to_lfo_vol_amt"
                                 );
      pmb.setToolTipCaption("ModWheel to Volume LFO Amount (Tremolo)");

      // Integrate
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Integrate", deref spm);

      pmb <= spm.addDefaultButton("Integrate Pitch",
                                  "mmutil_integrate_pitch"
                                  );
      pmb.setToolTipCaption("Integrate pitch");

      pmb <= spm.addDefaultButton("Integrate Volume",
                                  "mmutil_integrate_volume"
                                  );
      pmb.setToolTipCaption("Integrate volume\n\n (note) x0x style volume accumulation");

      pmb <= spm.addDefaultButton("Integrate Filter CutOff",
                                  "mmutil_integrate_filter_cutoff"
                                  );
      pmb.setToolTipCaption("Integrate filter cutoff");

      pmb <= spm.addDefaultButton("Integrate Filter EnvAmt",
                                  "mmutil_integrate_filter_envamt"
                                  );
      pmb.setToolTipCaption("Integrate filter envelope amount");

      spm.addSeparator();
      pmb <= spm.addDefaultButton("Global Reg 1 Inc / Dcy",
                                  "mmutil_reg1_inc_dcy"
                                  );
      pmb.setToolTipCaption("Global Register 1 Increment + Decay Settings");

      pmb <= spm.addDefaultButton("Global Reg 2 Inc / Dcy",
                                  "mmutil_reg2_inc_dcy"
                                  );
      pmb.setToolTipCaption("Global Register 2 Increment + Decay Settings");

      pmb <= spm.addDefaultButton("Global Reg 3 Inc / Dcy",
                                  "mmutil_reg3_inc_dcy"
                                  );
      pmb.setToolTipCaption("Global Register 3 Increment + Decay Settings");

      pmb <= spm.addDefaultButton("Global Reg 4 Inc / Dcy",
                                  "mmutil_reg4_inc_dcy"
                                  );
      pmb.setToolTipCaption("Global Register 4 Increment + Decay Settings");

      // ModSeq
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("ModSeq", deref spm);

      pmb <= spm.addDefaultButton("ModSeq1 Custom Freq LFO",
                                  "mmutil_modseq1_custom_freq_lfo"
                                  );
      pmb.setToolTipCaption("ModSeq1 Custom Freq LFO\n\n (note) uses ModSeq 1 as a custom Freq LFO shape\n\n (note) ModSeq 1 OneShot mode should be DISABLED\n (note) Slew should be set to 100% (interpolate steps)\n (note) Scl/Off should be set to 2/-1\n (note) Freq LFO should be set to SawUp, start=0, end=0.5, offset=0.5 (=> generate 0..1 phase)");

      pmb <= spm.addDefaultButton("ModSeq2 Velocity to Volume LUT",
                                  "mmutil_modseq2_velocity_to_volume_lut"
                                  );
      pmb.setToolTipCaption("ModSeq2 Velocity to Volume LUT\n\n (note) uses ModSeq 2 as velocity lookup-table\n (note) ModSeq 2 should be set to OneShot mode\n (note) Slew should be set to 100% (interpolate steps)");

      pmb <= spm.addDefaultButton("ModSeq3 Arpeggio",
                                  "mmutil_modseq3_arpeggio"
                                  );
      pmb.setToolTipCaption("ModSeq3 to Note Freq (Arpeggio)\n (note) ModSeq 3 level should be set to 12 (notes C..B)\n\n (note) use modseq context menu to load arpeggio presets");

      pmb <= spm.addDefaultButton("ModSeq3 FC to Patch",
                                  "mmutil_modseq3_fc_to_patch"
                                  );
      pmb.setToolTipCaption("ModSeq3 CC#4 Foot-Control to Patch\n (note) CC values 0..15 select modseq patch 0..15");

      // Plugin
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Plugin", deref spm);

      pmb <= spm.addDefaultButton("ModWheel to Plugin 1 Mod 2",
                                  "mmutil_plugin_mw_to_plugin1_mod2"
                                  );
      pmb.setToolTipCaption("ModWheel to Plugin 1 Mod 2");

      pmb <= spm.addDefaultButton("Velocity to Plugin 1 Mod 2",
                                  "mmutil_plugin_vel_to_plugin1_mod2"
                                  );
      pmb.setToolTipCaption("Velocity to Plugin 1 Mod 2");

      // Misc
      pm.addSeparator();
      pmb <= pm.addDefaultButton("Granular ModWheel Wavescan",
                                 "mmutil_granular_wavescan"
                                 );
      pmb.setToolTipCaption("Granular ModWheel Wavescan\n\n (note) <n> cloned zones should be selected\n (note) loop start/end fade will be updated, too");

      pm.addSeparator();
      pmb <= pm.addDefaultButton("LFO Aux to Wavetable X Rel",
                                 "mmutil_lfoauxto2dwavetablexrel"
                                 );
      pmb.setToolTipCaption("LFO Aux to Wavetable X Rel\n\n (note) LFO Aux waveform should be set to Triangle");

      pm.addSeparator();
      pmb <= pm.addDefaultButton("Clear All Inactive Entries", "clear_all_inactive");
      pmb.setToolTipCaption("Clear / Reset all currently disabled / inactive entries");

      pm.resizeToMinimum();
      pm.showNearMouse(-10, -10);
      if(_bFocusFirst)
         pm.focusNextMenuItem();

      Global.Print("Show MM context menu.");
   }

   // <ui_mouse.png>
   public virtual onMouseClick(MouseEvent _ev) : boolean {
      if(_ev.isRightButton())
      {
         PageSample pgSample <= root_form.pg_sample;
         Sample sample <= pgSample.getSelectedSample();
         if(null != sample)
         {
            showMMContextMenu(false/*bFocusFirst*/);
         }
         return true;
      }
      return false;
   }

   // <ui_consume.png>
   public virtual consumeAction(Action _ac) : boolean {
      local String acName = _ac.getActionName();
      ActionProvider ap <= _ac.getActionProvider();
      PageSample pgSample <= root_form.pg_sample;

      switch(@(ap))
      {
         case @(pm_mm_context):
            Global.Debug("pm_mm_context acName="+acName);

            switch(acName)
            {
               case PopupMenu.ACTION_CANCEL:
               case "":
                  Global.Print("Close MM context menu.");
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_variation":
                  mmUtilExec(MMUtil_Variation);
                  pgSample.pageFocusDefault();
                  break;

                  // Pitch
               case "mmutil_constant_pitch":
                  mmUtilExec(MMUtil_ConstantPitch);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_modwheel_to_lfo_freq_amt":
                  mmUtilExec(MMUtil_ModWheelToLFOFreqAmt);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_pressure_to_lfo_freq_amt":
                  mmUtilExec(MMUtil_PressureToLFOFreqAmt);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_pitch_minienv":
                  mmUtilExec(MMUtil_PitchMiniEnv);
                  pgSample.pageFocusDefault();
                  break;

                  // Volume
               case "mmutil_volveladd":
                  mmUtilExec(MMUtil_VolVelAdd);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_volvelmul":
                  mmUtilExec(MMUtil_VolVelMul);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_fadeout_high_notes":
                  mmUtilExec(MMUtil_FadeOutHighNotes);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_volenv_decay_high_notes":
                  mmUtilExec(MMUtil_VolEnvDecayHighNotes);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_volminienv":
                  mmUtilExec(MMUtil_VolMiniEnv);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_volminienv_fast":
                  mmUtilExec(MMUtil_VolMiniEnv_Fast);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_volslewmono":
                  mmUtilExec(MMUtil_VolSlewMono);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_modwheel_to_lfo_vol_amt":
                  mmUtilExec(MMUtil_ModWheelToLFOVolAmt);
                  pgSample.pageFocusDefault();
                  break;

                  // Integrate
               case "mmutil_integrate_pitch":
                  mmUtilExec(MMUtil_IntegratePitch);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_integrate_volume":
                  mmUtilExec(MMUtil_IntegrateVolume);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_integrate_filter_cutoff":
                  mmUtilExec(MMUtil_IntegrateFilterCutOff);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_integrate_filter_envamt":
                  mmUtilExec(MMUtil_IntegrateFilterEnvAmt);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_reg1_inc_dcy":
                  mmUtilExec(MMUtil_GlobalReg1IncDcy);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_reg2_inc_dcy":
                  mmUtilExec(MMUtil_GlobalReg2IncDcy);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_reg3_inc_dcy":
                  mmUtilExec(MMUtil_GlobalReg3IncDcy);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_reg4_inc_dcy":
                  mmUtilExec(MMUtil_GlobalReg4IncDcy);
                  pgSample.pageFocusDefault();
                  break;

                  // ModSeq
               case "mmutil_modseq1_custom_freq_lfo":
                  mmUtilExec(MMUtil_ModSeq1CustomFreqLFO);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_modseq2_velocity_to_volume_lut":
                  mmUtilExec(MMUtil_ModSeq2VelocityToVolumeLut);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_modseq3_arpeggio":
                  mmUtilExec(MMUtil_ModSeq3Arpeggio);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_modseq3_fc_to_patch":
                  mmUtilExec(MMUtil_ModSeq3FCToPatch);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_granular_wavescan":
                  mmUtilExecRel(MMUtil_GranularWaveScan);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_lfoauxto2dwavetablexrel":
                  mmUtilExec(MMUtil_LFOAuxTo2DWavetableXRel);
                  pgSample.pageFocusDefault();
                  break;

                  // Plugin
               case "mmutil_plugin_mw_to_plugin1_mod2":
                  mmUtilExec(MMUtil_ModWheelToPlugin1Mod2);
                  pgSample.pageFocusDefault();
                  break;

               case "mmutil_plugin_vel_to_plugin1_mod2":
                  mmUtilExec(MMUtil_VelocityToPlugin1Mod2);
                  pgSample.pageFocusDefault();
                  break;

               case "clear_all_inactive":
                  pgSample.mmHandleClearInactive();
                  break;
            }

            return true;
      }

      return Panel::consumeAction(_ac);
   }

   public virtual beginXFMTag(AbstractXMLForm _form, HashTable _attributes) : boolean {

      if(Panel::beginXFMTag(_form, _attributes))
      {
         String *atname, *atval;
         StringArray *atsplit;
         foreach atname in _attributes
         {
            atval <= _attributes[atname];
            String atnamelc;
            atname.toLower() => atnamelc;
            switch(atnamelc)
            {
               case "prefer9to16":
                  b_prefer_9_to_16 = int(atval);
                  break;
            }
         }
      } // if Panel::beginXFMTag()

      return true;
   }

}
