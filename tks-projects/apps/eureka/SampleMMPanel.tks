function MMUtil_VolSlewMono(StSample _zone) {
   // (note) rampup+down should be >4
   // (note)   (would need free-running OSC mode to get around that)
   // (note) Sample realloc mode should be enable (re-use mono voice)
   int mmIdx = _zone.findUnusedMMEntry(b_prefer_9_to_16_tmp ? 8 : 1);
   if(mmIdx >= 0)
   {
      _zone.setMMEnable(mmIdx, true);
      _zone.setMMOp(mmIdx, STSAMPLE_MM_OP_MUL);
      _zone.setMMSrc(mmIdx, STSAMPLE_MM_SRC_ENV_VOL);
      _zone.setMMAmt(mmIdx, 1.0f);
      _zone.setMMCurve(mmIdx, 0.0f);
      _zone.setMMSlewUp(mmIdx, 0.87f * (100.0/99.9f));
      _zone.setMMSlewDown(mmIdx, 0.69f * (100.0/99.9f));
      _zone.setMMSlewReset(mmIdx, STSAMPLE_MM_SLEW_RESET_OFF);
      _zone.setMMDst(mmIdx, STSAMPLE_MM_DST_VOLUME_MUL);
   }
}

