Short tmp_i;
Short tmp2_i;
function Dmulsw(Short A, Short B) { return (A * int(B)); }
function Dmulsw_shr(Short A, Short B) { return (A * int(B)) >> 11; }
IntArray *cycle_sine_tbl_i;
IntArray dither_tbl = [5, -2, 3, 3, 5, 2, 1, 0, -3, 0, -2, 3, -9, 4, -7, -5, 1, -3, 2, 10, -3, 4, 6, 7, 9, -1, 9, -4, 8, 10, 0, 0, 5, 1, -1, -3, 0, 0, -3, 0, 1, -6, -4, 1, 0, 0, 5, -9, -1, -4, 3, 0, -3, 2, 8, 7, 0, -4, 4, 0, -4, -7, -8, -1, 3, -1, 6, 3, 2, 0, -3, 0, 0, 5, -7, -6, 4, -1, 1, -6, 1, -1, -2, 4, -3, -1, 0, 3, -4, 1, 3, 1, -2, 6, 3, -8, 6, -1, 7, -2, 2, -5, -12, -2, -7, 2, -2, 4, -5, 4, -2, 0, -2, 1, 3, 4, 0, -4, 4, 2, 1, -5, 3, 1, 5, 2, 0, 0, -1, -3, -2, 8, 6, -1, 0, 2, -5, 3, -4, -3, -4, 2, -2, 1, -1, -1, -3, -1, 1, 5, 0, -6, -2, -4, 3, -7, 0, -12, 4, -4, 0, 8, 5, 6, -2, 0, -14, 6, 3, 1, 0, 0, 1, 2, 4, 2, 0, 2, 2, 9, -4, 9, 2, -1, 2, 1, 4, -5, -7, -1, 2, 4, 9, 1, 2, 3, 4, -7, -1, 4, 2, 7, -8, -1, 0, 2, 0, 10, 0, 3, -1, -1, -3, 6, 3, 5, 0, -5, 0, -4, 4, 0, 0, -1, -9, -3, -7, -3, 4, 6, -1, 1, -9, -1, -2, -5, -4, 3, -3, 1, 0, -7, -6, 0, 0, 0, -5, -2, -1, -5, 2, -2, -6, -1, -7, -6];


//  sample_rate: 16574
//    note_freq: 261.63
//      #frames: 8288

IntArray *curve_0;
IntArray *curve_1;
IntArray *curve_2;
IntArray *curve_3;
Short var_x = 0;
Short var_out__v_rmp = 0;
Short var_out__v_rmp2 = 0;
int tmp1_rmp_cur;
Short tmp2_rmp_step;
Short tmp4_sin_speed;
Short tmp8_sin_speed;
int tmp13_rmp_cur;
Short tmp14_rmp_step;
Short tmp16_sin_speed;
Short tmp18_sin_speed;
int tmp20_slf_pos;
function Calc(FloatArray _d) {
   Short tmp5;
   Short tmp6;
   Short tmp9;
   Short tmp10;
   Short tmp11;
   Short tmp12;
   Short tmp19;
   int tmp1_rmp_cur;
   // start=0 end=1 #frames=7807.82:
   Short tmp3_sin_phase = 0;
   Short tmp7_sin_phase = 0;
   int tmp13_rmp_cur;
   // start=0 end=1 #frames=4049.54:
   Short tmp15_sin_phase = 0;
   Short tmp17_sin_phase = 0;
   int tmp20_slf_pos;
   
   tmp2_rmp_step = 33;
   tmp4_sin_speed = 258;
   tmp8_sin_speed = 778;
   tmp14_rmp_step = 64;
   tmp16_sin_speed = 258;
   tmp18_sin_speed = 526;
   tmp1_rmp_cur = 0;
   tmp3_sin_phase = 0;
   tmp7_sin_phase = 0;
   tmp13_rmp_cur = 0;
   tmp15_sin_phase = 0;
   tmp17_sin_phase = 0;
   tmp20_slf_pos = 0;
   int smpIdx = 0;
   int outIdx = 0;
   Short err = 0;
   loop(8288)
   {
      Short out = 0;
      
      // ========
      // ======== lane "out" modIdx=0 modString=rmp
      // ========
      
      // -- mod="rmp" dstVar=out
      out = (tmp1_rmp_cur >> (18-11));
      tmp1_rmp_cur += tmp2_rmp_step;
      if(tmp1_rmp_cur > 262144) tmp1_rmp_cur = 262144;
      
      // -- mod="set out__v_rmp" dstVar=out
      var_out__v_rmp = out;
      
      // -- mod="sin" dstVar=out
      
      // ---- mod="sin" input "phase" seq 1/1
      
      // -- mod="sin" dstVar=tmp6/*phase*/
      tmp9/*sin_tmp*/ = (tmp7_sin_phase);
      tmp9/*sin_tmp*/ = tmp9/*sin_tmp*/ & 0x3FFF;
      tmp6/*phase*/ = cycle_sine_tbl_i[tmp9/*sin_tmp*/];
      tmp7_sin_phase = (tmp7_sin_phase + tmp8_sin_speed) & 0x3FFF;
      
      // -- mod="$out__v_rmp" dstVar=tmp6/*phase*/
      tmp9/*seq*/ = tmp6/*phase*/;
      tmp9/*seq*/ = var_out__v_rmp;
      
      // -- mod="lut" dstVar=tmp9/*seq*/
      tmp10/*lut_idx*/ = (tmp9/*seq*/ >> 7);
      tmp11/*lut_frac*/ = (tmp9/*seq*/ & 127);
      tmp9/*seq*/ = curve_1[tmp10/*lut_idx*/ & 15];
      tmp12/*lut_r*/ = curve_1[(tmp10/*lut_idx*/ + 1) & 15];
      tmp9/*seq*/ += ((tmp12/*lut_r*/ - tmp9/*seq*/) * tmp11/*lut_frac*/) >> 7;
      tmp6/*phase*/ = (tmp6/*phase*/ * tmp9/*seq*/) >> 11;
      
      // -- mod="$P_MOD_L" dstVar=tmp6/*phase*/
      tmp6/*phase*/ = (tmp6/*phase*/ * 536) >> 11;
      tmp5/*sin_tmp*/ = ((tmp3_sin_phase + (tmp6/*phase*/ << 3)));
      tmp5/*sin_tmp*/ = tmp5/*sin_tmp*/ & 0x3FFF;
      out = cycle_sine_tbl_i[tmp5/*sin_tmp*/];
      tmp3_sin_phase = (tmp3_sin_phase + tmp4_sin_speed) & 0x3FFF;
      
      // -- mod="$out__v_rmp" dstVar=out
      tmp5/*seq*/ = out;
      tmp5/*seq*/ = var_out__v_rmp;
      
      // -- mod="lut" dstVar=tmp5/*seq*/
      tmp6/*lut_idx*/ = (tmp5/*seq*/ >> 7);
      if(tmp6/*lut_idx*/ >= 15)
         tmp6/*lut_idx*/ = 14;
      else if(tmp6/*lut_idx*/ < 0)
         tmp6/*lut_idx*/ = 0;
      tmp9/*lut_frac*/ = (tmp5/*seq*/ & 127);
      tmp5/*seq*/ = curve_0[tmp6/*lut_idx*/];
      tmp10/*lut_r*/ = curve_0[(tmp6/*lut_idx*/ + 1)];
      tmp5/*seq*/ += ((tmp10/*lut_r*/ - tmp5/*seq*/) * tmp9/*lut_frac*/) >> 7;
      
      // -- mod="$P_AMP" dstVar=tmp5/*seq*/
      tmp5/*seq*/ = (tmp5/*seq*/ * 1433) >> 11;
      out = (out * tmp5/*seq*/) >> 11;
      
      // -- mod="rmp" dstVar=out
      tmp5/*seq*/ = out;
      tmp5/*seq*/ = (tmp13_rmp_cur >> (18-11));
      tmp13_rmp_cur += tmp14_rmp_step;
      if(tmp13_rmp_cur > 262144) tmp13_rmp_cur = 262144;
      
      // -- mod="set out__v_rmp2" dstVar=tmp5/*seq*/
      var_out__v_rmp2 = tmp5/*seq*/;
      // (ignore last output via '.')
      
      // -- mod="sin" dstVar=out
      tmp5/*seq*/ = out;
      
      // ---- mod="sin" input "phase" seq 1/1
      
      // -- mod="sin" dstVar=tmp9/*phase*/
      tmp10/*sin_tmp*/ = (tmp17_sin_phase);
      tmp10/*sin_tmp*/ = tmp10/*sin_tmp*/ & 0x3FFF;
      tmp9/*phase*/ = cycle_sine_tbl_i[tmp10/*sin_tmp*/];
      tmp17_sin_phase = (tmp17_sin_phase + tmp18_sin_speed) & 0x3FFF;
      
      // -- mod="$out__v_rmp2" dstVar=tmp9/*phase*/
      tmp10/*seq*/ = tmp9/*phase*/;
      tmp10/*seq*/ = var_out__v_rmp2;
      
      // -- mod="lut" dstVar=tmp10/*seq*/
      tmp11/*lut_idx*/ = (tmp10/*seq*/ >> 7);
      tmp12/*lut_frac*/ = (tmp10/*seq*/ & 127);
      tmp10/*seq*/ = curve_3[tmp11/*lut_idx*/ & 15];
      tmp19/*lut_r*/ = curve_3[(tmp11/*lut_idx*/ + 1) & 15];
      tmp10/*seq*/ += ((tmp19/*lut_r*/ - tmp10/*seq*/) * tmp12/*lut_frac*/) >> 7;
      tmp9/*phase*/ = (tmp9/*phase*/ * tmp10/*seq*/) >> 11;
      
      // -- mod="$P_MOD2_L" dstVar=tmp9/*phase*/
      tmp9/*phase*/ = (tmp9/*phase*/ * 5065) >> 11;
      tmp6/*sin_tmp*/ = ((tmp15_sin_phase + (tmp9/*phase*/ << 3)));
      tmp6/*sin_tmp*/ = tmp6/*sin_tmp*/ & 0x3FFF;
      tmp5/*seq*/ = cycle_sine_tbl_i[tmp6/*sin_tmp*/];
      tmp15_sin_phase = (tmp15_sin_phase + tmp16_sin_speed) & 0x3FFF;
      
      // -- mod="$out__v_rmp2" dstVar=tmp5/*seq*/
      tmp6/*seq*/ = tmp5/*seq*/;
      tmp6/*seq*/ = var_out__v_rmp2;
      
      // -- mod="lut" dstVar=tmp6/*seq*/
      tmp9/*lut_idx*/ = (tmp6/*seq*/ >> 7);
      if(tmp9/*lut_idx*/ >= 15)
         tmp9/*lut_idx*/ = 14;
      else if(tmp9/*lut_idx*/ < 0)
         tmp9/*lut_idx*/ = 0;
      tmp10/*lut_frac*/ = (tmp6/*seq*/ & 127);
      tmp6/*seq*/ = curve_2[tmp9/*lut_idx*/];
      tmp11/*lut_r*/ = curve_2[(tmp9/*lut_idx*/ + 1)];
      tmp6/*seq*/ += ((tmp11/*lut_r*/ - tmp6/*seq*/) * tmp10/*lut_frac*/) >> 7;
      
      // -- mod="$P_AMP2" dstVar=tmp6/*seq*/
      tmp6/*seq*/ = (tmp6/*seq*/ * 186) >> 11;
      tmp5/*seq*/ = (tmp5/*seq*/ * tmp6/*seq*/) >> 11;
      out += tmp5/*seq*/;
      
      // -- mod="slf" dstVar=out
      tmp5/*seq*/ = out;
      tmp5/*seq*/ = _d.get(tmp20_slf_pos >> 16) * 2048;
      tmp20_slf_pos += 64946;
      
      // -- mod="0.3" dstVar=tmp5/*seq*/
      tmp5/*seq*/ = (tmp5/*seq*/ * 614) >> 11;
      out += tmp5/*seq*/;
      
      // -- mod="clp" dstVar=out
      if(out > 2045) out = 2045;
      else if(out < -2045) out = -2045;
      

      Short outIdeal = out;
      out += err;
      Short outErr = outIdeal - (((out >> 4) << 4));
      err += outErr;
      if(out > 2047) out = 2047; else if(out < -2048) out = -2048;
      _d[outIdx++] = (out >> (11-7)) * (1.0f / 128.0f);
   } /* end loop frames */
} /* end calc() */
