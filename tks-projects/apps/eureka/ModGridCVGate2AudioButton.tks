module MModGridCVGate2AudioButton;

use namespace ui;
use namespace st2;


// <class.png>
class ModGridCVGate2AudioButton : ModGridButton, ActionConsumer {
   protected ModCVGate2Audio *mod;

   protected FloatParam *fp_pb_up;
   protected FloatParam *fp_pb_down;
   protected FloatParam *fp_pitch_scl;
   protected FloatParam *fp_pitch_off;
   protected CheckBox   *cb_pitch_lerp;


   // <ui_init.png>
   public method initCVGate2AudioButton(ModCVGate2Audio _mod) {

      initModGridButton();

      setLayout(SuperBorderLayout);
      setEnableKbdFocusOnMouse(false);
      setLookAndFeel(LookAndFeel.LIGHT);

      mod <= _mod;

      cb_pitch_lerp <= CheckBox.New(mod.b_pitch_lerp, null);
      cb_pitch_lerp.setLookAndFeel(LookAndFeel.LIGHT);
      cb_pitch_lerp.setEnableCaption(false);
      cb_pitch_lerp.setToolTipCaption("When checked, interpolate pitch");
      cb_pitch_lerp.setPadLeft(0);
      cb_pitch_lerp.setPadRight(2);
      cb_pitch_lerp.setPadTop(2);
      cb_pitch_lerp.setEnableTransparent(true);
      cb_pitch_lerp.setEnableKbdFocusOnMouse(false);
      cb_pitch_lerp.setAlignment(Layout.BASELINEY);
      addLayer(deref cb_pitch_lerp, Layout.LEFT);

      fp_pitch_off <= FloatParam.New();
      fp_pitch_off.setLookAndFeel(LookAndFeel.LIGHT);
      fp_pitch_off.setVisibleTextLength(4);
      fp_pitch_off.setStep(0.001);
      fp_pitch_off.setMinMaxValues(-0.5f, 0.5f);
      fp_pitch_off.setResetValue(0.0f);
      fp_pitch_off.setValue(mod.pitch_off);
      fp_pitch_off.setPrecision(3);
      fp_pitch_off.setMousePrecision(3);
      fp_pitch_off.setAlignment(Layout.BASELINEY);
      fp_pitch_off.setPadTop(2);
      fp_pitch_off.setToolTipCaption("Pitch offset");
      if(UI.IsLoDPI())
         fp_pitch_off.setPadBottom(1);
      addLayer(deref fp_pitch_off, Layout.LEFT);

      fp_pitch_scl <= FloatParam.New();
      fp_pitch_scl.setLookAndFeel(LookAndFeel.LIGHT);
      fp_pitch_scl.setVisibleTextLength(4);
      fp_pitch_scl.setStep(0.001);
      fp_pitch_scl.setMinMaxValues(-2.0f, 2.0f);
      fp_pitch_scl.setResetValue(0.5f);
      fp_pitch_scl.setValue(mod.pitch_scl);
      fp_pitch_scl.setPrecision(3);
      fp_pitch_scl.setMousePrecision(3);
      fp_pitch_scl.setAlignment(Layout.BASELINEY);
      fp_pitch_scl.setPadTop(2);
      fp_pitch_scl.setToolTipCaption("Pitch scaling");
      if(UI.IsLoDPI())
         fp_pitch_scl.setPadBottom(1);
      addLayer(deref fp_pitch_scl, Layout.LEFT);

      fp_pb_down <= FloatParam.New();
      fp_pb_down.setLookAndFeel(LookAndFeel.LIGHT);
      fp_pb_down.setVisibleTextLength(2);
      fp_pb_down.setStep(1.0);
      fp_pb_down.setMinMaxValues(-60.0f, 60.0f);
      fp_pb_down.setResetValue(12.0f);
      fp_pb_down.setValue(mod.pb_down);
      fp_pb_down.setPrecision(3);
      fp_pb_down.setMousePrecision(0);
      fp_pb_down.setAlignment(Layout.BASELINEY);
      fp_pb_down.setPadTop(2);
      fp_pb_down.setToolTipCaption("Pitchbend range (DOWN)");
      if(UI.IsLoDPI())
         fp_pb_down.setPadBottom(1);
      addLayer(deref fp_pb_down, Layout.RIGHT);

      fp_pb_up <= FloatParam.New();
      fp_pb_up.setLookAndFeel(LookAndFeel.LIGHT);
      fp_pb_up.setVisibleTextLength(2);
      fp_pb_up.setStep(1.0);
      fp_pb_up.setMinMaxValues(-60.0f, 60.0f);
      fp_pb_up.setResetValue(12.0f);
      fp_pb_up.setValue(mod.pb_up);
      fp_pb_up.setPrecision(3);
      fp_pb_up.setMousePrecision(0);
      fp_pb_up.setAlignment(Layout.BASELINEY);
      fp_pb_up.setPadTop(2);
      fp_pb_up.setToolTipCaption("Pitchbend range (UP)");
      if(UI.IsLoDPI())
         fp_pb_up.setPadBottom(1);
      addLayer(deref fp_pb_up, Layout.RIGHT);
   }

   // <method_set.png>
   public virtual setEnableHold(boolean _bHold) {
      // prevent Button HOLD_CLICK action (=> edit modmatrix)
   }

   // <ui_render.png>
   public virtual onDraw() {
      UIRenderer.DrawDefaultControlBackground(0, 0, getSizeX(), getSizeY());
      drawGridBorder();
      UIRenderer.DrawDefaultRaisedBorderRight(0, 0, getSizeX(), getSizeY());
   }

   // <ui_consume.png>
   public virtual consumeAction(Action _ac) : boolean {
      String acName <= _ac.getActionName();
      ActionProvider ap <= _ac.getActionProvider();

      switch(@(ap))
      {
         case @(fp_pitch_scl):
            mod.setPitchScl(fp_pitch_scl.getValue());
            mod.addToUIParamHistory(ModCVGate2Audio.PARAM_PITCH_SCL);
            Global.Print("Pitch scaling is "+fp_pitch_scl.getValue());
            current_project.markAsModified();
            return true;

         case @(fp_pitch_off):
            mod.setPitchOff(fp_pitch_off.getValue());
            mod.addToUIParamHistory(ModCVGate2Audio.PARAM_PITCH_OFF);
            Global.Print("Pitch scaling is "+fp_pitch_off.getValue());
            current_project.markAsModified();
            return true;

         case @(cb_pitch_lerp):
            mod.setEnablePitchLerp(cb_pitch_lerp.isSelected());
            Global.Print("Pitch interpolation is "+Utils.GetEnableString(mod.b_pitch_lerp));
            current_project.markAsModified();
            return true;

         case @(fp_pb_up):
            mod.setPbUp(fp_pb_up.getValue());
            mod.addToUIParamHistory(ModCVGate2Audio.PARAM_PB_UP);
            Global.Print("Pitchbend range UP is "+fp_pb_up.getValue());
            current_project.markAsModified();
            return true;

         case @(fp_pb_down):
            mod.setPbDown(fp_pb_down.getValue());
            mod.addToUIParamHistory(ModCVGate2Audio.PARAM_PB_DOWN);
            Global.Print("Pitchbend range DOWN is "+fp_pb_down.getValue());
            current_project.markAsModified();
            return true;
      }

      return ModGridButton::consumeAction(_ac);
   }

}
