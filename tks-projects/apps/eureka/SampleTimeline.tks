   public method autoLoadSamples(String _dirNameOverrideOrNull) : boolean {
      // (todo)
      return true;
   }

   // <method.png>
   public method autoUnloadSamples() : boolean {
      // (todo) autoUnloadSamples()
      return true;
   }

