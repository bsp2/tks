// ----
// ---- info   : This is part of the "syntracker" midi/audio sequencer.
// ----
// ---- created: 04Apr2025
// ---- changed: 05Apr2025, 07Apr2025, 09Apr2025, 01May2025, 03May2025, 06May2025, 31May2025
// ----          07Jun2025, 14Jun2025, 22Jun2025, 07Apr2026, 14Apr2026, 15Apr2026, 10May2026
// ----          10Jul2026, 11Jul2026, 03Aug2026, 04Aug2026
// ----
// ----
// ----
-->
<xfm>
  <Panel dir=CENTER align=expand>

    <SizeGroupX id=sgx_lb_left/>
    <SizeGroupX id=sgx_lb_clip/>
    <SizeGroupX id=sgx_offrelvel/>

    <SplitPane id=spl_sample dir=CENTER split=0.8 vertical=1>

      <!-- top -->
      <Panel dir=CENTER align=expand>

        <Panel dir=TOP align=expandx>
          <!-- Track -->
          <TitledPanel caption="Track" dir=RIGHT padLeft=4>

            <CheckBox id=cb_track_master_volume
                      dir=RIGHT
                      align=baseline
                      caption="V"
                      padLeft=4
                      padRight=0
                      setkbdfocusonmouse=0
                      toolTipCaption="When checked, track clips control volume of following track(s)\n\n (note) clips should play empty sample"
                      />

            <Button id=bt_track_delete
                    dir=LEFT
                    align=baseline
                    nocaption=1
                    icon=removes
                    iconMono=removes_mono
                    iconPlacement=CENTER
                    toolTipCaption="Delete track\n\n (note) requires hold or lctrl click"
                    labelButton=1
                    hold=1
                    setkbdfocusonmouse=0
                    innerpadding=0;0;0;0
                    iconpadding=0;0;0;0
                    padLeft=6
                    />

            <Button id=bt_track_new
                    dir=LEFT
                    align=baseline
                    nocaption=1
                    icon=adds
                    iconMono=adds_mono
                    iconPlacement=CENTER
                    toolTipCaption="New track\n\n (note) append after cursor track"
                    labelButton=1
                    hold=0
                    setkbdfocusonmouse=0
                    innerpadding=0;0;0;0
                    iconpadding=0;0;0;0
                    padLeft=6
                    />

            <TextField id=tf_track_name
                       dir=LEFT
                       align=baseline
                       cols=9
                       toolTipCaption="Track Name\n\n (note) also used to build sample and sample-namespace names when drawing clips with lshift-w (a_<trackname>)"
                       />

            <Label dir=LEFT
                   align=baseline
                   caption="Name:"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=10
                   />
          </TitledPanel>

          <!-- Timeline -->
          <TitledPanel caption="Timeline" dir=LEFT>

            <CheckBox id=cb_bgrec_repeat
                      dir=LEFT
                      align=baseline
                      caption="R"
                      padLeft=0
                      setkbdfocusonmouse=0
                      toolTipCaption="When checked, repeatedly add clip to background-recording buffer\n\n (note) until Synergy-replay is stopped or when a limit of 1024 clips has been reached\n\n (note) lshift-j"
                      />

            <ComboBox id=cm_bgrec
                      dir=LEFT
                      align=baseline
                      arrow=1
                      options="-;On+Off;On;On Sw"
                      optionsLong="-;On+Off;On;On Switch"
                      toolTipCaption="When active, record MIDI C-4..G-A clip jams to clipboard while timeline sequence is NOT running\n\n (note) cursor track determines clip source pool (first clip maps to C-4, second one to C#4, ..)\n (note) recorded clips can afterwards be pasted via lctrl-v\n (note) in 'On' mode, snap last recorded clip length to next clip note on (or clip length, depending on what comes first)\n (note) in 'On Switch' mode, try to continue playing at current position\n (note) the recording buffer is cleared each time the (MIDI-seq) replay starts\n\n (note) 'j' cycles through recording modes"
                      padLeft=0
                      />
            <Label dir=LEFT
                   align=baseline
                   caption="Rec:"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=4
                   />

            <CheckBox id=cb_sync_loop_to_selection
                      dir=LEFT
                      align=baseline
                      caption="Sync Loop"
                      padLeft=4
                      setkbdfocusonmouse=0
                      toolTipCaption="When checked, sync loop to selection\n\n (note) 'g'"
                      />

            <!-- Time Signature (per Timeline model) -->
            <ComboBox id=cm_sig_notelen
                      dir=LEFT
                      align=baseline
                      arrow=0
                      reverseWheelDir=1
                      options="1;2;4;8;16;32"
                      toolTipCaption="Time signature: Note length"
                      padLeft=0
                      />
            <Label dir=LEFT
                   align=baseline
                   caption="/"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=0
                   />
            <FloatParam id=fp_sig_beats
                        dir=LEFT
                        align=baseline
                        value=1 min=1 max=32 precision=0 step=1
                        reset=4
                        mousePrecision=0
                        cols=1
                        toolTipCaption="Time signature: Beats per bar"
                        padLeft=4
                        />

            <!-- BPM -->
            <CheckBox id=cb_use_project_bpm
                      dir=LEFT
                      align=baseline
                      nocaption=1
                      padLeft=0
                      setkbdfocusonmouse=0
                      toolTipCaption="When checked, BPM follows project setting\n\nIn mixed mode, use per-timeline BPM"
                      mixed=1
                      />
            <FloatParam id=fp_bpm
                        dir=LEFT
                        align=baseline
                        value=32 min=60 max=180 rangeEditable=1 minLimit=1 maxLimit=999 precision=4 step=0.1
                        reset=90;120;140
                        mousePrecision=1
                        cols=3
                        toolTipCaption="Beats per minute\n\n (note) ignored when use-project-BPM checkbox is selected"
                        padLeft=0
                        />
            <Label dir=LEFT
                   align=baseline
                   caption="BPM:"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=4
                   />

            <!-- Canvas Size (bars) -->
            <FloatParam id=fp_canvas_size
                        dir=LEFT
                        align=baseline
                        value=32 min=16 max=256 maxEditable=1 maxLimit=9999 precision=0 step=1
                        reset=128;32
                        mousePrecision=0
                        cols=2
                        toolTipCaption="Canvas size (num bars)"
                        padLeft=0
                        />

            <Label dir=LEFT
                   align=baseline
                   caption="Bars:"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=4
                   sizeGroup=sgx_lb_left
                   />

            <ComboField id=cf_model
                        dir=LEFT
                        align=baseline
                        cols=7
                        name="Mdl"
                        options="filled;in;at;runtime"
                        optionSizeReserve="my var"
                        toolTipcaption="Current timeline (edit pattern / model)\n\n (note) inc: HOME or PAGEUP\n (note) dec: END or PAGEDOWN"
                        provideEdited=1
                        addordelete=0
                        autoRemoveText="<unused>"
                        padLeft=0
                        />

            <Label dir=LEFT
                   align=baseline
                   caption="Edit:"
                   textPlacement=RIGHT
                   fillBG=0
                   padLeft=10
                   />

          </TitledPanel>
        </Panel>

        <SampleTimelineEditor id=sample_timeline_editor dir=CENTER align=expand/>

        <!-- Lane Sends and Clip Details -->
        <Panel dir=BOTTOM align=expandx>

          <!-- Lane Sends -->
          <TitledPanel caption="Lane Sends" dir=LEFT>

            <!-- Lane 8 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send8_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 8 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send8_pan
                    autoresolve=0
                    dir=BOTTOM
                    padTop=4
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 8 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="8"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 7 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send7_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 7 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send7_pan dir=BOTTOM
                    autoresolve=0
                    padTop=4
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 7 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="7"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 6 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send6_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 6 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send6_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 6 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    padTop=4
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="6"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 5 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send5_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 5 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send5_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 5 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    padTop=4
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="5"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 4 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send4_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 4 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send4_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 4 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    padTop=4
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="4"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 3 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send3_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 3 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send3_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 3 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    padTop=4
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="3"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 2 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send2_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 2 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send2_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 2 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    padTop=4
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="2"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

            <!-- Lane 1 -->
            <Panel dir=LEFT padLeft=3>
              <Dial id=dl_send1_level
                    autoresolve=0
                    dir=TOP
                    min=0 max=1 reset=0;1
                    toolTipCaption="Lane 1 Send Level\n\n (note) hold ALT to edit per-clip level modulation"
                    reqSizeScaled=23;23
                    mod=1
                    />
              <Dial id=dl_send1_pan
                    autoresolve=0
                    dir=BOTTOM
                    min=-1 max=1 reset=0
                    bipolar=1
                    toolTipCaption="Lane 1 Send Pan\n\n (note) hold ALT to edit per-clip pan modulation"
                    reqSizeScaled=23;23
                    padTop=4
                    mod=1
                    />
              <Panel dir=BOTTOM align=expandx>
                <Label dir=CENTER
                       caption="1"
                       textPlacement=CENTER
                       align=centerY
                       fillBG=0
                       padLeft=0
                       />
              </Panel>
            </Panel>

          </TitledPanel>

          <!-- Clip Details -->
          <TitledPanel caption="Clip" dir=LEFT>

            <!-- Clip Name -->
            <Panel dir=BOTTOM>
              <Button id=bt_clip_name_from_sample
                      dir=CENTER
                      align=baseline;expandx
                      caption="From sample"
                      fillBG=1
                      labelButton=1
                      toolTipCaption="Copy clip name from sample"
                      padLeft=2
                      />
              <TextField id=tf_clip_name
                         dir=LEFT
                         align=baseline
                         cols=24
                         toolTipCaption="Clip Name"
                         />

              <Label dir=LEFT
                     align=baseline
                     caption="Name:"
                     textPlacement=RIGHT
                     fillBG=0
                     padLeft=0
                     sizeGroup=sgx_lb_clip
                     />
            </Panel>

            <Panel dir=BOTTOM align=expandx>

              <Panel dir=LEFT>
                <!-- Clip Info -->
                <Panel dir=BOTTOM align=expandx padTop=2>
                  <Label id=lb_clip_info
                         dir=CENTER
                         align=baseline;expandx
                         fillBG=1
                         clipCaption=1
                         />

                  <Label dir=LEFT
                         align=baseline
                         caption="Info:"
                         textPlacement=RIGHT
                         fillBG=0
                         padLeft=0
                         sizeGroup=sgx_lb_clip
                         />
                </Panel>

                <!-- Clip Start Offset, Release-Flag, On+Off Velocities, CCs -->
                <Panel dir=BOTTOM>

                  <FloatParam id=fp_clip_vel_off
                              dir=LEFT
                              align=baseline
                              value=127 min=0 max=127 precision=3 step=1
                              reset=0
                              mousePrecision=0
                              cols=1
                              toolTipCaption="Clip end velocity"
                              padLeft=0
                              />

                  <FloatParam id=fp_clip_vel_on
                              dir=LEFT
                              align=baseline
                              value=127 min=1 max=127 precision=3 step=1
                              reset=127
                              mousePrecision=0
                              cols=1
                              toolTipCaption="Clip start velocity"
                              padLeft=0
                              />

                  <Label dir=LEFT
                         align=baseline
                         caption="Vel:"
                         textPlacement=RIGHT
                         fillBG=0
                         padLeft=4
                         />

                  <Panel dir=LEFT sizeGroup=sgx_offrelvel align=baseline>
                    <CheckBox id=cb_clip_release
                              dir=LEFT
                              align=baseline
                              caption="Release"
                              padLeft=4
                              toolTipCaption="When checked, send regular note-off at end of clip\n\nWhen unchecked, invoke allNotesOff and fade-out quickly (e.g. after split)"
                              setkbdfocusonmouse=0
                              />

                    <FloatParam id=fp_clip_offset
                                dir=LEFT
                                align=baseline
                                value=0 min=0 max=16 maxEditable=1 maxLimit=128 precision=4 step=0.25
                                reset=0
                                mousePrecision=3
                                cols=4
                                toolTipCaption="Clip Start Offset (num beats)"
                                padLeft=0
                                />

                    <Label dir=LEFT
                           align=baseline
                           caption="Offset:"
                           textPlacement=RIGHT
                           fillBG=0
                           padLeft=0
                           sizeGroup=sgx_lb_clip
                           />
                  </Panel>

                </Panel>

              </Panel>

              <Panel dir=RIGHT>

                <Panel dir=BOTTOM>
                  <FloatParam id=fp_clip_fade_out
                              dir=LEFT
                              align=baseline
                              value=0 min=0 max=64 precision=2 step=0.5
                              reset=0;1;4
                              nominalMin=0 nominalMax=16 maxLimit=128 rangeMaxEditable=1
                              mousePrecision=0
                              cols=1
                              toolTipCaption="Fade-Out (#beats)"
                              padLeft=0
                              />

                  <Label dir=LEFT
                         align=baseline
                         caption="Out:"
                         textPlacement=RIGHT
                         fillBG=0
                         padLeft=3.5
                         />

                  <FloatParam id=fp_clip_fade_in
                              dir=LEFT
                              align=baseline
                              value=0 min=0 max=8 precision=2 step=0.5
                              reset=0;1;4
                              nominalMin=0 nominalMax=16 maxLimit=128 rangeMaxEditable=1
                              mousePrecision=0
                              cols=1
                              toolTipCaption="Fade-In (#beats)"
                              padLeft=0
                              />

                  <Label dir=LEFT
                         align=baseline
                         caption="Fade In:"
                         textPlacement=RIGHT
                         fillBG=0
                         padLeft=4
                         />
                </Panel>

                <Panel dir=BOTTOM>
                  <FloatParam id=fp_clip_cc_ex
                              dir=LEFT
                              align=baseline
                              value=127 min=-1 max=127 precision=3 step=1
                              reset=-1;64;127
                              mousePrecision=0
                              negativeText="-"
                              cols=1
                              toolTipCaption="Clip expression pedal controller (CC#11)"
                              padLeft=2
                              />

                  <FloatParam id=fp_clip_cc_fc
                              dir=LEFT
                              align=baseline
                              value=127 min=-1 max=127 precision=3 step=1
                              reset=-1;64;127
                              mousePrecision=0
                              negativeText="-"
                              cols=1
                              toolTipCaption="Clip foot controller (CC#4)"
                              padLeft=2
                              />

                  <FloatParam id=fp_clip_cc_bc
                              dir=LEFT
                              align=baseline
                              value=127 min=-1 max=127 precision=3 step=1
                              reset=-1;64;127
                              mousePrecision=0
                              negativeText="-"
                              cols=1
                              toolTipCaption="Clip breath controller (CC#2)"
                              padLeft=2
                              />

                  <FloatParam id=fp_clip_cc_mw
                              dir=LEFT
                              align=baseline
                              value=127 min=-1 max=127 precision=3 step=1
                              reset=-1;64;127
                              mousePrecision=0
                              negativeText="-"
                              cols=1
                              toolTipCaption="Clip modwheel controller (CC#1)"
                              padLeft=0
                              />

                  <Label dir=LEFT
                         align=baseline
                         caption="CC:"
                         textPlacement=RIGHT
                         fillBG=0
                         padLeft=4
                         />
                </Panel>

              </Panel>

            </Panel>

            <!-- Clip Sample -->
            <Panel dir=BOTTOM align=expandx>

              <Button id=bt_clip_sample_rec
                      dir=RIGHT
                      align=centerY
                      caption=""
                      captionSizeReserve="MM"
                      padLeft=1
                      icon=record_0
                      iconPressed=record_1
                      iconPlacement=RIGHT
                      labelbutton=1
                      toggle=1
                      hold=1
                      setkbdfocusonmouse=0
                      redrawparent=1
                      transparent=0
                      toolTipCaption="Record sample (replace waveform)\n\n (note) input source is first record-enable audio track (see audio page)\n\n (note) lctrl-x SPACE  OR lctrl-x ENTER  OR lctrl-x =\n (note) leave page (ESC) to cancel recording\n\n (note) hold-click to select audio-track (\'*\' = use first record-enabled audio-track)\n\n (note) lctrl-x a shows audio-track menu"
                      bgkeepalpha=1
                      />

              <Button id=bt_clip_sample
                      dir=CENTER
                      align=baseline;expandx
                      reqSizeX=500
                      fillBG=1
                      labelButton=1
                      hold=1
                      toolTipCaption="Edit sample\n\n (note) RMB-click on clip\n\n (note) selecting a different sample will update the clip\n (note) hold-click OR lctrl-r clones current sample or creates a new, empty one\n (note) lctrl-lshift-r forces creation of empty sample"
                      clipCaption=1
                      />

              <Label dir=LEFT
                     align=baseline
                     caption="Sample:"
                     textPlacement=RIGHT
                     fillBG=0
                     padLeft=0
                     sizeGroup=sgx_lb_clip
                     />
            </Panel>

          </TitledPanel>

        </Panel>

      </Panel>

      <!-- bottom -->
      <SampleView id=sv_wave dir=CENTER lnf=dark align=expand/>

    </SplitPane>

  </Panel>

</xfm>
