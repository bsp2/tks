module MSampleTimelineAudioTrackMenuForm;
use namespace ui;
use namespace st2;


// <class.png>
class SampleTimelineAudioTrackMenuForm : Layer {

   SampleTimelineForm *parent_form;
   SampleTimelineModelTrack *model_track;

   protected ComboBox   *cm_rec_mode;
   protected FloatParam *fp_voice_modulo;
   protected FloatParam *fp_latency;

   protected Panel *p;
   protected Panel *p2;


   public method initSampleTimelineAudioTrackMenuForm(SampleTimelineForm _parentForm) {
      initLayer();

      parent_form <= _parentForm;

      setLayout(SuperBorderLayout);

      // Bottom
      p2 <= Panel.New();
      fp_latency <= FloatParam.New();
      fp_latency.setPrecision(0);
      fp_latency.setStep(1);
      fp_latency.setMinMaxValues(-999, 999);
      fp_latency.setResetValue(STConfig.atrk_rec_skip_num_frames/*-80*/);
      fp_latency.setValue(STConfig.atrk_rec_skip_num_frames);
      fp_latency.setAlignment(Layout.BASELINEY);
      fp_latency.setVisibleTextLength(5);
      fp_latency.setToolTipCaption("Recording latency compensation (#frames)\n\n (note) see STConfig.atrk_rec_skip_num_frames");
      p2.addLayer(fp_latency, Layout.LEFT);

      Label lb <= Label.New();
      lb.setCaption("Latency compensation:");
      lb.setAlignment(Layout.BASELINEY);
      lb.setEnableFillBackground(false);
      p2.addLayer(deref lb, Layout.LEFT);

      addLayer(p2, Layout.TOP);

      // Top
      p <= Panel.New();

      fp_voice_modulo <= FloatParam.New();
      fp_voice_modulo.setPrecision(0);
      fp_voice_modulo.setStep(1);
      fp_voice_modulo.setMinMaxValues(1, 16);
      fp_voice_modulo.setResetValue(4);
      fp_voice_modulo.setValue(4);
      fp_voice_modulo.setAlignment(Layout.BASELINEY);
      fp_voice_modulo.setVisibleTextLength(2);
      fp_voice_modulo.setToolTipCaption("Voice Modulo number of voices (overdub recording passes)");
      p.addLayer(fp_voice_modulo, Layout.LEFT);

      lb <= Label.New();
      lb.setCaption("Num.Voices:");
      lb.setPadLeft(8);
      lb.setAlignment(Layout.BASELINEY);
      lb.setEnableFillBackground(false);
      p.addLayer(deref lb, Layout.LEFT);

      cm_rec_mode <= ComboBox.New();
      cm_rec_mode.setOptions(SampleTimelineModelTrack.rec_mode_names);
      cm_rec_mode.setOptionsLong(SampleTimelineModelTrack.rec_mode_names_long);
      cm_rec_mode.setToolTipCaptions(SampleTimelineModelTrack.rec_mode_names_tooltips);
      cm_rec_mode.setAlignment(Layout.BASELINEY);
      p.addLayer(cm_rec_mode, Layout.LEFT);

      addLayer(p, Layout.TOP);
   }

   public method setModelTrack(SampleTimelineModelTrack _track) {
      model_track <= _track;
   }

   public method setRecordingMode(int _recMode) {
      cm_rec_mode.setSelectedOption(_recMode);
      fp_voice_modulo.setEditable(SampleTimelineModelTrack.REC_VOICE_MODULO == _recMode);
   }

   public method setVoiceModuloNumVoices(int _numVoices) {
      fp_voice_modulo.setValue(_numVoices);
   }

  // <ui_consume.png>
   public virtual consumeAction(Action _action) : boolean {
      ActionProvider ap <= _action.getActionProvider();
      String acName <= _action.getActionName();
      // trace "xxx SampleTimelineAudioTrackMenuForm::consumeAction: acName=\""+acName+"\" ap="+#(ap);

      switch(@(ap))
      {
         case @(cm_rec_mode):
            if(null != model_track)
            {
               model_track.rec_mode = cm_rec_mode.getSelectedOption();
               fp_voice_modulo.setEditable(SampleTimelineModelTrack.REC_VOICE_MODULO == model_track.rec_mode);
               current_project.markAsModified();
            }
            Global.PrintFast("Record mode is \""+cm_rec_mode.getSelectedOptionName()+"\"");
            return true;

         case @(fp_voice_modulo):
            if(null != model_track)
            {
               model_track.rec_num_voices = fp_voice_modulo.getFloatValue();
               current_project.markAsModified();
            }
            Global.PrintFast("Voice modulo is "+fp_voice_modulo.getFloatValue());
            return true;

         case @(fp_latency):
            Global.Print("Recording latency is "+STConfig.atrk_rec_skip_num_frames+" frame"+Utils.GetPluralString(STConfig.atrk_rec_skip_num_frames));
            STConfig.atrk_rec_skip_num_frames = fp_latency.getFloatValue();
            return true;
      }
      return Layer::consumeAction(_action);
   }
}
