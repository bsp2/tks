module MModGridButtonBase;

use namespace ui;
use namespace st2;


// <class.png>
class ModGridButtonBase : Button, ActionConsumer {

   define int DELETE_TINT32_ACTIVE   = #241f0000;
   define int DELETE_TINT32_INACTIVE = #0c3f0000;

   ModGrid *parent_modgrid;

   protected static PopupMenu *pm_context;

   public int grid_x;
   public int grid_y;
   public int num_lanes;


   // <ui_timer.png>
   public method handleIdleTimer() {
   }

   // <ui_kbd.png>
   public virtual onKeyboardFocus() {
      log4 "ModGridButtonBase::onKeyboardFocus: grid=("+grid_x+","+grid_y+") this="+#(this);
      ModGrid.SetCursorPos(grid_x, grid_y);
      redraw();
   }

   // <ui_kbd.png>
   public virtual onKeyboardFocusLost(boolean _bQuiet) {
      log4 "ModGridButtonBase::onKeyboardFocusLost: grid=("+grid_x+","+grid_y+") cursor=("+ModGrid.GetCursorX()+","+ModGrid.GetCursorY()+") bQuiet="+_bQuiet+" this="+#(this);
      if(!_bQuiet)
      {
         if(ModGrid.IsCursorPos(grid_x, grid_y))
         {
            log4 "ModGridButtonBase::onKeyboardFocusLost:   redraw grid=("+grid_x+","+grid_y+")";
            redraw();
         }
      }
   }

   // <ui_render.png>
   public method drawGridBorder() {

      float w = getSizeX();
      float h = getSizeY();

      UIRenderer.DrawLine(0, h-1, w, h-1, #ff000000);
   }

   // <ui_render.png>
   protected virtual drawKeyboardFocus(float _fillX, float _fillY, float _fillW, float _fillH) {
      // intentionally left blank
   }

   // <ui_render.png>
   public virtual onDrawPost() {
      float w = getSizeX();
      float h = getSizeY();

      if(ModGrid.IsCursorPosAndHasKeyboardFocus(grid_x, grid_y))
      {
         // log4 "ModGridButtonBase::drawGridBorder: cursor grid=("+grid_x+","+grid_y+")";
         UIRenderer.DrawFilledRectangle(w-2, 0, 2, h-1, lnf_colors.get(LookAndFeel.COLOR_KBD_CURSOR));
      }

      drawGridBorder();
   }

}
