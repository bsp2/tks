module MTrackCtlState;

use namespace ui;

namespace st2;


// <class.png>
class TrackCtlState {
   // (note) -1=unknown status (don't reload / e.g. sample.initial_perf_ctl has prio after project reload)
   // (note) see internal.msp / remote.msp for RPN definitions
   protected FloatArray cc_status;              // 128 CCs (persistent: mw,bc,fc,ex,gp1,gp2,gp3,gp4)
   protected FloatArray ctl_status;             // ctl_1..ctl_16 RPN#100..115
   protected FloatArray last_param_set_abs;     // RPN#70..74   7bit
   protected FloatArray last_param_set_smooth;  // RPN#75..79  14bit
   protected int        last_lane_fade_nr;      // RPN#86       5bit in abs mode, 14bit in rel mode


   // <method_init.png>
   public method init() {
      cc_status.allocAndFill(128, -1);
      ctl_status.allocAndFill(16, -1);
      last_param_set_abs.allocAndFill(5, -1);
      last_param_set_smooth.allocAndFill(5, -1);
      last_lane_fade_nr = -1;
   }

   // <method.png>
   public method reset() {
      // (note) called from replay thread

      // Reset last seen performance controllers (MW,BC,FC,EX,GP1..4)
      cc_status.fill(-1);

      // Reset ctl_1..16 (modmatrix) RPNs 100.115
      ctl_status.fill(-1);

      // Reset paramset RPNs 70..74, 75..79
      last_param_set_abs.fill(-1);
      last_param_set_smooth.fill(-1);

      // Lane fading RPN#86
      last_lane_fade_nr = -1;
   }

   // <method.png>
   public method trackCtls(local MIDIPipeFrame _frInput, local int _devIdx, local byte _midiCh, local MIDIPipeEvent pev) {
      local int numEv;
      local int evIdx;

      // Track paramset, ctl#1..16, lanefade RPNs
      numEv = _frInput.getNumEventsRPNByFlt(_devIdx, _midiCh);
      if(numEv > 0)
      {
         evIdx = 0;
         loop(numEv)
         {
            if(_frInput.getEventByIdxAndFlt(evIdx, pev, MIDIPIPE_EVENT_TYPE_RPN, _devIdx, _midiCh))
            {
               if(70 <= pev.rpn <= 74)
               {
                  last_param_set_abs[pev.rpn - 70] = pev.rpnValue;
               }
               else if(75 <= pev.rpn <= 79)
               {
                  last_param_set_smooth[pev.rpn - 75] = pev.rpnValue;
               }
               else if(86 == pev.rpn)
               {
                  last_lane_fade_nr = pev.rpnValue;
               }
               else if(100 <= pev.rpn < 116)
               {
                  // trace "xxx update ctl_status["+(pev.rpn - 100)+"] = "+pev.rpnValue;
                  ctl_status[pev.rpn - 100] = pev.rpnValue;
               }
               // (note) skip Track output 1..8 levels (RPNs 300..307, see Synergy remote.msp)
               //         (already stored in Output)
            }
         }
      }

      // Track continuous (performance) controllers
      //  (note) for recall / HW controller update in Synergy
      //  (note) queried via SYX_MSGID_QUERY_TRACKS
      numEv = _frInput.getNumEventsCCByFlt(_devIdx, _midiCh);
      if(numEv > 0)
      {
         evIdx = 0;
         loop(numEv)
         {
            if(_frInput.getEventByIdxAndFlt(evIdx, pev, MIDIPIPE_EVENT_TYPE_CC, _devIdx, _midiCh))
            {
               cc_status[pev.ccId] = pev.ccValue;
            }
            evIdx++;
         }
      }

      // // // Lane fade nr  (=> already handled above)
      // // local short laneFadeNr = _frInput.getFilteredRPN(_devIdx, _midiCh, Track.RPN_LANE_FADE_NR/*86*/);
      // // if(laneFadeNr >= 0)
      // // {
      // //    last_lane_fade_nr = laneFadeNr;
      // // }

   }

   // <ui.png>
   public method getInfoString() : String {
      local String r;
      float v;
      int num;

      num = 0;
      foreach v in cc_status
         if(v >= 0.0f)
            num++;
      if(num > 0)
         r.append(" CC:"+num);

      num = 0;
      foreach v in ctl_status
         if(v >= 0.0f)
            num++;
      if(num > 0)
         r.append(" Ctl:"+num);

      num = 0;
      foreach v in last_param_set_abs
         if(v >= 0.0f)
            num++;
      if(num > 0)
         r.append(" PSet_Abs:"+num);

      num = 0;
      foreach v in last_param_set_smooth
         if(v >= 0.0f)
            num++;
      if(num > 0)
         r.append(" PSet_Smooth:"+num);

      if(last_lane_fade_nr >= 0.0f)
         r.append(" LaneFade");

      return r.trim();
   }

   // <method.png>
   public method reload(local MIDIPipeFrame _fr, local int _devIdx, local byte _midiCh) {
      local int ctlIdx;
      local float v;

      // Performance controller status (v20+)
      v = cc_status.get( 1); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh,  1/*mw*/,  v);
      // trace "xxx TrackCtlState::reload: CC_MW="+v;
      v = cc_status.get( 2); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh,  2/*bc*/,  v);
      v = cc_status.get( 4); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh,  4/*fc*/,  v);
      v = cc_status.get(11); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh, 11/*ex*/,  v);
      v = cc_status.get(16); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh, 16/*gp1*/, v);
      v = cc_status.get(17); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh, 17/*gp2*/, v);
      v = cc_status.get(18); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh, 18/*gp3*/, v);
      v = cc_status.get(19); if(v >= 0.0f) _fr.cc(true/*bSet*/, _devIdx, _midiCh, 19/*gp4*/, v);

      // RPN ctl_1..16 status (v20+)
      ctlIdx = 0;
      loop(16)
      {
         v = ctl_status.get(ctlIdx); if(v >= 0.0f) _fr.rpn(true/*bSet*/, _devIdx, _midiCh, 100 + ctlIdx, v);
         ctlIdx++;
      }

      // Paramset 1..5 status (v20+)
      ctlIdx = 0;
      loop(5)
      {
         v = last_param_set_abs.get(ctlIdx); if(v >= 0.0f) _fr.rpn(true/*bSet*/, _devIdx, _midiCh, 70 + ctlIdx, v);
         v = last_param_set_smooth.get(ctlIdx); if(v >= 0.0f) _fr.rpn(true/*bSet*/, _devIdx, _midiCh, 75 + ctlIdx, v);
         ctlIdx++;
      }

      // Lane fade nr RPN#86 (v20+)
      v = last_lane_fade_nr; if(v >= 0.0f) _fr.rpn(true/*bSet*/, _devIdx, _midiCh, 86/*lane_fade_nr*/, v);
   }

   // <method_write.png>
   public method writeDataToStream(Stream ofs) {
      // (note) called by saveState() and Project::queryTrackPropertiesForSysEx()
      local int ctlIdx;

      // Performance controller status (v1+, track v20+)
      // // ofs.i8 = cc_status.get( 1);  // mw (v1)
      // // ofs.i8 = cc_status.get( 2);  // bc
      // // ofs.i8 = cc_status.get( 4);  // fc
      // // ofs.i8 = cc_status.get(11);  // ex
      // // ofs.i8 = cc_status.get(16);  // gp1
      // // ofs.i8 = cc_status.get(17);  // gp2
      // // ofs.i8 = cc_status.get(18);  // gp3
      // // ofs.i8 = cc_status.get(19);  // gp4
      ofs.f32 = cc_status.get( 1);  // mw (v2)
      ofs.f32 = cc_status.get( 2);  // bc
      ofs.f32 = cc_status.get( 4);  // fc
      ofs.f32 = cc_status.get(11);  // ex
      ofs.f32 = cc_status.get(16);  // gp1
      ofs.f32 = cc_status.get(17);  // gp2
      ofs.f32 = cc_status.get(18);  // gp3
      ofs.f32 = cc_status.get(19);  // gp4

      // RPN ctl_1..16 status (v1+, track v20+)
      ctlIdx = 0;
      loop(16)
      {
         // // ofs.i16 = ctl_status.get(ctlIdx++);  // v1
         ofs.f32 = ctl_status.get(ctlIdx++);
      }

      // Paramset 1..5 status (v1+, track v20+)
      ctlIdx = 0;
      loop(5)
      {
         // // ofs.i8  = last_param_set_abs   .get(ctlIdx);  // v1
         // // ofs.i16 = last_param_set_smooth.get(ctlIdx);
         ofs.f32 = last_param_set_abs   .get(ctlIdx);  // v2
         ofs.f32 = last_param_set_smooth.get(ctlIdx);
         ctlIdx++;
      }

      // Lane fade nr RPN#86 (v1+, track v20+)
      // // ofs.i16 = last_lane_fade_nr;  // v1
      ofs.f32 = last_lane_fade_nr;  // v2
   }

   // <save.png>
   public method saveState(Stream ofs) {

      // Ver (track v21+)
      ofs.i16 = 2;

      writeDataToStream(ofs);
   }

   // <load.png>
   public method loadState(Stream ifs, boolean _bVer) {

      short ver = 1;
      if(_bVer) // track v21+
         ver = ifs.u16;

      // Performance controller status (v1+, track v20+)
      if(ver >= 2)
      {
         cc_status[ 1] = ifs.f32;  // mw
         cc_status[ 2] = ifs.f32;  // bc
         cc_status[ 4] = ifs.f32;  // fc
         cc_status[11] = ifs.f32;  // ex
         cc_status[16] = ifs.f32;  // gp1
         cc_status[17] = ifs.f32;  // gp2
         cc_status[18] = ifs.f32;  // gp3
         cc_status[19] = ifs.f32;  // gp4
         // trace "xxx TrackCtlState::loadState: cc_status[ 1]="+cc_status[ 1];
      }
      else
      {
         cc_status[ 1] = ifs.s8;  // mw
         cc_status[ 2] = ifs.s8;  // bc
         cc_status[ 4] = ifs.s8;  // fc
         cc_status[11] = ifs.s8;  // ex
         cc_status[16] = ifs.s8;  // gp1
         cc_status[17] = ifs.s8;  // gp2
         cc_status[18] = ifs.s8;  // gp3
         cc_status[19] = ifs.s8;  // gp4
      }

      // RPN ctl_1..16 status (v1+, v20+, track v20+)
      int ctlIdx = 0;
      if(ver >= 2)
      {
         loop(16)
            ctl_status[ctlIdx++] = ifs.f32;
      }
      else
      {
         loop(16)
            ctl_status[ctlIdx++] = ifs.u16;
      }

      // Paramset 1..5 status (v1+, track v20+)
      ctlIdx = 0;
      loop(5)
      {
         if(ver >= 2)
         {
            last_param_set_abs   [ctlIdx] = ifs.f32;
            last_param_set_smooth[ctlIdx] = ifs.f32;
         }
         else
         {
            last_param_set_abs   [ctlIdx] = ifs.u8;
            last_param_set_smooth[ctlIdx] = ifs.u16;
         }
         ctlIdx++;
      }

      // Lane fade nr RPN#86 (v1+, track v20+)
      if(ver >= 2)
         last_lane_fade_nr = ifs.f32;
      else
         last_lane_fade_nr = ifs.u16;
   }

}
