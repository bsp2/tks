module MNT_BlockScaleOffsetDialog;

use namespace ui;


// <class.png>
class NT_BlockScaleOffsetDialog extends Dialog, ActionConsumer, ActionProvider {

   define int MIN_WIDTH  = 64;
   define int MIN_HEIGHT = 64;

   define String ACTION_NAME = "BlockScaleOffsetDialog";

   protected ActionConsumer *recipient;

   FloatParam *fp_scale;
   FloatParam *fp_offset;
   Button   *bt_ok;

   public static New(ActionConsumer _recipient) : NT_BlockScaleOffsetDialog
   {
      local NT_BlockScaleOffsetDialog d;
      d.initBlockScaleOffsetDialog(_recipient);
      return deref d;
   }

   protected initBlockScaleOffsetDialog(ActionConsumer _recipient) {

      initDialog();

      recipient <= deref _recipient;
      int w, h;

      Label *lb;
      Panel *lp;
      FloatParam *fp;

      Panel l <= Panel.New();

      local SizeGroupX sgxLabel;
      l.setSizeGroup(deref sgxLabel);

      // Add Scale widgets
      lp <= Panel.New();
      lp.setPadding4f(6,0,0,0);

      lb <= Label.New();
      lb.setCaption("Scale:");
      lb.setTextPlacement(Layout.RIGHT);
      lb.setSizeGroup(sgxLabel);
      lb.setAlignment(Layout.BASELINE);
      lb.setPadLeft(2);
      lp.addLayer(deref lb, Layout.RIGHT);

      fp <= FloatParam.New();
      fp.setDisplayType(FloatParam.DISPLAY_FLOAT);
      fp.setPrecision(5);
      fp.setStepCoarse(0.01);
      fp.setStepFine(0.001);
      fp.setMinMaxValues(-16, 16);
      fp.setResetValue(1.0);
      fp.setValue(1.0);
      fp.setAlignment(Layout.BASELINE);
      lp.addLayer(deref fp, Layout.RIGHT);
      fp_scale <= fp;

      l.addLayer(deref lp, Layout.BOTTOM);

      // Add Offset widgets
      lp <= Panel.New();
      lp.setPadding4f(6,0,0,0);

      lb <= Label.New();
      lb.setCaption("Offset:");
      lb.setTextPlacement(Layout.RIGHT);
      lb.setSizeGroup(sgxLabel);
      lb.setAlignment(Layout.BASELINE);
      lb.setPadLeft(2);
      lp.addLayer(deref lb, Layout.RIGHT);

      fp <= FloatParam.New();
      fp.setDisplayType(FloatParam.DISPLAY_FLOAT);
      fp.setPrecision(5);
      fp.setStepCoarse(0.01);
      fp.setStepFine(0.001);
      fp.setMinMaxValues(-128, 128);
      fp.setResetValue(0.0);
      fp.setValue(0.0);
      fp.setAlignment(Layout.BASELINE);
      lp.addLayer(deref fp, Layout.RIGHT);
      fp_offset <= fp;

      l.addLayer(deref lp, Layout.BOTTOM);

      // Add OK button
      Button btOk <= Button.NewDialog();
      btOk.setCaption("Apply");
      btOk.setAlignment(Layout.CENTER);
      btOk.setPadding4f(UIConstants.DIALOGBUTTON_PAD_TOP, UIConstants.DIALOGBUTTON_PAD_LEFT,
                        UIConstants.DIALOGBUTTON_PAD_BOTTOM, UIConstants.DIALOGBUTTON_PAD_RIGHT
                        );
      btOk.setInnerPadding4f(UIConstants.DIALOGBUTTON_INSET_TOP, UIConstants.DIALOGBUTTON_INSET_LEFT,
                             UIConstants.DIALOGBUTTON_INSET_BOTTOM, UIConstants.DIALOGBUTTON_INSET_RIGHT
                             );
      btOk.setProvidedActionAlias(Button.ACTION_CLICK, "ok");
      btOk.setEnableLabelButtonHiDPI();
      bt_ok <= btOk;

      // Add Cancel button
      Button btCancel <= Button.NewDialog();
      btCancel.setCaption("Cancel");
      btCancel.setAlignment(Layout.CENTER);
      btCancel.setIcon(UI.GetIcon("cancel"));
      btCancel.setIconScale(0.5);
      btCancel.setPadding4f(UIConstants.DIALOGBUTTON_PAD_TOP, UIConstants.DIALOGBUTTON_PAD_LEFT,
                            UIConstants.DIALOGBUTTON_PAD_BOTTOM, UIConstants.DIALOGBUTTON_PAD_RIGHT
                            );
      btCancel.setInnerPadding4f(UIConstants.DIALOGBUTTON_INSET_TOP, UIConstants.DIALOGBUTTON_INSET_LEFT,
                                 UIConstants.DIALOGBUTTON_INSET_BOTTOM, UIConstants.DIALOGBUTTON_INSET_RIGHT
                                 );
      btCancel.setProvidedActionAlias(Button.ACTION_CLICK, "cancel");
      btCancel.setEnableLabelButton(true);

      // Group the Ok and Cancel buttons
      Panel p <= Panel.New();
      p.addLayer(deref btOk, Layout.LEFT);
      p.addLayer(deref btCancel, Layout.RIGHT);
      p.setAlignment(Layout.CENTER);

      l.addLayer(deref p, Layout.BOTTOM);

      // Initialize window
      initWindow(deref l,
                 "Scale / Offset",
                 0, 0, // update position in show()
                 MIN_WIDTH, MIN_HEIGHT
                 );

      resizeToMinimum();
   }

   public method getScale() : float {
      return fp_scale.getFloatValue();
   }

   public method getOffset() : float {
      return fp_offset.getFloatValue();
   }

   protected handleSelection() {
      hide();
      if(recipient instanceof ActionConsumer)
      {
         Action ac <= Action.New(ACTION_NAME, this);
         recipient.consumeAction(ac);
         // Note: Do not add code below this line since the dialog instance may have been deleted by the recipient!
      }
   }

   protected dialogCanceled() {
      hide();
   }

   protected method refocusDefault() {
      UI.SetKeyboardFocus(bt_ok);
   }

   public virtual consumeAction(Action _action) : boolean {
      String acName = _action.getActionName();
      ActionProvider ap <= _action.getActionProvider();
      switch(acName)
      {
         case "ok":
            handleSelection();
            break;

         case "cancel":
            dialogCanceled();
            break;
      }
      switch(@(ap))
      {
         case @(fp_scale):
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            break;

         case @(fp_offset):
            if(FloatParam.ACTION_VALUECHANGED == acName)
               refocusDefault();
            break;
      }
      return true;
   }

   public virtual onKey(Key _key) : boolean {
      switch(_key.pressed)
      {
         case VKEY_ESCAPE:
            dialogCanceled();
            return true;

         case VKEY_RETURN:
         case VKEY_SPACE:
            handleSelection();
            return true;

         default:
            break;
      }
      return false;
   }

   protected virtual preShow() {
      Dialog::preShow();
   }

   protected virtual postShow() {
      Dialog::postShow();
      UI.SetKeyboardFocus(fp_scale);
   }

}
