// (note) Twister MIDI-Channel #1 profile must be set to "MIDI Fighter Twister Encoders"
// (note) Twister MIDI-Channel #2 profile must be set to "MIDI Fighter Twister Buttons"
// (note) bank A encoders are virtualized into 4 NRPN banks A:A..A:D

/*
   mapping ("twister mixed.mms"):
      + twister bank A:
         + editfocus
         + row 1 buttons: select bank A..D
         + row 2 buttons: select virtual bank A:A..A:D
      + twister bank B:
         + row 1 buttons: select bank A..D
         + row 1 encoders: Eureka track select, lane fade nr, param set 1 smooth, param set 2 smooth
         + row 2 encoders: change current Eureka track output 1..4 level
         + row 3 encoders: change current Eureka track performance controllers MW, BC, FC, EX
         + row 4 encoders: change current track ctl_1..ctl_4 (modmatrix)
      ! twister bank C:
         + row 1 buttons: select bank A..D
         ! row 1..4 encoders: user defined
      ! twister bank D:
         + row 1 buttons: select bank A..D
         ! row 1..4 encoders: user defined
*/

module MMFTwister;

use namespace st2;
use namespace ui;

boolean b_debug = 0;


// <class.png>
class MFTwisterRotary {
   // MIDI Fighter Twister rotary (-indicator)

   MFTwister *parent_twister;
   int rotary_idx;  // 0..(NUM_[VIRTUAL_]BANKS*NUM_ROTARIES_PER_BANK)  => 0..63

   short value;       // current value (14bit)
   short dev_value;   // last value sent to device (14bit)
   short out_value;   // current send value (14bit)


   // <method_init.png>
   public method init() {
      dev_value = -1;
   }

   // <method.png>
   public method forceUpdate() {
      dev_value = -1;
      out_value = value;
   }

   static Map7To14(float _f7) : float {
      if(_f7 >= 64.0)
         return 8192.0 + (_f7-64.0) * (8191.0 / 63.0);
      else
         return 8192.0 - (64.0 - _f7) * (8192.0 / 64.0);
   }

   static Map14To7(float _f14) : float {
      if(_f14 >= 8192.0)
         return 64.0 + (_f14-8192.0) * (63.0 / 8191.0);
      else
         return 64.0 - (8192.0 - _f14) * (64.0 / 8192.0);
   }

   public method sendUpdateWhenChanged(Buffer _buf, boolean _bVirt) {
      // Rotary (indicator) automation
      if(dev_value != out_value)
      {
         if(b_debug)
            trace "[trc] MFTwister: send rotary["+rotary_idx+"] out_value="+out_value+" (was "+dev_value+") bVirt="+_bVirt;
         dev_value = out_value;
         _buf.i8 = 0xB0; // CC
         _buf.i8 = _bVirt ? (rotary_idx & 15) : rotary_idx;
         _buf.i8 = int(MFTwisterRotary.Map14To7(dev_value));  // value
      }
   }

   // <save.png>
   public method saveState(Stream ofs) {
      // ver
      ofs.i16 = 1;

      // Value
      ofs.i16 = value;
   }

   // <load.png>
   public method loadState(Stream ifs) : boolean {
      // ver
      short ver = ifs.u16;

      if(ver >= 1)
      {
         // Value
         value = ifs.u16;

         return true;
      }
      else
      {
         trace "[---] MFTwisterRotary: rotary_idx="+rotary_idx+" invalid ver="+ver;
      }
      return false;
   }

}


// <class.png>
class MFTwister : BidiCtl {
   define String DEVICE_ALIAS = "twister";

   define int NUM_VIRTUAL_BANKS     = 4;  // A:A..A:D
   define int NUM_BANKS             = 4;  // A..D
   define int NUM_ROTARIES_PER_BANK = 16;

   define int NUM_UPDATE_PARTITIONS = 4;  // must be POT

   boolean b_connected;

   MFTwisterRotary *[] virtual_rotaries;  // bank A:A..A:D
   MFTwisterRotary *[] rotaries;          // HW banks A..D

   Buffer buf;

   int virtual_bank_idx;  // 0..3 => 'A'..'D'

   int   undo_rotary_idx;  // 0..255  TODO unused, remove
   short undo_value;       // 0..16383

   int tick_nr;


   // <method_init.png>
   public virtual init() : boolean {
      // BidiCtl::init();

      if(b_debug)
         trace "[trc] MFTwister: STConfig.b_mf_twister="+STConfig.b_mf_twister;

      int rotaryIdx;
      MFTwisterRotary *rotary;

      virtual_rotaries.alloc(NUM_VIRTUAL_BANKS * NUM_ROTARIES_PER_BANK);
      rotaryIdx = 0;
      loop(virtual_rotaries.maxElements)
      {
         rotary <= new MFTwisterRotary;
         rotary.rotary_idx = rotaryIdx++;
         rotary.parent_twister <= this;
         rotary.init();
         virtual_rotaries.add(#(deref rotary));
      }

      rotaries.alloc(NUM_BANKS * NUM_ROTARIES_PER_BANK);
      rotaryIdx = 0;
      loop(rotaries.maxElements)
      {
         rotary <= new MFTwisterRotary;
         rotary.rotary_idx = rotaryIdx++;
         rotary.parent_twister <= this;
         rotary.init();
         rotaries.add(#(deref rotary));
      }

      undo_rotary_idx = -1;

      if(STConfig.b_mf_twister)
      {
         in_dev  <= MIDI.GetMIDIInDeviceByAliasOrName(DEVICE_ALIAS);
         out_dev <= MIDI.GetMIDIOutDeviceByAliasOrName(DEVICE_ALIAS);

         if(b_debug)
            trace "[trc] MFTwister: in_dev="+#(in_dev)+" out_dev="+#(out_dev);

         b_connected = ((null != in_dev) && (null != out_dev));

         if(b_connected)
            b_connected = in_dev.isOpen() && out_dev.isOpen();

         if(b_connected)
         {
            buf.size = 4096;

            selectBank(0);
         }

      }

      return b_connected;
   }

   public virtual selectBank(int _bankIdx) {
      // select virtual bank

      if(b_debug)
         trace "[trc] MFTwister::selectBank: bankIdx="+_bankIdx;

      virtual_bank_idx = _bankIdx;

      int rotaryIdx;

      // Force virtual rotary update
      rotaryIdx = virtual_bank_idx * NUM_ROTARIES_PER_BANK;
      loop(NUM_ROTARIES_PER_BANK)
      {
         MFTwisterRotary rotary <= rotaries[rotaryIdx++];
         rotary.forceUpdate();
      }

      if(!Global.b_initializing)
         root_form.queueUpdateBidirectionalControls();
   }

   public virtual handleMIDIEvent(RecordedMIDIEvent _recEv, ClassArray _midiMapRTEventQueue) : boolean {
      // called from replay thread
      MIDIMapEvent ev;
      ev.initFromRecordedMIDIEvent(in_dev, _recEv);

      MFTwisterRotary *rotary;
      int rotaryIdx;
      short t;

      switch(ev.type)
      {
         case TYPE_PITCHBEND:
            break;

         case TYPE_NOTE_ON:
            if(b_debug)
               trace "[trc] MFTwister: note on "+ev.arg1;
            break;

         case TYPE_NOTE_OFF:
            if(b_debug)
               trace "[trc] MFTwister: note off "+ev.arg1;
            break;

         case TYPE_CC:
            if(b_debug)
               trace "[trc] MFTwister: CC ch="+ev.dev_ch+" ext_type="+ev.ext_type+" arg1="+ev.arg1;
            if(0 == ev.dev_ch)
            {
               if(0 <= ev.ext_type < NUM_ROTARIES_PER_BANK)
               {
                  // bank A virtual rotary encoders
                  rotaryIdx = ev.ext_type + (virtual_bank_idx * NUM_ROTARIES_PER_BANK);
                  rotary <= virtual_rotaries.get(rotaryIdx);

                  if(null != rotary)
                  {
                     rotary.value     = MFTwisterRotary.Map7To14(ev.arg1);
                     rotary.dev_value = rotary.value;
                     rotary.out_value = rotary.value;
                     if(b_debug)
                        trace "[>>>] MFTwister: virtual_rotary["+rotaryIdx+"] value="+rotary.value+" ev.ext_type="+ev.ext_type;
                     handleRotaryEdited(rotary, _midiMapRTEventQueue);
                     return true;
                  }
               }
               else
               {
                  // banks B..D
                  rotaryIdx = ev.ext_type;
                  rotary <= rotaries.get(rotaryIdx);

                  if(null != rotary)
                  {
                     rotary.value     = MFTwisterRotary.Map7To14(ev.arg1);
                     rotary.dev_value = rotary.value;
                     rotary.out_value = rotary.value;
                     if(b_debug)
                        trace "[>>>] MFTwister: rotary["+rotaryIdx+"] value="+rotary.value+" ev.ext_type="+ev.ext_type;
                     // (note) handled in MIDI morph scene (just track the value here)
                  }
               }

            }
            break;
      }

      return false;
   }

   public method tick() {
      // called from replay thread

      // (note) spread updates over multiple ticks
      int partition = (tick_nr++ & (NUM_UPDATE_PARTITIONS - 1));

      buf.offset = 0;

      MFTwisterRotary *rotary;
      int rotaryIdx;
      int numRotaries = NUM_ROTARIES_PER_BANK / NUM_UPDATE_PARTITIONS;

      // Bank B..D rotaries
      rotaryIdx = 16 + partition * numRotaries;
      loop(numRotaries)
      {
         int globalRotaryIdx = rotaryIdx;
         loop(NUM_BANKS - 1)  // B..D
         {
            rotary <= rotaries[globalRotaryIdx];
            rotary.sendUpdateWhenChanged(buf, false/*bVirt*/);
            globalRotaryIdx += NUM_ROTARIES_PER_BANK;
         }

         // Next rotary
         rotaryIdx++;
      }

      // Virtual bank A rotaries
      rotaryIdx = (virtual_bank_idx * NUM_ROTARIES_PER_BANK);
      rotaryIdx += partition * numRotaries;
      // trace "xxx partition="+partition+" rotaryIdx="+rotaryIdx+" numRotaries="+numRotaries;
      loop(numRotaries)
      {
         rotary <= virtual_rotaries[rotaryIdx];
         rotary.sendUpdateWhenChanged(buf, true/*bVirt*/);  // update bank A encoder (0..15)

         // Next rotary
         rotaryIdx++;
      }

      if(buf.offset > 0)
      {
         if(b_debug)
            Utils.HexDump(buf, 0, buf.offset);

         out_dev.sysExRaw(buf);
      }

   }

   // <method.png>
   protected method handleRotaryEdited(MFTwisterRotary _rotary, ClassArray _midiMapRTEventQueue) {
      // called from handleMIDIEvent()  (virtual bank A rotaries)
      if(b_debug)
         trace "[trc] MFTwister::handleRotaryEdited: rotary["+_rotary.rotary_idx+"] = "+_rotary.value+" (7bit: "+(_rotary.value>>7)+")";

      MIDIMapEvent midiMapEvent <= _midiMapRTEventQueue.nextFree;
      if(null != midiMapEvent)
      {
         midiMapEvent.initUntransformedFromNRPN(in_dev, 0/*dev_ch*/,
                                                _rotary.rotary_idx/*nrpn*/,
                                                _rotary.value
                                                );
         replay.sendUIEvent(midiMapEvent);
      }
   }

   // <ui_handle.png>
   public =replay= virtual handleSelectOrEditScene() {
      // called from UI thread
      //  - update rotary indicators from last seen morph scene src ctl value

      if(b_debug) trace "xxx MFTwister::rotary -----------------";

      MFTwisterRotary *rotary;
      int groupIdx = MIDIMorphScene.NUM_GROUPS - 1;  // iterate backwards (first group has priority over last)
      loop(MIDIMorphScene.NUM_GROUPS)  // A..H
      {
         // trace "MFTwister::handleSelectOrEditScene:  groupIdx="+rotary+" sceneIdx="+MIDIMorphScene.GetCurrentSceneIdx(rotary);
         MIDIMorphScene mms <= MIDIMorphScene.GetCurrentScene(groupIdx);
         MIDIMapEvent *mev;
         foreach mev in mms.mms_entries
         {
            if(@(mev.dev) == @(in_dev))
            {
               if(0 == mev.dev_ch)
               {
                  if(TYPE_NRPN == mev.type)
                  {
                     if(0 <= mev.ext_type < (NUM_ROTARIES_PER_BANK * NUM_VIRTUAL_BANKS))
                     {
                        rotary <= rotaries[mev.ext_type];

                        if(b_debug) trace "xxx MFTwister::handleOrSelectEditScene: OLD rotary.value="+rotary.value;
                        rotary.value = mev.last_morph_src_arg1;
                        if(b_debug) trace "xxx MFTwister::handleOrSelectEditScene:   NEW rotary.value="+rotary.value;

                        rotary.out_value = rotary.value;
                     }
                  }
               }
            }
         }

         // Next group
         groupIdx--;
      }
   }

   // <save.png>
   public virtual saveState(Stream ofs) {
      // (todo) unused (=> don't save anything)

      // ver
      ofs.i16 = 1;

      // num rotaries
      ofs.i16 = rotaries.numElements;

      MFTwisterRotary *rotary;
      foreach rotary in rotaries
         rotary.saveState(ofs);

      // Current Bank
      ofs.i8 = virtual_bank_idx;

      // Rotary Undo
      ofs.i16 = undo_rotary_idx;
      ofs.i16 = undo_value;
   }

   // <load.png>
   public virtual loadState(Stream ifs) : boolean {
      // (todo) unused (=> don't load anything)

      // ver
      short ver = ifs.u16;

      if(ver >= 1)
      {
         // num rotaries
         int numRotaries = ifs.u16;

         if(numRotaries != rotaries.numElements)
            trace "[!!!] MFTwister::loadState: numRotaries="+numRotaries+" != rotaries.numElements="+rotaries.numElements;

         MFTwisterRotary *rotary;
         foreach rotary in rotaries
         {
            if(!rotary.loadState(ifs))
            {
               return false;
            }
         }

         // Current Bank
         byte bankIdx = ifs.u8;

         // Rotary Undo
         undo_rotary_idx = ifs.s16;
         undo_value = ifs.s16;

         selectBank(bankIdx);

         return true;
      }
      else
      {
         trace "[---] MFTwister: invalid ver="+ver;
      }

      return false;
   }

   // <method.png>
   public virtual handleReplayTimer() {
      // called from UI thread
   }

   // <method.png>
   protected method updateRotariesFromOutputState() {
      // (note) currently unused / never called
      Global.Debug("MFTwister::updateRotariesFromOutputState");

      int rotaryIdx = virtual_bank_idx * NUM_ROTARIES_PER_BANK;
      loop(NUM_ROTARIES_PER_BANK)
      {
         MFTwisterRotary rotary <= rotaries[rotaryIdx];

         int groupIdx = 0;
         loop(MIDIMorphScene.NUM_GROUPS)
         {
            MIDIMorphScene mms <= MIDIMorphScene.GetCurrentScene(groupIdx);

            MIDIMapEvent *srcEv;
            foreach srcEv in mms.mms_entries
            {
               if(@(srcEv.dev) == @(in_dev))
               {
                  if(MIDIMapDefs.TYPE_NRPN == srcEv.type)
                  {
                     if(rotaryIdx == srcEv.ext_type)
                     {
                        MIDIMapEvent dstEv <= srcEv.morph_target;
                        short outVal = dstEv.getOutputState();

                        if(outVal >= 0)
                        {
                           short val = srcEv.unmapMorphedValue(outVal, true/*b14bit*/);
                           if(val >= 0)
                           {
                              trace "[>>>] MFTwister::updateRotariesFromOutputState: rotaryIdx="+rotaryIdx+" outVal="+outVal+" => inVal="+val;
                              srcEv.last_morph_src_arg1 = val;
                              rotary.value = val;
                              rotary.out_value = val;
                           }
                        }
                     }
                  }
               }
            }

            // Next group
            groupIdx++;
         }

         // Next rotary
         rotaryIdx++;
      }
   }

   // <method.png>
   public =replay= virtual queueBidirectionalRPNUpdate(int _devIdx, byte _ch,
                                                       STX_MIDIOutDevice _autoDev,
                                                       short _rpn, short _rpnVal,
                                                       String _labelOrNull // "-" == unused
                                                       ) {
      if(b_debug)
         trace "[>>>] MFTwister::queueBidirectionalRPNUpdate: rpn="+_rpn+" rpnVal="+_rpnVal;

      if("-" == _labelOrNull)
         _rpnVal = 0;

      int groupIdx = 0;
      loop(MIDIMorphScene.NUM_GROUPS)
      {
         MIDIMorphScene mms <= MIDIMorphScene.GetCurrentScene(groupIdx);

         MIDIMapEvent *srcEv;
         foreach srcEv in mms.mms_entries
         {
            if(@(srcEv.dev) == @(in_dev))
            {
               MIDIMapEvent dstEv <= srcEv.morph_target;
               if(MIDIMapDefs.TYPE_RPN == dstEv.type)
               {
                  if(dstEv.ext_type == _rpn)
                  {
                     STX_MIDIOutDevice dstDev <= dstEv.dev;
                     if(null != dstDev)
                     {
                        boolean bMatch = @(dstDev) == @(_autoDev);

                        if(!bMatch)
                        {
                           bMatch =
                              (dstDev.dev_idx == _devIdx) &&
                              (dstEv.dev_ch == _ch);
                        }

                        if(bMatch)
                        {
                           boolean bSrcCC = (MIDIMapDefs.TYPE_CC == srcEv.type);
                           if(MIDIMapDefs.TYPE_NRPN == srcEv.type || bSrcCC)
                           {
                              int rotaryIdx = srcEv.ext_type;
                              MFTwisterRotary rotary <= bSrcCC ? rotaries.get(rotaryIdx) : virtual_rotaries.get(rotaryIdx);
                              if(null != rotary)
                              {
                                 if(b_debug)
                                    trace "[trc] MFTwister::queueBidirectionalRPNUpdate: match rotaryIdx="+rotaryIdx+" value="+_rpnVal+" bSrcCC="+bSrcCC;

                                 rotary.value     = _rpnVal;
                                 rotary.out_value = _rpnVal;

                                 srcEv.last_morph_src_arg1 = bSrcCC ? (_rpnVal / 129) : _rpnVal;
                                 srcEv.setMorphAutoLabelKeepFlags(_labelOrNull);
                              }
                           }
                        }
                     }
                  }
               }
            }
         }

         // Next group
         groupIdx++;
      }

   }

   // <method.png>
   public =replay= method queueBidirectionalCCUpdate(int _devIdx, byte _ch,
                                                      STX_MIDIOutDevice _autoDev,
                                                      byte _cc, byte _ccVal,
                                                      String _labelOrNull // "-" == unused
                                                      ) {
      if(b_debug)
         trace "[>>>] MFTwister::queueBidirectionalRPNUpdate: cc="+_cc+" ccVal="+_ccVal;

      if("-" == _labelOrNull)
         _ccVal = 0;

      int groupIdx = 0;
      loop(MIDIMorphScene.NUM_GROUPS)
      {
         MIDIMorphScene mms <= MIDIMorphScene.GetCurrentScene(groupIdx);

         MIDIMapEvent *srcEv;
         foreach srcEv in mms.mms_entries
         {
            if(@(srcEv.dev) == @(in_dev))
            {
               MIDIMapEvent dstEv <= srcEv.morph_target;
               if(MIDIMapDefs.TYPE_CC == dstEv.type)
               {
                  if(dstEv.ext_type == _cc)
                  {
                     STX_MIDIOutDevice dstDev <= dstEv.dev;
                     if(null != dstDev)
                     {
                        boolean bMatch = @(dstDev) == @(_autoDev);

                        if(!bMatch)
                        {
                           bMatch =
                              (dstDev.dev_idx == _devIdx) &&
                              (dstEv.dev_ch == _ch);
                        }

                        if(bMatch)
                        {
                           if(MIDIMapDefs.TYPE_CC == srcEv.type)
                           {
                              int rotaryIdx = srcEv.ext_type;
                              MFTwisterRotary rotary <= rotaries.get(rotaryIdx);
                              if(null != rotary)
                              {
                                 if(b_debug)
                                    trace "[trc] MFTwister::queueBidirectionalCCUpdate: match rotaryIdx="+rotaryIdx+" value="+_ccVal;

                                 rotary.value     = _ccVal * 129;
                                 rotary.out_value = _ccVal * 129;

                                 srcEv.last_morph_src_arg1 = _ccVal;
                                 srcEv.setMorphAutoLabelKeepFlags(_labelOrNull);
                              }
                           }
                        }
                     }
                  }
               }
            }
         }

         // Next group
         groupIdx++;
      }
   }

}
