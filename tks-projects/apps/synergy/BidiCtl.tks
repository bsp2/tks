module MBidiCtl;

use namespace ui;
use namespace st2;


// <class.png>
abstract class BidiCtl : RemoteQueryCtlTargetsListener, MIDIMapDefs {
   // base class for bidirectional controllers
   //   implemented by:
   //     - FaderPort
   //     - MFTwister
   STX_MIDIInDevice *in_dev;
   STX_MIDIOutDevice *out_dev;

   // <method_init.png>
   public method init() : boolean {
      // implemented by derived classes
   }

   // <method_set.png>
   public method selectBank(int _bankIdx) {
      // implemented by derived classes
      //  (note) called from replay thread
   }

   // <method_set.png>
   public =replay= method selectBank_Sync(int _bankIdx) {
      // (note) when called from UI thread
      selectBank(_bankIdx);
   }

   // <method.png>
   public method handleReplayTimer() {
      // implemented by derived classes
   }

   // <method.png>
   public method handleMIDIEvent(RecordedMIDIEvent _recEv, ClassArray _midiMapRTEventQueue) : boolean {
      // implemented by derived classes
      return false;
   }

   // <ui_handle.png>
   public =replay= method handleSelectOrEditScene() {
      // implemented by derived classes
      //   - called from UI thread
      //   - update rotary indicators from last seen morph scene src ctl value
   }

   // <method.png>
   public method tick() {
      // implemented by derived classes
      //   - called from replay thread
      //   - send queued fader / rotary-indicator updates (sync shadow with device state)
   }

   // <method.png>
   public =replay= method queueBidirectionalRPNUpdate(int _devIdx, byte _ch,
                                                      STX_MIDIOutDevice _autoDev,
                                                      short _rpn, short _rpnVal,
                                                      String _labelOrNull // "-" == unused
                                                      ) {
      // implemented by derived classes
      //  (note) 'rpn': usually ctl_1..64 (RPN#100..163, see internal.msp)
   }

   // <method.png>
   public =replay= method queueBidirectionalCCUpdate(int _devIdx, byte _ch,
                                                     STX_MIDIOutDevice _autoDev,
                                                     byte _cc, byte _ccVal,
                                                     String _labelOrNull // "-" == unused
                                                     ) {
      // implemented by derived classes
      //  (note) 'cc': usually performance ctl MW,BC,FC,EX,GP#1..4
   }

   // <save.png>
   public method saveState(Stream ofs) {
      // implemented by derived classes
   }

   // <load.png>
   public method loadState(Stream ifs) : boolean {
      // implemented by derived classes
      return true;
   }

   // <method.png>
   public static QueueBidirectionalRPNUpdate(STX_MIDIOutDevice _dev, short _rpn, float _rpnVal, String _labelOrNull) {
      // trace "xxx Node::QueueBidirectionalRPNUpdate: rpn="+_rpn+" val="+_rpnVal+" label=\""+_labelOrNull+"\"";
      short rpnVal;
      BidiCtl *bidiCtl;
      foreach bidiCtl in bidi_ctls
      {
         rpnVal = mathMini(16383, _rpnVal+0.5);
         if(null != _dev)
            bidiCtl.queueBidirectionalRPNUpdate(-99/*devIdx*/, -99/*devCh*/, _dev,
                                                _rpn, rpnVal,
                                                _labelOrNull
                                                );
      }
   }

   // <method.png>
   public static QueueBidirectionalCCUpdate(STX_MIDIOutDevice _dev, byte _cc, float _ccVal, String _labelOrNull) {
      // trace "xxx Node::QueueBidirectionalCCUpdate: cc="+_cc+" val="+_ccVal+" label=\""+_labelOrNull+"\"";
      byte ccVal;
      BidiCtl *bidiCtl;
      foreach bidiCtl in bidi_ctls
      {
         ccVal = mathMini(127, _ccVal+0.5);
         if(null != _dev)
            bidiCtl.queueBidirectionalCCUpdate(-99/*devIdx*/, -99/*devCh*/, _dev,
                                               _cc, ccVal,
                                               _labelOrNull
                                               );
      }
   }

   // <method.png>
   public static QueueBidirectionalEditFocusRPNUpdate(short _rpn, float _rpnVal, String _labelOrNull) {
      // trace "xxx Node::QueueBidirectionalEditFocusRPNUpdate: rpn="+_rpn+" val="+_rpnVal+" label=\""+_labelOrNull+"\"";
      if(null != nodeeditor_editfocus_dev)
      {
         QueueBidirectionalRPNUpdate(nodeeditor_editfocus_dev, _rpn, _rpnVal, _labelOrNull);
      }
   }

   // <method.png>
   public static QueueBidirectionalRemoteAudioRPNUpdate(short _rpn, float _rpnVal, String _labelOrNull) {
      // trace "xxx Node::QueueBidirectionalRemoteAudioRPNUpdate: rpn="+_rpn+" val="+_rpnVal+" label=\""+_labelOrNull+"\"";
      if(null != pagesysex_autodev)
      {
         QueueBidirectionalRPNUpdate(pagesysex_autodev, _rpn, _rpnVal, _labelOrNull);
      }
   }

   // <method.png>
   public static QueueBidirectionalRemoteAudioCCUpdate(byte _cc, float _ccVal, String _labelOrNull) {
      // trace "xxx Node::QueueBidirectionalRemoteAudioCCUpdate: cc="+_cc+" val="+_ccVal+" label=\""+_labelOrNull+"\"";
      if(null != pagesysex_autodev)
      {
         QueueBidirectionalCCUpdate(pagesysex_autodev, _cc, _ccVal, _labelOrNull);
      }
   }

}
