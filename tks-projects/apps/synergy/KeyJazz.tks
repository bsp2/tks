module MKeyJazz;

use namespace ui;
use namespace st2;


// <class.png>
class KeyJazz_UndoEntry {
   tag int last_mode;
   tag int last_root_key;
   tag int last_cursor_x;
   tag int last_cursor_y;
   tag int last_note;
   tag int last_note_idx;
   tag int last_note_abs;
   tag int chord_mode;
   tag int chord_inversion;
   tag int velocity;

   public method init() {
      last_mode       = 0;
      last_root_key   = 0;
      last_cursor_x   = 0;
      last_cursor_y   = 0;
      last_note       = 0;
      last_note_idx   = 0;
      last_note_abs   = 5*12;
      chord_mode      = 0;
      chord_inversion = 0;
      velocity        = KeyJazz.DEF_VELOCITY;
   }

   public method copyFrom(KeyJazz_UndoEntry _o) {
      last_mode       = _o.last_mode;
      last_root_key   = _o.last_root_key;
      last_cursor_x   = _o.last_cursor_x;
      last_cursor_y   = _o.last_cursor_y;
      last_note       = _o.last_note;
      last_note_idx   = _o.last_note_idx;
      last_note_abs   = _o.last_note_abs;
      chord_mode      = _o.chord_mode;
      chord_inversion = _o.chord_inversion;
      velocity        = _o.velocity;
   }
}

// <class.png>
class KeyJazz : Layer {
   define int VP_W = 600;
   define int VP_H = 600;

   define int DEF_VELOCITY = 96;
   define int DEF_ROW_SHIFT = 4;

   define int NUM_UNDO_IO_SLOTS = 9;  // KP1..9
   protected Buffer *[] undo_io_slots;
   protected Buffer undo_io_slot_empty;

   float x;
   float y;
   float w;
   float h;
   float r;
   float g;
   float b;

   int cursor_x;  // 0..11
   int cursor_y;  // 0..1
   boolean b_queue_cursor_note;
   boolean b_queued_noteon_cursor;

   int mode;
   int root_key;  // -36..24
   int base_note; // 0..127, def=C-5(60)
   int last_note;
   int last_note_idx;
   int last_note_abs;

   byte note_velocity;  // see findDefaultVelocity()

   int row_shift;
   boolean b_row_shift_up;
   IntArray slot_row_shift;  // indexed by save slot idx
   IntArray slot_shift_up;   // indexed by save slot idx

   protected MIDIPipeFrame midi_frame;
   protected IntArray pending_noteoffs;

   define int CHORD_OFF               = 0;
   define int CHORD_DYAD_DEFAULT_3    = 20; // maj/min
   define int CHORD_DYAD_5            = 21;
   define int CHORD_DYAD_OCT          = 22;
   define int CHORD_DYAD_DEFAULT_35   = 23; // maj/min
   define int CHORD_DYAD_DEFAULT_6    = 24; // maj/min
   define int CHORD_DYAD_4            = 25;
   define int CHORD_DYAD_9            = 26;
   define int CHORD_DYAD_3            = 27;
   define int CHORD_DYAD_8            = 28;
   define int CHORD_DYAD_6            = 29;
   define int CHORD_TRIAD_DEFAULT     = 30; // maj/min
   define int CHORD_TRIAD_MAJ         = 31;
   define int CHORD_TRIAD_MIN         = 32;
   define int CHORD_TRIAD_DIM         = 33;
   define int CHORD_TETRAD_DEFAULT    = 40; // maj7/min7
   define int CHORD_TETRAD_MAJ7       = 41;
   define int CHORD_TETRAD_MIN7       = 42;
   define int CHORD_TETRAD_DIMMAJ7    = 43;
   define int CHORD_EXT_DEFAULT_9     = 50; // maj/min
   define int CHORD_EXT_DEFAULT_11    = 51; // maj/min
   define int CHORD_EXT_DEFAULT_7ADD5 = 52; // maj/min
   define int CHORD_EXT_MAJ9          = 53;
   define int CHORD_EXT_MAJ11         = 54;
   define int CHORD_EXT_MIN9          = 55;
   define int CHORD_EXT_MIN11         = 56;
   define int NUM_CHORDS              = 57;
   int chord_mode;
   boolean b_allow_chord;
   int chord_inversion;
   static IntArray chord_modes_dyad   = [ CHORD_OFF, CHORD_DYAD_DEFAULT_3, CHORD_DYAD_5, CHORD_DYAD_OCT, CHORD_DYAD_DEFAULT_35, CHORD_DYAD_DEFAULT_6,
                                          CHORD_DYAD_4, CHORD_DYAD_9, CHORD_DYAD_3, CHORD_DYAD_8, CHORD_DYAD_6
                                          ];
   static IntArray chord_modes_triad  = [ CHORD_OFF, CHORD_TRIAD_DEFAULT, CHORD_TRIAD_MAJ, CHORD_TRIAD_MIN, CHORD_TRIAD_DIM ];
   static IntArray chord_modes_tetrad = [ CHORD_OFF, CHORD_TETRAD_DEFAULT, CHORD_TETRAD_MAJ7, CHORD_TETRAD_MIN7, CHORD_TETRAD_DIMMAJ7 ];
   static IntArray chord_modes_ext5   = [ CHORD_OFF, CHORD_EXT_DEFAULT_9, CHORD_EXT_DEFAULT_7ADD5, CHORD_EXT_MAJ9, CHORD_EXT_MIN9 ];
   static IntArray chord_modes_ext6   = [ CHORD_OFF, CHORD_EXT_DEFAULT_11, CHORD_EXT_MAJ11, CHORD_EXT_MIN11 ];
   static StringArray chord_names;
   static StringArray chord_inversion_names = [ "-", "I", "II", "III", "IV" ];

   protected ClassArray undo_entries;
   protected int undo_idx;

   protected float stroke_w;
   MinnieDrawable drawable;

   protected float dmin_outer;
   protected float dmax_outer;

   protected float dmin_inner;
   protected float dmax_inner;

   protected float model_rot;
   protected int model_frot_damp_countdown;

   protected static StringArray note_names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];

   // ionian: maj,min,min,maj,maj,min,dim  indexed by cursor_x   0=maj  1=min  2=dim
   // mode shifts tbl to the left
   protected static IntArray chord_tbl = [0, 1, 1, 0, 0, 1, 2];

   // ionian whole,whole,half,whole,whole,whole,half
   // mode shifts tbl to the left
   protected static IntArray interval_tbl = [2, 2, 1, 2, 2, 2, 1];

   // updated when mode changes
   protected IntArray semi_tbl; // = [0, 2, 4, 5, 7, 9, 11];

   protected static IntArray mode_major_tbl = [
      1, 0, 0, 1, 1, 0, 0,
                                               ];

   protected static StringArray mode_names = [
      /*0*/"Ionian",
      /*1*/"Dorian",
      /*2*/"Phrygian",
      /*3*/"Lydian",
      /*4*/"Mixolydian",
      /*5*/"Aeolian",
      /*6*/"Locrian"

                                              ];

   protected IntArray   hl_notes;
   protected FloatArray hl_notes_amt;

   float frot;
   float frotspd;
   boolean b_rot;  // F12

   boolean b_fonts_loaded;

   Texture       font_30_tex;  // 30
   Buffer        font_30_bin;
   ShaderVG_Font font_30;

   Texture       font_256_sdf_tex;  // 256
   Buffer        font_256_sdf_bin;
   ShaderVG_Font font_256_sdf;

   define float FONT_30_SCL_MED_X = 1.0f;
   define float FONT_30_SCL_MED_Y = 1.0f;

   define float FONT_256_SCL_BIG_X = (48.0 / 256.0);
   define float FONT_256_SCL_BIG_Y = (48.0 / 256.0) * 1.0;

   define float FONT_256_SCL_MED_X = (30.0 / 256.0);
   define float FONT_256_SCL_MED_Y = (30.0 / 256.0) * 0.96;

   KeyJazzDialog *parent_dialog;  // or null

   protected PopupMenu *pm_context;


   // <method_init.png>
   protected method initInt(float _x, float _y,
                            float _w, float _h,
                            float _r, _g, _b
                            ) {
      x = _x;
      y = _y;
      w = _w;
      h = _h;
      r = _r;
      g = _g;
      b = _b;
      setRequiredSize2f(VP_W, VP_H);

      dmin_outer = 0.7;
      dmax_outer = 1.0;

      dmin_inner = 0.4;
      dmax_inner = 0.668;

      stroke_w = 12;

      b_rot = true;

      drawable.init();
      drawable.alloc(16*1024/*maxGLBufSize*/,
                      4*1024/*maxDrawBufSize*/
                     );

      genChordNames();

      base_note = 5*12;

      undo_io_slots.alloc(NUM_UNDO_IO_SLOTS);
      loop(NUM_UNDO_IO_SLOTS)
         undo_io_slots.add(#(new Buffer));
      slot_row_shift.allocAndFill(NUM_UNDO_IO_SLOTS, DEF_ROW_SHIFT);
      slot_shift_up.allocAndFill(NUM_UNDO_IO_SLOTS, false);

      note_velocity = DEF_VELOCITY;
      row_shift = DEF_ROW_SHIFT;
      b_row_shift_up = false;

      loadDefaults();
      last_note_abs = base_note;
      updateSemiTbl();
      b_queue_cursor_note = false;

      saveUndoToBuffer(undo_io_slot_empty);
   }

   // <method_init.png>
   public method init() {
      initLayer();
      initInt(VP_W*0.5, VP_H*0.5,
              VP_W*0.48, VP_H*0.48,
              0.075, 0.1, 0.12
              );
   }

   // <method.png>
   protected method loadDefaults() {
      root_key = 0;
      mode = 0; // Ionian
      chord_mode = CHORD_OFF;
      chord_inversion = 0;
      b_allow_chord = true;

      undo_entries.template = KeyJazz_UndoEntry;
      undo_entries.alloc(16);
      undo_entries.useAll();
      KeyJazz_UndoEntry *en;
      foreach en in undo_entries
      {
         en.last_note_abs = base_note;
         en.velocity = note_velocity;
      }
      undo_idx = 0;

      loginfo "Load defaults";
      if(null != parent_dialog)
         parent_dialog.setWindowTitle("");

      cursor_x = 0;
      cursor_y = 0;
      model_frot_damp_countdown = 50;
      updateSemiTbl();
   }

   // <method_set.png>
   protected method setRootKey(int _rootKey) {

      int rootKeyOct = (root_key / 12);

      int rootKeyOct0 = mathWrapi(_rootKey, 0, 12);
      int rootKey57 = mathWrapi(_rootKey, -5, 7);
      int rootKeyOctM1 = mathWrapi(_rootKey, -12, 0);

      if( abs(rootKeyOct0 - root_key) < abs(rootKey57 - root_key) )
      {
         if( abs(rootKeyOct0 - root_key) < abs(rootKeyOctM1 - root_key) )
            root_key = rootKeyOct0;
         else
            root_key = rootKeyOctM1;
      }
      else
      {
         if( abs(rootKey57 - root_key) < abs(rootKeyOctM1 - root_key) )
            root_key = rootKey57;
         else
            root_key = rootKeyOctM1;
      }

      root_key = mathWrapi(root_key, -7, 5);

      root_key += rootKeyOct * 12;
   }

   protected method rootKeyDown() {
      if(root_key > -36)
         root_key--;
   }

   protected method rootKeyUp() {
      if(root_key < 24)
         root_key++;
   }

   protected method changeRootKeyOctave(int _dir) {
      if(_dir < 0)
      {
         if(root_key >= (-36+12))
            root_key -= 12;
      }
      else
      {
         if(root_key < (36 - 12))
            root_key += 12;
      }
      int rootKeyOct = (root_key/12);
      loginfo "Octave is "+((rootKeyOct > 0)?"+":"")+rootKeyOct;
   }

   protected method changeVelocity(int _inc) {
      note_velocity = mathClampi(((note_velocity + _inc)/4)*4, 1, 127);
      loginfo "Velocity is "+note_velocity;
   }

   protected method changeRowShift(int _inc) {
      row_shift = mathClampi(row_shift + _inc, 0, 12);
      loginfo "Row Shift is "+row_shift;
   }

   protected method toggleRowShiftUp() {
      b_row_shift_up = !b_row_shift_up;
      loginfo "Row-shift-up is "+Utils.GetEnableString(b_row_shift_up);
   }

   protected method calcSemiTbl(IntArray _a, int _mode) {
      int i = 0;
      int semi = 0;
      _a.empty();
      loop(7*2)
      {
         _a.add(semi);
         semi += interval_tbl.get((i++ + _mode) % 7);
      }
   }

   protected method updateSemiTbl() {
      calcSemiTbl(semi_tbl, mode);
      log4 "updateSemiTbl: semi_tbl="+semi_tbl;
      int note;
      int idx = 0;
      loop(7)
      {
         log4 "["+idx+"] "+note_names.get(mathWrapi(root_key + semi_tbl.get(idx), 0, 12));
         idx++;
      }
   }

   protected method highlightNote(byte _note) {
      byte note = mathWrapi(_note, 0, 12);
      int idx = hl_notes.indexOf(note, 0);
      if(idx < 0)
      {
         hl_notes.add(note);
         idx = hl_notes.numElements -1;
      }
      hl_notes_amt[idx] = 1.0f;
   }

   protected method highlightNotesDecay(float _dt) {
      int idx = 0;
      loop(hl_notes.numElements)
      {
         float a = hl_notes_amt[idx];
         if(a > 0.0001)
            a = a * mathPowerf(0.94, _dt);
         else
            a = 0;
         hl_notes_amt[idx] = a;
         idx++;
      }

      idx = hl_notes.numElements - 1;
      while(idx >= 0)
      {
         if(hl_notes_amt[idx] < 0.0001)
         {
            hl_notes_amt.delete(idx);
            hl_notes.delete(idx);
         }
         idx--;
      }
   }

   protected method addPendingNoteOffsToBuffer() {
      int note;
      foreach note in pending_noteoffs
      {
         // log4 "pending noteOff("+note+")";
         midi_frame.noteOff(true/*bSet*/, SysEx.out_dev_idx, 0/*midiCh*/, note, 0/*vel*/);
      }
      pending_noteoffs.empty();
   }

   protected method beginMIDIFrame() {
      midi_frame.empty();
   }

   protected method endMIDIFrame() {
      replay.injectFrameRec(midi_frame);
      midi_frame.empty();
   }

   protected method releasePendingNoteOffs() {
      beginMIDIFrame();
      addPendingNoteOffsToBuffer();
      endMIDIFrame();
   }

   protected method noteOff(byte _note) {
      // log2 "noteOff("+_note+")";
      beginMIDIFrame();
      midi_frame.noteOff(true/*bSet*/, SysEx.out_dev_idx, 0/*midiCh*/, _note, 0/*vel*/);
      endMIDIFrame();
      int idx = pending_noteoffs.indexOf(_note, 0);
      if(idx >= 0)
         pending_noteoffs.delete(idx);
   }

   protected method addNoteOnToBuffer(byte _note) {
      midi_frame.noteOn(true/*bSet*/, SysEx.out_dev_idx, 0/*midiCh*/, _note, note_velocity, 0/*dur*/);
      pending_noteoffs.add(_note);
   }

   protected method noteOn(byte _note) {
      log3 "noteOn("+_note+") "+note_names.get(_note%12);
      beginMIDIFrame();
      addNoteOnToBuffer(_note);
      endMIDIFrame();
   }

   protected method addNotesToBufferChordInvert(IntArray _notes) {
      int idx = 0;
      stdout "[trc] addNotesToBufferChordInvert: notes=";
      loop(_notes.numElements)
      {
         byte note = _notes.get(idx) + ((idx < chord_inversion)?12:0);
         stdout " "+note_names.get(mathWrapi(note,0,12))+"-"+(note/12);
         addNoteOnToBuffer(note);
         highlightNote(note);
         idx++;
      }
      trace "";
   }

   protected method addNotesChordDef(IntArray notes, byte _noteIdx, byte _noteAbs, int _minMajDim) {
      switch(_minMajDim)
      {
         case 0: // maj
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            notes.add(_noteAbs + 7);
            break;

         case 1: // min
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 7);
            break;

         case 2: // dim
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 6);
            break;
      }
   }

   protected method noteOnChord(byte _noteIdx, int _noteAbs) {
      last_note = _noteAbs % 12;
      last_note_idx = _noteIdx;
      last_note_abs = _noteAbs;
      beginMIDIFrame();
      addPendingNoteOffsToBuffer();
      int minMajDim = chord_tbl.get(mathWrapi(_noteIdx + mode, 0, 7));
      boolean bMaj = (0 == minMajDim);
      log2 "noteOnChord: note="+note_names.get(mathWrapi(_noteAbs,0,12))+" bMaj="+bMaj;
      IntArray notes; notes.empty();
      switch(chord_mode)
      {
         case CHORD_OFF:
            // Should not be reachable
            break;

         case CHORD_DYAD_DEFAULT_3:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?4:3));
            break;

         case CHORD_DYAD_5:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 7);
            break;

         case CHORD_DYAD_OCT:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 12);
            break;

         case CHORD_DYAD_DEFAULT_35:
            notes.add(_noteAbs + (bMaj?4:3));
            notes.add(_noteAbs + 7);
            break;

         case CHORD_DYAD_DEFAULT_6:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?9:8));
            break;

         case CHORD_DYAD_4:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            break;

         case CHORD_DYAD_9:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 9);
            break;

         case CHORD_DYAD_3:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            break;

         case CHORD_DYAD_8:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 8);
            break;

         case CHORD_DYAD_6:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 6);
            break;

         case CHORD_TRIAD_DEFAULT:
            addNotesChordDef(notes, _noteIdx, _noteAbs, minMajDim);
            break;

         case CHORD_TRIAD_MAJ:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            notes.add(_noteAbs + 7);
            break;

         case CHORD_TRIAD_MIN:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 7);
            break;

         case CHORD_TRIAD_DIM:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 6);
            break;

         case CHORD_TETRAD_DEFAULT:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?4:3));
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + (bMaj?11:10));
            break;

         case CHORD_TETRAD_MAJ7:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 11);
            break;

         case CHORD_TETRAD_MIN7:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 10);
            break;

         case CHORD_TETRAD_DIMMAJ7:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 6);
            notes.add(_noteAbs + 11);
            break;

         case CHORD_EXT_DEFAULT_9:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?4:3));
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + (bMaj?11:10));
            notes.add(_noteAbs + 14);
            break;

         case CHORD_EXT_DEFAULT_11:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?4:3));
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + (bMaj?11:10));
            notes.add(_noteAbs + 14);
            notes.add(_noteAbs + (bMaj?18:17));
            break;

         case CHORD_EXT_DEFAULT_7ADD5:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + (bMaj?4:3));
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + (bMaj?9:8));
            notes.add(_noteAbs + (bMaj?11:10));
            break;

         case CHORD_EXT_MAJ9:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 11);
            notes.add(_noteAbs + 14);
            break;

         case CHORD_EXT_MAJ11:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 4);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 11);
            notes.add(_noteAbs + 14);
            notes.add(_noteAbs + 18);
            break;

         case CHORD_EXT_MIN9:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 10);
            notes.add(_noteAbs + 14);
            break;

         case CHORD_EXT_MIN11:
            notes.add(_noteAbs + 0);
            notes.add(_noteAbs + 3);
            notes.add(_noteAbs + 7);
            notes.add(_noteAbs + 10);
            notes.add(_noteAbs + 14);
            notes.add(_noteAbs + 17);
            break;
      }
      addNotesToBufferChordInvert(notes);
      endMIDIFrame();
   }

   protected method noteOnSingleOrChord(byte _noteIdx, byte _rowOffset/*-1..1*/) {

      if(b_row_shift_up)
         _rowOffset++;
      int noteIdx = _noteIdx + _rowOffset * row_shift;
      int oct = (noteIdx >= 7) ? ((noteIdx/7)*12) : (noteIdx < 0) ? ((noteIdx-6)/7)*12 : 0;
      noteIdx = mathWrapi(noteIdx, 0, 7);
      int note = base_note + root_key + semi_tbl.get(noteIdx) + oct;
      log4 "noteOnSingleOrChord: _noteIdx="+_noteIdx+" _rowOffset="+_rowOffset+" => noteIdx="+noteIdx+" note="+note+" oct="+oct;

      if(b_allow_chord && CHORD_OFF != chord_mode)
      {
         noteOnChord(noteIdx, note);
      }
      else
      {
         last_note = note % 12;
         last_note_idx = noteIdx;
         last_note_abs = note;
         noteOn(note);
         highlightNote(note);
      }
   }

   protected method noteOffSingleOrChord(byte _noteIdx, int _rowOffset/*-1..1*/) {

      if(b_row_shift_up)
         _rowOffset++;
      int noteIdx = _noteIdx + _rowOffset * row_shift;
      int oct = (noteIdx >= 7) ? ((noteIdx/7)*12) : (noteIdx < 0) ? ((noteIdx-6)/7)*12 : 0;
      noteIdx = mathWrapi(noteIdx, 0, 7);
      int note = base_note + root_key + semi_tbl.get(noteIdx) + oct;
      log4 "noteOffSingleOrChord: _noteIdx="+_noteIdx+" _rowOffset="+_rowOffset+" => noteIdx="+noteIdx+" note="+note+" oct="+oct;

      if(CHORD_OFF == chord_mode)
      {
         noteOff(note);
      }
      else
      {
         releasePendingNoteOffs();
      }
   }

   public method getRelativeNoteOffset(boolean _bInner) : int {
      if(_bInner)
      {
         if(mode_major_tbl.get(mode))
            return -3;
         else
            return 3;
      }
      else
      {
         return 0;
      }
   }

   protected method noteOnCursor() {
      noteOn(60 + mathWrapi(root_key + ((cursor_x*7)%12), 0, 12) + getRelativeNoteOffset(1 == cursor_y));
   }

   protected method noteOffCursor() {
      noteOff(60 + mathWrapi(root_key + ((cursor_x*7)%12), 0, 12) + getRelativeNoteOffset(1 == cursor_y));
   }

   protected method noteOnLastAbs() {
      log2 "noteOnLastAbs: last_note_abs="+last_note_abs;
      if(b_allow_chord && CHORD_OFF != chord_mode)
         noteOnChord(last_note_idx, last_note_abs);
      else
         noteOn(last_note_abs);
   }

   protected method findModeForGridPos(int _gridX, int _gridY, Integer _retNote, boolean _bDebug) : int {
      // root_key +
      if(_bDebug) log2 "--------------------------------------------";
      int note = mathWrapi(_gridX*7,0,12) + getRelativeNoteOffset(1 == _gridY);
      note = mathWrapi(note, 0, 12); //  + root_key
      if(_bDebug) log2 "findModeForCursorNoteIdx: note="+note+" root_key="+root_key+" semi_tbl="+semi_tbl;
      int semiIdx = semi_tbl.indexOf(note, 0);
      if(_bDebug) log2 "findModeForCursorNoteIdx: note="+note+" => semiIdx="+semiIdx;
      if(null != _retNote)
         _retNote = note;
      if(semiIdx >= 0)
      {
         if(_bDebug) log2 "mode+semiIdx="+mode+"+"+semiIdx+"="+(mode+semiIdx);
         int newMode = mathWrapi(mode + semiIdx, 0, 7);
         if(null != _retNote)
            _retNote = mathWrapi(note + root_key, -12, 12);
         return newMode;
      }
      return -1;
   }

   protected method undoReplace(int _idx) {
      KeyJazz_UndoEntry en <= undo_entries.get(_idx);
      en.last_mode       = mode;
      en.last_root_key   = root_key;
      en.last_cursor_x   = cursor_x;
      en.last_cursor_y   = cursor_y;
      en.last_note       = last_note;
      en.last_note_idx   = last_note_idx;
      en.last_note_abs   = last_note_abs;
      en.chord_mode      = chord_mode;
      en.chord_inversion = chord_inversion;
      en.velocity        = note_velocity;
   }

   protected method undoRestore(int _idx) {
      KeyJazz_UndoEntry en <= undo_entries.get(_idx);
      mode            = en.last_mode;
      root_key        = en.last_root_key;
      cursor_x        = en.last_cursor_x;
      cursor_y        = en.last_cursor_y;
      last_note       = en.last_note;
      last_note_idx   = en.last_note_idx;
      last_note_abs   = en.last_note_abs;
      chord_mode      = en.chord_mode;
      chord_inversion = en.chord_inversion;
      note_velocity   = en.velocity;
      if(0 == note_velocity)
         findDefaultVelocity();
      updateSemiTbl();
      redraw();
   }

   protected method undoDelete() {
      if(undo_entries.numElements > 0)
      {
         KeyJazz_UndoEntry en <= undo_entries.getDeref(undo_idx);
         en.init();
         undo_entries.delete(undo_idx);
         undo_entries.add(#(deref en));
         undoRestore(undo_idx);
         loginfo "Delete undo (step="+(undo_idx+1)+")";
         redraw();
      }
   }

   protected method undoInsert() {
      if(undo_idx + 1 < undo_entries.maxElements)
      {
         // Duplicate current
         KeyJazz_UndoEntry en <= undo_entries.get(undo_idx);
         KeyJazz_UndoEntry enIns <= undo_entries.getDeref(undo_entries.numElements - 1);
         enIns.copyFrom(en);
         undo_entries.delete(undo_entries.numElements - 1);
         undo_entries.insert(undo_idx, #(deref enIns));
         undo_idx++;
         handleUndoIdxChanged();
         loginfo "Duplicate undo (step="+(undo_idx+1)+")";
      }
   }

   protected method undoMoveToPrevious() {
      if(undo_idx > 0)
      {
         undo_entries.swap(undo_idx-1, undo_idx);
         undo_idx--;
         handleUndoIdxChanged();
         loginfo "Undo move down (step="+(undo_idx+1)+")";
      }
   }

   protected method undoMoveToNext() {
      if(undo_idx + 1 < undo_entries.maxElements)
      {
         undo_entries.swap(undo_idx+1, undo_idx);
         undo_idx++;
         handleUndoIdxChanged();
         loginfo "Undo move up (step="+(undo_idx+1)+")";
      }
   }

   protected method handleUndoIdxChanged() {
      if(null != parent_dialog)
         parent_dialog.setWindowTitle(String((undo_idx+1)));
      // log4 "undo_idx is "+undo_idx;
      model_frot_damp_countdown = 50;
      redraw();
   }

   protected method undoPush() {
      if(undo_idx + 1 < undo_entries.maxElements)
      {
         undoReplace(undo_idx);
         undo_idx++;
         handleUndoIdxChanged();
      }
   }

   protected method undoPop() {
      if(undo_idx > 0)
      {
         undoReplace(undo_idx);
         undoRestore(--undo_idx);
         handleUndoIdxChanged();
      }
   }

   protected method redo() {
      if(undo_idx + 1 < undo_entries.maxElements)
      {
         undoRestore(++undo_idx);
         handleUndoIdxChanged();
      }
   }

   protected method getUndoInfo() : String {
      return "(step="+(undo_idx+1)+") "+note_names.get(mathWrapi(root_key, 0, 12))+"-"+(5+(root_key/12))+" vel="+note_velocity;
   }

   protected method handleRedo() {
      undoReplace(undo_idx);
      redo();
      loginfo "Redo "+getUndoInfo();
      if(b_queue_cursor_note)
         noteOnLastAbs();
   }

   protected method handleReplace() {
      undoReplace(undo_idx);
      loginfo "Undo-replace "+getUndoInfo();
   }

   protected method handleUndo() {
      undoPop();
      loginfo "Undo "+getUndoInfo();
      if(b_queue_cursor_note)
         noteOnLastAbs();
   }

   protected method setRootKeyToCursor() {
      int relOff = getRelativeNoteOffset(1 == cursor_y);
      int note = mathWrapi(root_key + cursor_x*7, 0, 12) + relOff;
      undoPush();
      loginfo "Set root key to \'"+note_names.get(mathWrapi(note,0,12))+"\'";

      setRootKey(note);
      cursor_x = 0;
      cursor_y = 0;
      model_frot_damp_countdown = 50;

      redraw();
   }

   protected method setModeToCursorNoteIdx(boolean _bMode) : int {
      log2 "setModeToCursorNoteIdx(bMode="+_bMode+")";
      if(_bMode && 0 == cursor_x)
      {
         // force next mode that contains rootKey and plays last note on same noteIdx
         int rootKey = mathWrapi(root_key, 0, 12);
         int i = 1;
         IntArray semiTbl;
         loop(7)
         {
            calcSemiTbl(semiTbl, mathWrapi(mode + i, 0, 7));
            int idxRoot = semiTbl.indexOf(rootKey, 0);
            log2 "setModeToCursorNoteIdx: bMode/cursor_x=0 mode="+mode+" tryNextMode="+mathWrapi(mode+i,0,7)+" semiTbl="+semiTbl+" rootKey="+rootKey+"("+note_names.get(rootKey)+") idxRoot="+idxRoot;
            if(idxRoot >= 0)
            {
               undoPush();

               mode = mathWrapi(mode + i, 0, 7);
               model_frot_damp_countdown = 50;
               updateSemiTbl();
               // set cursor to cell that matches rootKey
               int cellX = 0;
               int innerOff = getRelativeNoteOffset(true/*bInner*/);
               loop(12)
               {
                  if( ((cellX*7)%12) == rootKey )
                  {
                     cursor_x = 0;//cellX;
                     cursor_y = 0;
                     log2 "setModeToCursorNoteIdx: bMode/cursor_x=0  found cellX="+cellX+" outer";
                     break;
                  }
                  else if( mathWrapi((((cellX*7)%12) + innerOff),0,12) == rootKey )
                  {
                     cursor_x = 0;//cellX;
                     cursor_y = 1;
                     log2 "setModeToCursorNoteIdx: bMode/cursor_x=0  found cellX="+cellX+" inner";
                     break;
                  }
                  cellX++;
               }
               log2 "setModeToCursorNoteIdx: bMode/cursor_x=0 mode="+mode+" tryNextMode="+mathWrapi(mode+i,0,7)+" semiTbl="+semiTbl+" rootKey="+rootKey+" idxRoot="+idxRoot;
               setRootKey(rootKey);
               int newNote = (base_note + root_key + semi_tbl.get(last_note_idx)) % 12;
               if(newNote != last_note)
               {
                  log2 "setModeToCursorNoteIdx: bMode/cursor_x=0: shift rootKey by "+(last_note - newNote)+" to match last_note="+last_note+" at last_note_idx="+last_note_idx+" (newNote="+newNote+")";
                  setRootKey(root_key + (last_note - newNote));
                  loginfo "Select mode \'"+mode_names.get(mode)+"\', root key="+note_names.get(mathWrapi(root_key, 0, 12));
               }
               redraw();
               return;
            }
            i++;
         }
         redraw();
         return;
      }

      if(_bMode)
      {
         Integer retNote;
         int newMode = findModeForGridPos(cursor_x, cursor_y, retNote, true/*bDebug*/);

         undoPush();

         if(newMode >= 0)
         {
            mode = newMode;
            setRootKey(retNote -/*+??*/ getRelativeNoteOffset(1 == cursor_y));
            cursor_x = 0;
            model_frot_damp_countdown = 50;
            updateSemiTbl();
            log2 "setModeToCursorNoteIdx: note="+retNote+" ====> mode="+mode+"  newRootKey="+root_key+" newSemiTbl="+semi_tbl;
            loginfo "Select mode \'"+mode_names.get(mode)+"\', root key="+note_names.get(mathWrapi(root_key, 0, 12));
            redraw();
         }
         else
         {
            setRootKeyToCursor();
         }
      }
      else
      {
         setRootKeyToCursor();
      }
   }

   protected method genChordName(int _chordMode) : String {
      String s = TKS.scriptClassConstantToString(#(_chordMode), this, "CHORD_");
      return
         s
         .replace("CHORD_", "")
         .replace("OFF","-")
         .replace("TRIAD_DEFAULT","a3")
         .replace("TETRAD_DEFAULT","a4")
         .replace("EXT_DEFAULT_","")
         .replace("DEFAULT_","")
         .replace("TRIAD_","")
         .replace("TETRAD_","")
         .replace("EXT_","")
         .toLower()
         ;
   }

   protected method genChordNames() {
      int chordIdx = 0;
      chord_names.empty();
      loop(NUM_CHORDS)
         chord_names.add(genChordName(chordIdx++));
   }

   protected method getChordName() : String {
      return chord_names.get(chord_mode);
   }

   protected method chordModeOff() {
      chord_mode = CHORD_OFF;
      loginfo "Select chord "+chord_names.get(chord_mode);
      redraw();
   }

   protected method cycleChordMode(IntArray _aModes) {
      int idx = _aModes.indexOf(chord_mode, 0);
      log4 "cycleChordMode: idx="+idx;
      chord_mode = _aModes.get(mathWrapi(++idx, 0, _aModes.numElements));
      log3 "cycleChordMode: new idx="+idx+" new chord_mode="+chord_mode;
      loginfo "Select chord "+getChordName();
      if(b_queue_cursor_note)
         noteOnLastAbs();
      redraw();
   }

   protected method toggleNoteAutoPlay() {
      b_queue_cursor_note = !b_queue_cursor_note;
      loginfo "Note auto-play is "+Utils.GetEnableString(b_queue_cursor_note);
      if(b_queue_cursor_note)
         b_queued_noteon_cursor = true;
   }

   protected method toggleAllowChord() {
      b_allow_chord = !b_allow_chord;
      loginfo "Chords are "+Utils.GetEnableString(b_allow_chord);
   }

   protected method cycleChordInversion(int _dir) {
      chord_inversion = mathWrapi(chord_inversion + _dir, 0, chord_inversion_names.numElements);
      loginfo "Select chord inversion \""+chord_inversion_names.get(chord_inversion)+"\"("+chord_inversion+")";
      if(b_queue_cursor_note)
         noteOnLastAbs();
      redraw();
   }

   protected method cycleMode(int _dir) {
      mode = mathWrapi(mode + _dir, 0, 7);
      updateSemiTbl();
      loginfo "Select mode \'"+mode_names.get(mode)+"\'";
      redraw();
   }

   protected method saveUndoInt(Stream ofs) {
      ofs.i8 = 1;
      ofs << undo_entries;
      ofs.i8 = undo_idx;
   }

   protected method saveUndoToBuffer(Buffer _b) {
      local DummyStream ds;
      ds.offset = 0;
      saveUndoInt(ds);

      _b.size = ds.offset;
      _b.offset = 0;
      saveUndoInt(_b);
   }

   protected method saveUndoByIndex(int _idx) {
      Buffer b <= undo_io_slots.get(_idx);
      log1 "save "+undo_entries.numElements+" undo entries";
      saveUndoToBuffer(b);

      slot_row_shift[_idx] = row_shift;
      slot_shift_up [_idx] = b_row_shift_up;

      loginfo "Undo saved to slot "+(_idx+1);
   }

   protected method isUndoSlotEmpty(int _idx) {
      Buffer b <= undo_io_slots.get(_idx);
      b.seek(0, SEEK_END);
      undo_io_slot_empty.seek(0, SEEK_END);
      return (0 == b.size) || b.compareBuffer(undo_io_slot_empty);
   }

   protected method loadUndoByIndex(int _idx) {
      Buffer b <= undo_io_slots.get(_idx);
      b.offset = 0;
      byte ver = b.i8;
      if(1 == ver)
      {
         undo_entries << b;
         undo_idx = b.u8;

         row_shift      = slot_row_shift[_idx];
         b_row_shift_up = slot_shift_up [_idx];

         loginfo "Undo restored from slot "+(_idx+1)+" "+getUndoInfo()+"  shift="+row_shift+" up="+b_row_shift_up;
         undoRestore(undo_idx);
      }
   }

   // <ui_handle.png>
   protected method handleCursorUp() {
      if(cursor_y > 0)
      {
         cursor_y = 0;
      }
      else
      {
         cursor_x = mathWrapi(cursor_x + 6, 0, 12);
      }
      if(b_queue_cursor_note)
         b_queued_noteon_cursor = true;
      model_frot_damp_countdown = 50;
   }

   // <ui_handle.png>
   protected method handleCursorDown() {
      if(0 == cursor_y)
      {
         cursor_y = 1;
      }
      else
      {
         cursor_y = 1;
         cursor_x = mathWrapi(cursor_x + 6, 0, 12);
      }
      if(b_queue_cursor_note)
         b_queued_noteon_cursor = true;
      model_frot_damp_countdown = 50;
   }

   // <ui_handle.png>
   protected method handleCursorLeft() {
      cursor_x = mathWrapi(cursor_x - 1, 0, 12);
      if(b_queue_cursor_note)
         b_queued_noteon_cursor = true;
      model_frot_damp_countdown = 50;
      redraw();
   }

   // <ui_handle.png>
   protected method handleCursorRight() {
      cursor_x = mathWrapi(cursor_x + 1, 0, 12);
      if(b_queue_cursor_note)
         b_queued_noteon_cursor = true;
      model_frot_damp_countdown = 50;
      redraw();
   }

   // <method.png>
   public method findDefaultVelocity() {
      // (note) called by KeyJazzDialog::preShow()
      if(root_form.isTrackerEditorVisible())
      {
         PageNode pgNode <= root_form.pg_node;
         NodeTracker nt <= pgNode.script_node;
         note_velocity = nt.def_velocity;
      }
      else
      {
         note_velocity = DEF_VELOCITY;
      }
      log3 "KeyJazz: note_velocity="+note_velocity;
   }

   // <method.png>
   protected method trackerRestartRecording(Key _k) {
      PageNode pgNode <= root_form.pg_node;
      NodeTracker nt <= pgNode.script_node;
      NodeTrackerEditor ntEditor <= pgNode.editor;
      NT_PatternView pv <= ntEditor.pattern_view;
      UI.SetKeyboardFocus(pv);  // isEditable() required kbdfocus
      if(replay.b_playing && pv.isEditable() && (0 == _k.mod))
         ntEditor.cmd_edit_undo(); // undo and restart recording
      else
         pv.handleKeyRShift(_k.modCtrl());  // start recording
      UI.SetKeyboardFocus(this);
   }

   // <method.png>
   protected method seqRestartRecording() {
      PageNode pgNode <= root_form.pg_node;
      NodeSeq seq <= pgNode.script_node;
      NodeSeqEditor seqEditor <= pgNode.editor;
      NSQ_Arranger arr <= seqEditor.arr;
      UI.SetKeyboardFocus(arr);
      if(seq.b_rec && replay.b_playing)
      {
         // Undo + restart recording
         arr.tryQueueRecordRestart();
      }
      else
      {
         // Stop replay / Start recording
         if(replay.b_playing)
            seqEditor.startOrStopRecording(false/*bMMC*/);
         seqEditor.startOrStopRecording(false/*bMMC*/);
      }
      UI.SetKeyboardFocus(this);
   }

   // <method.png>
   protected method tryHandleNodeRestartRecording() {
      if(root_form.isTrackerEditorVisible())
      {
         Key k; k.pressed = VKEY_RSHIFT;
         trackerRestartRecording(k);
         return true;
      }
      else if(root_form.isSeqEditorVisible())
      {
         seqRestartRecording();
         return true;
      }
   }

   // <method.png>
   protected method trackerToggleEditMode() {
      PageNode pgNode <= root_form.pg_node;
      NodeTracker nt <= pgNode.script_node;
      NodeTrackerEditor ntEditor <= pgNode.editor;
      NT_PatternView pv <= ntEditor.pattern_view;
      UI.SetKeyboardFocus(pv);  // isEditable() required kbdfocus
      pv.handleKeyRCtrl(false/*bShift*/);
      UI.SetKeyboardFocus(this);
   }

   // <method.png>
   protected method seqToggleEditMode(Key _k) {
      PageNode pgNode <= root_form.pg_node;
      NodeSeq seq <= pgNode.script_node;
      NodeSeqEditor seqEditor <= pgNode.editor;
      UI.SetKeyboardFocus(seqEditor);
      seqEditor.onKey(_k);
      UI.SetKeyboardFocus(this);
   }

   // <method.png>
   protected method tryHandleNodeToggleEdit() : boolean {
      if(root_form.isTrackerEditorVisible())
      {
         trackerToggleEditMode();
         return true;
      }
      else if(root_form.isSeqEditorVisible())
      {
         Key k; k.pressed = VKEY_RCTRL;
         seqToggleEditMode(k);
         return true;
      }
      return false;
   }

   // <method.png>
   protected method tryTrackerHandleKeyUp(Key _k) : boolean {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeTracker nt <= pgNode.script_node;
      NodeTrackerEditor ntEditor <= pgNode.editor;
      NT_PatternView pv <= ntEditor.pattern_view;
