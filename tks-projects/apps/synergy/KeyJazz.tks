   // <method.png>
   protected method isTrackerEditable() : boolean {
      if(root_form.isTrackerEditorVisible())
      {
         PageNode pgNode <= root_form.pg_node;
         NodeTracker nt <= pgNode.script_node;
         return (NodeTracker.PV_EDIT_NONE != nt.pv_edit_mode);
      }
      return false;
   }

   // <method.png>
   protected method isSeqEditable() {
      if(root_form.isSeqEditorVisible())
      {
         PageNode pgNode <= root_form.pg_node;
         NodeSeq seq <= pgNode.script_node;
         NodeSeqEditor seqEditor <= pgNode.editor;
         NSQ_Arranger arr <= seqEditor.arr;
         return arr.isEditable() && seq.b_rec;
      }
      return false;
   }

   // <method.png>
   protected method isNodeEditable() : boolean {
      return isTrackerEditable() || isSeqEditable();
   }

   // <method.png>
   protected method tryTrackerPatternClear(boolean _bWhenArmed) : boolean {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeTracker nt <= pgNode.script_node;
      NodeTrackerEditor ntEditor <= pgNode.editor;
      NT_PatternView pv <= ntEditor.pattern_view;
      UI.SetKeyboardFocus(pv);  // isEditable() required kbdfocus
      if( !_bWhenArmed || pv.isEditable() )
      {
         pv.patternClear();
         if(!replay.b_playing)
            pv.kjMoveCursorToStart();
         bHandled = true;
      }
      UI.SetKeyboardFocus(this);
      return bHandled;
   }

   // <method.png>
   protected method trySeqPatternClear(boolean _bWhenArmed) {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeSeq seq <= pgNode.script_node;
      NodeSeqEditor seqEditor <= pgNode.editor;
      NSQ_Arranger arr <= seqEditor.arr;
      UI.SetKeyboardFocus(arr);
      if(arr.isEditable() && (!_bWhenArmed || seq.b_rec))
      {
         arr.handleClearSelection(true/*bUndo*/);
         bHandled = true;
      }
      UI.SetKeyboardFocus(this);
      return bHandled;
   }

   protected method tryHandleNodeClear(boolean _bWhenArmed) : boolean {
      if(root_form.isTrackerEditorVisible())
      {
         if(tryTrackerPatternClear(_bWhenArmed))
            return true;
      }
      else if(root_form.isSeqEditorVisible())
      {
         if(trySeqPatternClear(_bWhenArmed))
            return true;
      }
      return false;
   }

   // <method.png>
   protected method tryTrackerUndoRedo(boolean _bRedo) : boolean {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeTracker nt <= pgNode.script_node;
      NodeTrackerEditor ntEditor <= pgNode.editor;
      NT_PatternView pv <= ntEditor.pattern_view;
      UI.SetKeyboardFocus(pv);  // isEditable() required kbdfocus
      if(pv.isEditable())
      {
         if(_bRedo)
            ntEditor.cmd_edit_redo();
         else
            ntEditor.cmd_edit_undo();
         bHandled = true;
      }
      UI.SetKeyboardFocus(this);
      return bHandled;
   }

   // <method.png>
   protected method trySeqUndoRedo(boolean _bRedo) {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeSeq seq <= pgNode.script_node;
      NodeSeqEditor seqEditor <= pgNode.editor;
      NSQ_Arranger arr <= seqEditor.arr;
      UI.SetKeyboardFocus(arr);
      if(arr.isEditable())
      {
         if(_bRedo)
            seqEditor.redo();
         else
            seqEditor.undo();
         bHandled = true;
      }
      UI.SetKeyboardFocus(this);
      return bHandled;
   }

   // <method.png>
   protected method tryHandleNodeUndoRedo(boolean _bRedo) : boolean {
      if(root_form.isTrackerEditorVisible())
      {
         if(tryTrackerUndoRedo(_bRedo))
            return true;
      }
      else if(root_form.isSeqEditorVisible())
      {
         if(trySeqUndoRedo(_bRedo))
            return true;
      }
      return false;
   }

   // <method.png>
   protected method trySeqSelectBlock() {
      boolean bHandled = false;
      PageNode pgNode <= root_form.pg_node;
      NodeSeq seq <= pgNode.script_node;
      NodeSeqEditor seqEditor <= pgNode.editor;
      NSQ_Arranger arr <= seqEditor.arr;
      UI.SetKeyboardFocus(arr);
      if(arr.isEditable())
      {
         arr.selectTrackOrAllOrNone();
         bHandled = true;
      }
      UI.SetKeyboardFocus(this);
      return bHandled;
   }

   // <ui_handle.png>
   protected method toggleRotation() {
      b_rot = !b_rot;
      loginfo "Rotation is "+Utils.GetEnableString(b_rot);
      if(!b_rot)
      {
         frot = 0.0f;
         frotspd = 0.0f;
         model_frot_damp_countdown = 0;
      }
      redraw();
   }

   // <ui_show.png>
   module method showContextMenu(boolean _bFocusFirst) {

      pm_context <= PopupMenu.New(this);
      PopupMenuButton *pmb;
      PopupMenu *spm;
      PopupMenu pm <= pm_context;
      int slotIdx;

      pmb <= pm.addDefaultButton("Show / Hide menu", "hide");
      pmb.setAccelerators(null, "lshift-a");

      // Undo
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Undo", deref spm);

      pmb <= spm.addDefaultButton("Undo", "undo");
      pmb.setAccelerators(null, "BACKSPACE");

      pmb <= spm.addDefaultButton("Redo", "redo");
      pmb.setAccelerators(null, "lctrl-BACKSPACE");

      pmb <= spm.addDefaultButton("Replace", "undo_replace");
      pmb.setAccelerators(null, "lalt-BACKSPACE");

      pmb <= spm.addDefaultButton("Clone", "undo_clone");
      pmb.setAccelerators(null, "lshift-INSERT");

      pmb <= spm.addDefaultButton("Delete", "undo_delete");
      pmb.setAccelerators(null, "lshift-DELETE");

      pmb <= spm.addDefaultButton("Move to previous step", "undo_movetoprev");
      pmb.setAccelerators(null, "lctrl-PAGEUP");

      pmb <= spm.addDefaultButton("Move to next step", "undo_movetonext");
      pmb.setAccelerators(null, "lctrl-PAGEDOWN");

      // Load undo slot
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Load..", deref spm);
      slotIdx = 0;
      loop(NUM_UNDO_IO_SLOTS)
      {
         pmb <= spm.addDefaultButton("Slot "+(slotIdx+1)+(isUndoSlotEmpty(slotIdx)?" <empty>":""), "load_"+slotIdx);
         pmb.setAccelerators(null, "KP"+(slotIdx+1));
         slotIdx++;
      }

      // Save undo slot
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Save..", deref spm);
      slotIdx = 0;
      loop(NUM_UNDO_IO_SLOTS)
      {
         pmb <= spm.addDefaultButton("Slot "+(slotIdx+1)+(isUndoSlotEmpty(slotIdx)?" <empty>":""), "save_"+slotIdx);
         pmb.setAccelerators(null, "lctrl-KP"+(slotIdx+1));
         slotIdx++;
      }

      // Cursor
      pm.addSeparator();
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Cursor", deref spm);

      pmb <= spm.addDefaultButton("Up", "cursor_up");
      pmb.setAccelerators(null, "UP");
      pmb.setActive(!isTrackerEditable());

      pmb <= spm.addDefaultButton("Down", "cursor_down");
      pmb.setAccelerators(null, "DOWN");
      pmb.setActive(!isTrackerEditable());

      pmb <= spm.addDefaultButton("Left", "cursor_left");
      pmb.setAccelerators(null, "LEFT");
      pmb.setActive(!isSeqEditable());

      pmb <= spm.addDefaultButton("Right", "cursor_right");
      pmb.setAccelerators(null, "RIGHT");
      pmb.setActive(!isSeqEditable());

      pmb <= spm.addDefaultButton("Find next mode", "cursor_mode");
      pmb.setToolTipCaption("Find next mode\n\n (note) depends on last played note");
      pmb.setAccelerators(null, "RETURN");

      pmb <= spm.addDefaultButton("Change root key", "cursor_root");
      pmb.setAccelerators(null, "lctrl-RETURN");

      // Transpose
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Transpose", deref spm);

      pmb <= spm.addDefaultButton("Octave down", "oct_down");
      pmb.setAccelerators(null, "F1");

      pmb <= spm.addDefaultButton("Octave up", "oct_up");
      pmb.setAccelerators(null, "F2");

      pmb <= spm.addDefaultButton("Semi down", "semi_down");
      pmb.setAccelerators(null, "DELETE");
      pmb.setActive(!isNodeEditable());

      pmb <= spm.addDefaultButton("Semi up", "semi_up");
      pmb.setAccelerators(null, "INSERT");

      // Mode
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Mode", deref spm);

      pmb <= spm.addDefaultButton("Previous", "mode_prev");
      pmb.setAccelerators(null, "END");

      pmb <= spm.addDefaultButton("Next", "mode_next");
      pmb.setAccelerators(null, "HOME");

      // Velocity
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Velocity", deref spm);

      pmb <= spm.addDefaultButton("Dec Velocity", "vel_down");
      pmb.setAccelerators(null, "F3");

      pmb <= spm.addDefaultButton("Inc Velocity", "vel_up");
      pmb.setAccelerators(null, "F4");

      // Row shift
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Row Shift", deref spm);

      pmb <= spm.addDefaultButton("Dec Row Shift", "row_down");
      pmb.setAccelerators(null, "F5");

      pmb <= spm.addDefaultButton("Inc Row Shift", "row_up");
      pmb.setAccelerators(null, "F6");

      pmb <= spm.addCheckButton("Shift up", b_row_shift_up, "row_shift_up");
      pmb.setAccelerators(null, "F7");

      // Chord
      spm <= PopupMenu.New(pm);
      pmb <= pm.addMenu("Chord", deref spm);

      pmb <= spm.addDefaultButton("-", "chord_off");
      pmb.setAccelerators(null, "1");

      pmb <= spm.addDefaultButton("Dyad", "chord_dyad");
      pmb.setAccelerators(null, "2");

      pmb <= spm.addDefaultButton("Triad", "chord_triad");
      pmb.setAccelerators(null, "3");

      pmb <= spm.addDefaultButton("Tetrad", "chord_tetrad");
      pmb.setAccelerators(null, "4");

      pmb <= spm.addDefaultButton("Ext5", "chord_ext5");
      pmb.setAccelerators(null, "5");

      pmb <= spm.addDefaultButton("Ext6", "chord_ext6");
      pmb.setAccelerators(null, "6");

      spm.addSeparator();
      pmb <= spm.addDefaultButton("Previous inversion", "chord_inv_prev");
      pmb.setAccelerators(null, ".");

      pmb <= spm.addDefaultButton("Next inversion", "chord_inv_next");
      pmb.setAccelerators("<", "/");

      // Node
      if(root_form.isTrackerEditorVisible() ||
         root_form.isSeqEditorVisible()
         )
      {
         pm.addSeparator();
         spm <= PopupMenu.New(pm);
         pmb <= pm.addMenu("Node", deref spm);

         if(root_form.isSeqEditorVisible())
         {
            pmb <= spm.addDefaultButton("Previous Bar", "node_seq_prev_bar");
            pmb.setAccelerators(null, "LEFT");
            pmb.setActive(isSeqEditable());

            pmb <= spm.addDefaultButton("Previous Bar (select)", "node_seq_prev_bar_select");
            pmb.setAccelerators(null, "LEFT");
            pmb.setActive(isSeqEditable());

            pmb <= spm.addDefaultButton("Next Bar", "node_seq_next_bar");
            pmb.setAccelerators(null, "RIGHT");
            pmb.setActive(isSeqEditable());

            pmb <= spm.addDefaultButton("Next Bar (select)", "node_seq_next_bar_select");
            pmb.setAccelerators(null, "lshift-RIGHT");
            pmb.setActive(isSeqEditable());
         }
         else if(root_form.isTrackerEditorVisible())
         {
            pmb <= spm.addDefaultButton("Previous Step", "node_tracker_prev_step");
            pmb.setAccelerators(null, "UP");
            pmb.setActive(isTrackerEditable());

            pmb <= spm.addDefaultButton("Next Step", "node_tracker_next_step");
            pmb.setAccelerators(null, "DOWN");
            pmb.setActive(isTrackerEditable());
         }

         pmb <= spm.addDefaultButton("(Re-)start recording", "node_restartrec");
         pmb.setAccelerators(null, "RSHIFT");

         pmb <= spm.addDefaultButton("Toggle edit mode", "node_toggleedit");
         pmb.setAccelerators(null, "RCTRL");

         pmb <= spm.addDefaultButton("Clear pattern", "node_clear");
         pmb.setAccelerators(null, "lshift-BACKSPACE");

         pmb <= spm.addDefaultButton("Clear pattern (when node is armed)", "node_clear_armed");
         pmb.setAccelerators(null, "DELETE");
         pmb.setActive(isNodeEditable());

         pmb <= spm.addDefaultButton("Undo", "node_undo");
         pmb.setAccelerators(null, "lctrl-y");

         pmb <= spm.addDefaultButton("Redo", "node_redo");
         pmb.setAccelerators(null, "lctrl-lshift-y");
      }

      // Miscellaneous
      pm.addSeparator();

      pmb <= pm.addDefaultButton("Replay note", "note_replay");
      pmb.setAccelerators(null, "lctrl-SPACE");

      pmb <= pm.addCheckButton("Note Auto-Play", b_queue_cursor_note, "note_auto_play");
      pmb.setAccelerators(null, "F11");

      pmb <= pm.addCheckButton("Rotate", b_rot, "rotate");
      pmb.setAccelerators(null, "F12");

      pmb <= pm.addCheckButton("Chords", b_allow_chord, "allow_chord");
      pmb.setToolTipCaption("Allow chords\n\n (note) must also select a chord mode (keys 1..6)");
      pmb.setAccelerators(null, "TAB");

      // Show
      pm.showAtXY(UI.GetMouseX(), UI.GetMouseY());

      if(_bFocusFirst)
         pm.focusNextMenuItem();
   }

   // <ui_mouse.png>
   public virtual onMouseClick(MouseEvent _ev) : boolean {
      if(_ev.isRightButton())
      {
         showContextMenu(false/*bFocusFirst*/);
         return true;
      }
      return false;
   }

   // <ui_kbd.png>
   public virtual wantKeyRepeat(Key _k) : boolean {
      return [VKEY_F3, VKEY_F4].contains(_k.code);
   }

   // <ui_kbd.png>
   public method onKey(Key _k) : boolean {
      log4 "KeyJazz:.onKey: k.pressed="+_k.pressed+" k.name="+_k.name;

      switch(_k.pressed)
      {
         case VKEY_F1:
            changeRootKeyOctave(-1);
            return true;

         case VKEY_F2:
            changeRootKeyOctave(1);
            return true;

         case VKEY_F3:
            changeVelocity(-4);
            return true;

         case VKEY_F4:
            changeVelocity(4);
            return true;

         case VKEY_F5:
            changeRowShift(-1);
            return true;

         case VKEY_F6:
            changeRowShift(1);
            return true;

         case VKEY_F7:
            toggleRowShiftUp();
            return true;

         case VKEY_RSHIFT:
            tryHandleNodeRestartRecording();
            break;

         case VKEY_RCTRL:
            tryHandleNodeToggleEdit();
            break;

         case VKEY_F12:
            toggleRotation();
            break;

         case '1':
            chordModeOff();
            return true;

         case '2':
            cycleChordMode(chord_modes_dyad);
            return true;

         case '3':
            cycleChordMode(chord_modes_triad);
            return true;

         case '4':
            cycleChordMode(chord_modes_tetrad);
            return true;

         case '5':
            cycleChordMode(chord_modes_ext5);
            return true;

         case '6':
            cycleChordMode(chord_modes_ext6);
            return true;

         case '[':  // de:ue
            return true;

         case ']':  // de:+
            return true;

         case VKEY_TAB:
            toggleAllowChord();
            return true;

         case VKEY_RETURN:
            if(_k.modAlt() || (VMOD_LMETA == _k.mod))
            {
               handleReplace();
            }
            else
            {
               setModeToCursorNoteIdx(!_k.modCtrl()/*bSetMode*/);
            }
            return true;

         case VKEY_BACKSPACE:
            if(_k.modCtrl())
            {
               handleRedo();
            }
            else if(_k.modAlt() || (VMOD_LMETA == _k.mod))
            {
               handleReplace();
            }
            else if(_k.modShift())
            {
               if(tryHandleNodeClear(false/*bWhenArmed*/))
                  return true;
            }
            else
            {
               handleUndo();
            }
            return true;

         case VKEY_INSERT:
            if(_k.modShift())
               undoInsert();
            else
               rootKeyUp();
            return true;

         case VKEY_DELETE:
            if(tryHandleNodeClear(true/*bWhenArmed*/))
               return true;
            if(_k.modShift())
               undoDelete();
            else
               rootKeyDown();
            return true;

         case VKEY_PAGEUP:
            if(_k.modCtrl())
               undoMoveToPrevious();
            else
               handleUndo();
            return true;

         case VKEY_PAGEDOWN:
            if(_k.modCtrl())
               undoMoveToNext();
            else
               handleRedo();
            return true;

         case VKEY_SPACE:
            if(_k.modAlt() || (VMOD_LMETA == _k.mod))
            {
               return false;
            }
            if(0 != _k.mod)
            {
               noteOnLastAbs();
            }
            else
            {
               if(replay.b_playing)
               {
                  root_form.handleToggleReplay(false/*bShift*/);
               }
               if(null != parent_dialog)
                  parent_dialog.hide();

               // noteOnCursor(); // (todo) find a different kbd shortcut for this
            }
            return true;

         case VKEY_LEFT:
            if(root_form.isSeqEditorVisible())
            {
               if(trySeqHandleKeyLeft(_k.modShift()))
                  return true;
            }
            handleCursorLeft();
            return true;

         case VKEY_RIGHT:
            if(root_form.isSeqEditorVisible())
            {
               if(trySeqHandleKeyRight(_k.modShift()))
                  return true;
            }
            handleCursorRight();
            return true;

         case VKEY_HOME:
            cycleMode(1);
            return true;

         case VKEY_END:
            cycleMode(-1);
            return true;

         case VKEY_UP:
            if(_k.modCtrl())
            {
            }
            else
            {
               if(root_form.isTrackerEditorVisible())
               {
                  if(tryTrackerHandleKeyUp(_k))
                     return true;
               }
               handleCursorUp();
            }
            return true;

         case VKEY_DOWN:
            if(_k.modCtrl())
            {
            }
            else
            {
               if(root_form.isTrackerEditorVisible())
               {
                  if(tryTrackerHandleKeyDown(_k))
                     return true;
               }
               handleCursorDown();
            }
            return true;

         case 'z':  // de:y
            if(_k.modCtrl())
            {
               if(tryHandleNodeUndoRedo(_k.modShift()/*bRedo*/))
                  return true;
            }
            noteOnSingleOrChord(0, -1);
            return true;

         case 'x':
            noteOnSingleOrChord(1, -1);
            return true;

         case 'c':
            noteOnSingleOrChord(2, -1);
            return true;

         case 'v':
            noteOnSingleOrChord(3, -1);
            return true;

         case 'b':
            noteOnSingleOrChord(4, -1);
            return true;

         case 'n':
            noteOnSingleOrChord(5, -1);
            return true;

         case 'm':
            noteOnSingleOrChord(6, -1);
            return true;

         case ',':
            noteOnSingleOrChord(7, -1);
            return true;

         case 'a':
            if(_k.modCtrl())
            {
               if(root_form.isSeqEditorVisible())
               {
                  if(trySeqSelectBlock())
                     return true;
               }
            }
            else if(_k.modShift())
            {
               showContextMenu(true/*bFocusFirst*/);
            }
            else
            {
               noteOnSingleOrChord(0, 0);
            }
            return true;

         case 's':
            noteOnSingleOrChord(1, 0);
            return true;

         case 'd':
            noteOnSingleOrChord(2, 0);
            return true;

         case 'f':
            noteOnSingleOrChord(3, 0);
            return true;

         case 'g':
            noteOnSingleOrChord(4, 0);
            return true;

         case 'h':
            noteOnSingleOrChord(5, 0);
            return true;

         case 'j':
            noteOnSingleOrChord(6, 0);
            return true;

         case 'k':
            noteOnSingleOrChord(7, 0);
            return true;

         case 'l':
            noteOnSingleOrChord(8, 0);
            return true;

         case 'q':
            noteOnSingleOrChord(0, 1);
            return true;

         case 'w':
            noteOnSingleOrChord(1, 1);
            return true;

         case 'e':
            noteOnSingleOrChord(2, 1);
            return true;

         case 'r':
            noteOnSingleOrChord(3, 1);
            return true;

         case 't':
            noteOnSingleOrChord(4, 1);
            return true;

         case 'y':
            if(_k.modCtrl())
            {
               if(root_form.isTrackerEditorVisible())
               {
                  if(tryTrackerUndoRedo(_k.modShift()/*bRedo*/))
                     return true;
               }
               else if(root_form.isSeqEditorVisible())
               {
                  if(trySeqUndoRedo(_k.modShift()/*bRedo*/))
                     return true;
               }
            }
            noteOnSingleOrChord(5, 1);
            return true;

         case 'u':
            noteOnSingleOrChord(6, 1);
            return true;

         case 'i':
            noteOnSingleOrChord(7, 1);
            return true;

         case 'o':
            noteOnSingleOrChord(8, 1);
            return true;

         case 'p':
            noteOnSingleOrChord(9, 1);
            return true;

         case VKEY_F11:
            toggleNoteAutoPlay();
            return true;

         case VKEY_PERIOD:
            cycleChordInversion(-1);
            return true;

         case VKEY_SLASH:  // de:-
         case VKEY_LESS:   // de:-
            cycleChordInversion(1);
            return true;

         case VKEY_KP_0:
         case VKEY_KP_PERIOD:
            loadDefaults();
            return true;

         case VKEY_KP1:
         case VKEY_KP2:
         case VKEY_KP3:
         case VKEY_KP4:
         case VKEY_KP5:
         case VKEY_KP6:
         case VKEY_KP7:
         case VKEY_KP8:
            if(_k.modCtrl())
               saveUndoByIndex(_k.pressed - VKEY_KP1);  // undo/[0..7].dat
            else if(0 == _k.mod)
               loadUndoByIndex(_k.pressed - VKEY_KP1);
            handleUndoIdxChanged();
            return true;
      }

      switch(_k.released)
      {
         case VKEY_KP0:
         case VKEY_LEFT:
         case VKEY_RIGHT:
         case VKEY_UP:
         case VKEY_DOWN:
         case VKEY_SPACE:
         case VKEY_F11:
         case VKEY_PAGEUP:
         case VKEY_PAGEDOWN:
         case VKEY_BACKSPACE:
         case VKEY_SLASH:
         case VKEY_TAB:
         case '[':  // de:ue
         case ']':  // de:+
         case '1':
         case '2':
         case '3':
         case '4':
         case '5':
         case '6':
            releasePendingNoteOffs();
            return true;

         case 'z':  // de:y
            if(_k.modNone())
            {
               noteOffSingleOrChord(0, -1);
            }
            return true;

         case 'x':
            noteOffSingleOrChord(1, -1);
            return true;

         case 'c':
            noteOffSingleOrChord(2, -1);
            return true;

         case 'v':
            noteOffSingleOrChord(3, -1);
            return true;

         case 'b':
            noteOffSingleOrChord(4, -1);
            return true;

         case 'n':
            noteOffSingleOrChord(5, -1);
            return true;

         case 'm':
            noteOffSingleOrChord(6, -1);
            return true;

         case ',':
            noteOffSingleOrChord(7, -1);
            return true;

         case 'a':
            noteOffSingleOrChord(0, 0);
            return true;

         case 's':
            noteOffSingleOrChord(1, 0);
            return true;

         case 'd':
            noteOffSingleOrChord(2, 0);
            return true;

         case 'f':
            noteOffSingleOrChord(3, 0);
            return true;

         case 'g':
            noteOffSingleOrChord(4, 0);
            return true;

         case 'h':
            noteOffSingleOrChord(5, 0);
            return true;

         case 'j':
            noteOffSingleOrChord(6, 0);
            return true;

         case 'k':
            noteOffSingleOrChord(7, 0);
            return true;

         case 'l':
            noteOffSingleOrChord(8, 0);
            return true;

         case 'q':
            noteOffSingleOrChord(0, 1);
            return true;

         case 'w':
            noteOffSingleOrChord(1, 1);
            return true;

         case 'e':
            noteOffSingleOrChord(2, 1);
            return true;

         case 'r':
            noteOffSingleOrChord(3, 1);
            return true;

         case 't':
            noteOffSingleOrChord(4, 1);
            return true;

         case 'y':
            if(_k.modNone())
            {
               noteOffSingleOrChord(5, 1);
            }
            return true;

         case 'u':
            noteOffSingleOrChord(6, 1);
            return true;

         case 'i':
            noteOffSingleOrChord(7, 1);
            return true;

         case 'o':
            noteOffSingleOrChord(8, 1);
            return true;

         case 'p':
            noteOffSingleOrChord(9, 1);
            return true;
      }
      return false;
   }

   protected method drawableAddRadialPanel(float _angCtr,
                                           float _angOff,
                                           float _angBorder,
                                           float _dMin,
                                           float _dMax
                                           ) {
      // polar to cartesian:
      //  x' = d * cos(a)
      //  y' = d * sin(a)

      float angMinL = (_angCtr - _angOff + (_angBorder * 1/*_dMax*/));
      float angMinR = (_angCtr + _angOff - (_angBorder * 1/*_dMax*/));
      float angMaxL = (_angCtr - _angOff + (_angBorder * 1/*_dMin*/));
      float angMaxR = (_angCtr + _angOff - (_angBorder * 1/*_dMin*/));

      float saMinL = sin(angMinL);
      float caMinL = cos(angMinL);
      float saMaxL = sin(angMaxL);
      float caMaxL = cos(angMaxL);
      float saMinR = sin(angMinR);
      float caMinR = cos(angMinR);
      float saMaxR = sin(angMaxR);
      float caMaxR = cos(angMaxR);

      float ltx = caMaxL * w * _dMax + x;
      float lty = saMaxL * h * _dMax + y;

      float rtx = caMaxR * w * _dMax + x;
      float rty = saMaxR * h * _dMax + y;

      float rbx = caMinR * w * _dMin + x;
      float rby = saMinR * h * _dMin + y;

      float lbx = caMinL * w * _dMin + x;
      float lby = saMinL * h * _dMin + y;

      int pid = minBeginPathConvex();
      minMoveTo(ltx, lty);
      minArcTo(w*_dMax,
               h*_dMax,
               0/*rot*/,
               0/*bLargeArc*/,
               1/*bArcSweep*/,
               rtx, rty
               );
      minLineTo(rbx, rby);
      minArcTo(w*_dMin,
               h*_dMin,
               0/*rot*/,
               0/*bLargeArc*/,
               0/*bArcSweep*/,
               lbx, lby
               );
      minEndPathClosed();
      if(1)
      {
         minFill();
         minDrawPath(pid);
      }

      minStrokeWidth(stroke_w);
      // minJoinMiter();
      minJoinBevel();
      minCapNone();
      minDrawPath(pid);
   }

   protected method drawableAddRadialPanels(float _dMin, float _dMax, float _angBorderAmt, float _lum, int _gridY) {

      float angStep = 2PI / 12;
      float angBorder = angStep * _angBorderAmt;
      float angOff = angStep*0.5;
      float ang = 0;

      int gridX = 0;
      loop(12)
      {
         float lum = (gridX == cursor_x && _gridY == cursor_y) ? _lum * 2.7 : _lum;
         if(-1 == findModeForGridPos(gridX, _gridY, null/*retNote*/, false/*bDebug*/))
            lum *= 0.7;

         int note = mathWrapi(root_key + ((gridX * 7) + getRelativeNoteOffset(1 == _gridY)), 0, 12);
         // if(gridX == cursor_x && _gridY == cursor_y)
         //    log2 "note="+note+" semi_tbl="+semi_tbl;
         if(-1 != semi_tbl.indexOf(note, 0))
            lum *= 1.5;

         int hlIdx = hl_notes.indexOf(note, 0);
         if(0 == _gridY)
            log4 "gridX="+gridX+" note="+note+"("+note_names.get(note)+" hl_notes="+hl_notes+" hl_notes_amt="+hl_notes_amt+" => hlIdx="+hlIdx;
         if(hlIdx >= 0)
            lum += 1.5 * hl_notes_amt[hlIdx];

         minColorFill(sdvg_ARGBf(1.0, r*lum, g*lum, b*lum));

         drawableAddRadialPanel(ang, angOff, angBorder,
                                _dMin, _dMax
                                );

         ang += angStep;
         gridX++;
      }
   }

   protected method createDrawable() {
      float lum;
      float angBorderAmt = 0.0375;
      drawable.begin();

      // log4 "cursor=("+cursor_x+","+cursor_y+")";

      lum = 1.1;
      minColorStroke(sdvg_ARGBf(1.0,r*lum,g*lum,b*lum));

      // Outer
      if(1)
      {
         lum = 4.0;
         if(cursor_y == 0) lum *= 1.05;
         drawableAddRadialPanels(dmin_outer, dmax_outer, angBorderAmt, lum, 0/*gridY*/);
      }

      // Inner
      if(1)
      {
         lum = 2.5;
         if(cursor_y == 1) lum *= 1.05;
         drawableAddRadialPanels(dmin_inner, dmax_inner, angBorderAmt, lum, 1/*gridY*/);
      }

      drawable.end();
      // log4 "drawable.getGLOffset()="+drawable.getGLOffset()+" getDrawOffset()="+drawable.getDrawOffset();

      drawable.setSize2f(VP_W, VP_H);
   }

   protected method drawLabels() {
      String *s;
      Float minX, maxX, minY, maxY;
      float w;
      float h;

      sdvg_SetAlphaSDFRange(0.51, 0.956);
      sdvg_SetAlphaSDFExp(1.4f);

      sdvg_ModelInitIdentity();

      sdvg_SetFillColor4f(1.0f, 1.0f, 1.0f, 1.0);
      sdvg_SetStrokeColor4f(1.0f, 1.0f, 1.0f, 1.0);

      sdvg_BindFont(font_30, false/*bFilter*/);
      sdvg_SetFontScaling(FONT_30_SCL_MED_X, FONT_30_SCL_MED_Y);

      // Key + Mode
      s <= note_names.get(mathWrapi(root_key, 0, 12))+" "+mode_names.get(mode);
      sdvg_DrawText(s, 4, 0);

      // Maj / min
      s <= mode_major_tbl.get(mode) ? "maj" : "min";
      sdvg_TextBBox(font_30, s, minX, maxX, minY, maxY);
      w = (maxX - minX);
      sdvg_DrawText(s, VP_W - w - 8, 0);

      // Root key
      if(0 == root_key)
         s <= "0";
      else if(root_key > 0)
         s <= "+"+root_key;
      else
         s <= String(root_key);
      sdvg_TextBBox(font_30, s, minX, maxX, minY, maxY);
      h = (maxY - minY);
      sdvg_DrawText(s, 4, VP_H - h - 16);

      // Inversion
      s <= getChordName()+" "+chord_inversion_names.get(chord_inversion);
      sdvg_TextBBox(font_30, s, minX, maxX, minY, maxY);
      w = (maxX - minX);
      sdvg_DrawText(s, VP_W - w - 8, VP_H - h - 16);

      // Rotated outer + inner labels
      if(1)
      {
         float angStep = 2PI / 12;

         float sx = VP_W;
         float sy = VP_H;

         float x;
         float y;
         int gridX = 0;
         int noteIdx = 0;
         float ang = model_rot;
         float scl;
         int note;
         int hlIdx;

         // Outer
         sdvg_BindFont(font_256_sdf, true/*bFilter*/);
         sdvg_SetFontScaling(FONT_256_SCL_BIG_X, FONT_256_SCL_BIG_Y);

         loop(12)
         {
            sdvg_ModelInitIdentity();
            sdvg_ModelTranslate2f(sx*0.5, sy*0.5);
            sdvg_ModelRotatef(ang);

            if(0 == cursor_y && gridX == cursor_x)
               sdvg_SetColorARGB(#FF000000);
            else
               sdvg_SetColorARGB(#FFe6e6e6);

            note = mathWrapi(root_key+noteIdx, 0, 12);
            hlIdx = hl_notes.indexOf(note, 0);
            // // if(hlIdx >=0 && 0 == note)
            // //    log4 "hl_notes_amt["+hlIdx+"]="+hl_notes_amt[hlIdx];
            scl = 1.0 + ((hlIdx >= 0) ? (0.25 * hl_notes_amt[hlIdx]) : 0.0f);
            sdvg_SetFontScaling(FONT_256_SCL_BIG_X*scl, FONT_256_SCL_BIG_Y*scl);

            s <= note_names.get(note);
            sdvg_TextBBox(font_256_sdf, s, minX, maxX, minY, maxY);
            w = (maxX - minX);
            h = (maxY - minY);
            x = -w*0.5;
            y = -0.5*sy * (dmax_outer+dmin_outer)*0.5 - h*0.6;
            sdvg_DrawText(s, x, y);

            // Next cel
            noteIdx += 7;
            ang += angStep;
            gridX++;
         }

         // Inner
         sdvg_SetFontScaling(FONT_256_SCL_MED_X, FONT_256_SCL_MED_Y);

         gridX = 0;
         noteIdx = 0;
         ang = model_rot;
         loop(12)
         {
            sdvg_ModelInitIdentity();
            sdvg_ModelTranslate2f(sx*0.5, sy*0.5);
            sdvg_ModelRotatef(ang);

            if(1 == cursor_y && gridX == cursor_x)
               sdvg_SetColorARGB(#FF000000);
            else
               sdvg_SetColorARGB(#7Fe6e6e6);

            s <= note_names.get( mathWrapi(root_key + noteIdx + getRelativeNoteOffset(true), 0, 12) );
            sdvg_TextBBox(font_256_sdf, s, minX, maxX, minY, maxY);
            w = (maxX - minX);
            h = (maxY - minY);
            x = -w*0.5;
            y = -0.5*sy * (dmax_inner+dmin_inner)*0.5 - h*0.6;
            sdvg_DrawText(s, x, y);

            // Next cel
            noteIdx += 7;
            ang += angStep;
            gridX++;
         }
      }

      sdvg_UnbindFont();
      sdvg_SetFontScaling(1.0, 1.0);
   }

   protected method loadFont(String _pathPrefix, ShaderVG_Font _font, Buffer _fontBin, Texture _fontTex) : boolean {
      local PakFile fBin;
      if(fBin.open(_pathPrefix+".bin"))
      {
         fBin.readBuffer(_fontBin, 0, fBin.size, true/*bResize*/);
         fBin.close();
         _fontBin.offset = _fontBin.size;

         if(_fontTex.loadImage(_pathPrefix+".png", 0,0,1))
         {
            if(sdvg_InitFont(_font, _fontBin, _fontTex, _fontTex.sx, _fontTex.sy))
            {
               log1 "KeyJazz::loadFont: OK, font \""+_pathPrefix+"\" loaded. tex.sz=("+_fontTex.sx+","+_fontTex.sy+")";
               return true;
            }
            else
            {
               logerror "KeyJazz::loadFont: sdvg_InitFont() failed\n";
            }
         }
         else
         {
            logerror "KeyJazz::loadFont: failed to load font-texture from \""+_pathPrefix+".png\"";
         }
      }
      else
      {
         logerror "KeyJazz::loadFont: failed to load font-data from \""+_pathPrefix+".bin\"";
      }
      return false;
   }

   public method draw(float _dt) {

      sdvg_SetStrokeWidth(1.0f);
      sdvg_SetFillColor4f(0.1f, 0.4f, 0.25f, 1.0f);
      sdvg_SetStrokeColor4f(1.0f, 1.0f, 1.0f, 1.0f);
      sdvg_SetGlobalAlpha(1.0f);
      sdvg_PaintSolid();

      sdvg_ModelInitIdentity();
      sdvg_SetColorARGB(#FFe6e6e6);

      // log4 "KeyJazz::draw: getSizeX()="+getSizeX()+" getSizeY()="+getSizeY();

      UIRenderer.DrawFilledRectangle(0, 0, getSizeX(), getSizeY(),
                                     sdvg_ARGBf(1.0, r, g, b)
                                     );
      createDrawable();

      model_rot = sin(frot) * PI * 0.25 * 0.5;

      if(1)
      {
         drawable.setScale2f(1.0f, 1.0f);
         drawable.setRotation(model_rot - PI*0.5);
         drawable.setTranslate2f(0, 0);
         MinnieVG.SetTransformForDrawable(drawable);
         drawable.draw();
         sdvg_UnbindVBO();
      }

      drawLabels();

      if(b_queued_noteon_cursor)
      {
         b_queued_noteon_cursor = false;
         noteOnCursor();
      }

      if(model_frot_damp_countdown > 0)
      {
         model_frot_damp_countdown--;
         frot *= mathPowerf(0.91, _dt);
         frotspd *= mathPowerf(0.91, _dt);
      }
      else
      {
         if(frotspd < (1 * (1.0 / 360)))
            frotspd += 0.000005 * _dt;
         else
            frotspd = (1 * (1.0 / 360));
      }

      highlightNotesDecay(_dt);

      if(b_rot)
      {
         frot = mathWrapf(frot + _dt * frotspd, 0, 2PI);
      }

      sdvg_SetStrokeWidth(1.0f);
   }

   public virtual is3d() : boolean {
      return true;
   }

   public virtual onOpen() {
      log3 "KeyJazz::onOpen() b_fonts_loaded="+b_fonts_loaded;
      if(b_fonts_loaded)
      {
         sdvg_FontOnOpen(font_30);
         sdvg_FontOnOpen(font_256_sdf);
      }
   }

   public virtual onDraw() {
      log4 "KeyJazz::onDraw: .................................................";

      if(!b_fonts_loaded)
      {
         b_fonts_loaded = 1
            && loadFont("fonts/default_30", font_30, font_30_bin, font_30_tex)
            && loadFont("fonts/default_256_sdf", font_256_sdf, font_256_sdf_bin, font_256_sdf_tex)
            ;
         onOpen();
      }

      sdvg_PaintSolid();
      sdvg_EnableBlendingKeepAlpha();
      sdvg_ProjInit2D(getSizeX(), getSizeY());

      if(1)
      {
         draw(1.0);
         if(b_rot)
            redraw();
      }
      else
      {
         sdvg_SetColorARGB(#FF007F7F);

         if(sdvg_BeginLines(2))
         {
            sdvg_Vertex2f(0,0);
            sdvg_Vertex2f(100,100);
            sdvg_End();
         }

         if(1)
         {
            sdvg_BindFont(font_30, false/*bFilter*/);
            sdvg_DrawText("hello, world.", 100, 100);
            sdvg_UnbindFont();
         }
         else
         {
            sdvg_BindFont(font_30, false/*bFilter*/);
            sdvg_SetColor4f(1.0f, 1.0f, 1.0f, 1.0f);
            float w = 1024;
            float h = 180;
            float x = 40;
            float y = 40;
            sdvg_BindShader(0);  // use built-in shader
            if(sdvg_BeginTexturedTriangles(2*3))
            {
               // 1
               sdvg_TexCoord2f(0.0f, 0.0f);
               sdvg_Vertex2f(x, y);

               sdvg_TexCoord2f(1.0f, 0.0f);
               sdvg_Vertex2f(x+w, y);

               sdvg_TexCoord2f(1.0f, 1.0f);
               sdvg_Vertex2f(x+w, y+h);

               // 2
               sdvg_TexCoord2f(0.0f, 0.0f);
               sdvg_Vertex2f(x, y);

               sdvg_TexCoord2f(1.0f, 1.0f);
               sdvg_Vertex2f(x+w, y+h);

               sdvg_TexCoord2f(0.0f, 1.0f);
               sdvg_Vertex2f(x, y+h);

               sdvg_End();
            }
            sdvg_UnbindTexture2D();
         }

      }

      log4 "KeyJazz::onDraw: LEAVE";
   }

   // <save.png>
   public method saveState(Stream ofs) {
      ofs.i8 = 2; // ver
      ofs.i8 = undo_io_slots.numElements;

      int slotIdx = 0;
      Buffer *b;
      foreach b in undo_io_slots
      {
         // Row shift (v2+)
         ofs.i8 = slot_row_shift.get(slotIdx);

         // Row shift up (v2+)
         ofs.i8 = slot_shift_up.get(slotIdx);

         ofs.i32 = b.size;
         if(b.size > 0)
         {
            ofs.writeBuffer(b, 0, b.size);
         }

         // Next I/O slot
         slotIdx++;
      }
   }

   // <load.png>
   public method loadState(Stream ifs) : boolean {
      byte ver = ifs.u8;
      if(ver >= 1)
      {
         byte numSlots = ifs.u8;
         loop(mathMaxi(numSlots, NUM_UNDO_IO_SLOTS))
            undo_io_slots.add(#(new Buffer));

         int slotIdx = 0;
         loop(numSlots)
         {
            if(ver >= 2)
            {
               // Row shift (v2+)
               slot_row_shift[slotIdx] = ifs.i8;

               // Row shift up (v2+)
               slot_shift_up[slotIdx] = ifs.b8;
            }

            Buffer b <= undo_io_slots.get(slotIdx);
            int bSz = ifs.i32;
            if(bSz > 0)
            {
               ifs.readBuffer(b, 0, bSz, true/*bResize*/);
            }

            // Next I/O slot
            slotIdx++;
         }

         // Succeeded
         return true;
      }
      else
      {
         logerror "invalid KeyJazz ver="+ver;
      }
      return false;
   }

   // <ui_consume.png>
   public virtual consumeAction(Action _action) : boolean {
      ActionProvider ap <= _action.getActionProvider();
      String acName <= _action.getActionName();
      Key k;

      switch(@(ap))
      {
         case @(pm_context):
            if(PopupMenu.IsFocusAction(_action))
               return true;

            if(acName <= "load_")
            {
               loadUndoByIndex(acName.replace("load_",""));
               return true;
            }

            if(acName <= "save_")
            {
               saveUndoByIndex(acName.replace("save_",""));
               return true;
            }

            switch(acName)
            {
               case PopupMenu.ACTION_CANCEL:
               case "":
                  UI.SetKeyboardFocus(this);
                  return true;

                  // Undo
               case "undo":
                  handleUndo();
                  return true;

               case "redo":
                  handleRedo();
                  return true;

               case "undo_replace":
                  handleReplace();
                  return true;

               case "undo_clone":
                  undoInsert();
                  return true;

               case "undo_delete":
                  undoDelete();
                  return true;

               case "undo_movetoprev":
                  undoMoveToPrevious();
                  return true;

               case "undo_movetonext":
                  undoMoveToNext();
                  return true;

                  // Cursor
               case "cursor_up":
                  handleCursorUp();
                  return true;

               case "cursor_down":
                  handleCursorDown();
                  return true;

               case "cursor_left":
                  handleCursorLeft();
                  return true;

               case "cursor_right":
                  handleCursorRight();
                  return true;

               case "cursor_mode":
                  setModeToCursorNoteIdx(true/*bSetMode*/);
                  return true;

               case "cursor_root":
                  setModeToCursorNoteIdx(false/*bSetMode*/);
                  return true;

                  // Transpose
               case "oct_down":
                  changeRootKeyOctave(-1);
                  return true;

               case "oct_up":
                  changeRootKeyOctave(1);
                  return true;

               case "semi_down":
                  rootKeyDown();
                  return true;

               case "semi_up":
                  rootKeyUp();
                  return true;

                  // Mode
               case "mode_prev":
                  cycleMode(-1);
                  return true;

               case "mode_next":
                  cycleMode(1);
                  return true;

                  // Velocity
               case "vel_down":
                  changeVelocity(-4);
                  return true;

               case "vel_up":
                  changeVelocity(4);
                  return true;

                  // Row shift
               case "row_down":
                  changeRowShift(-1);
                  return true;

               case "row_up":
                  changeRowShift(1);
                  return true;

               case "row_shift_up":
                  toggleRowShiftUp();
                  return true;

                  // Chord
               case "chord_off":
                  chordModeOff();
                  return true;

               case "chord_dyad":
                  cycleChordMode(chord_modes_dyad);
                  return true;

               case "chord_triad":
                  cycleChordMode(chord_modes_triad);
                  return true;

               case "chord_tetrad":
                  cycleChordMode(chord_modes_tetrad);
                  return true;

               case "chord_ext5":
                  cycleChordMode(chord_modes_ext5);
                  return true;

               case "chord_ext6":
                  cycleChordMode(chord_modes_ext6);
                  return true;

               case "chord_inv_prev":
                  cycleChordInversion(-1);
                  return true;

               case "chord_inv_next":
                  cycleChordInversion(1);
                  return true;

                  // Node
               case "node_restartrec":
                  tryHandleNodeRestartRecording();
                  return true;

               case "node_toggleedit":
                  tryHandleNodeToggleEdit();
                  return true;

               case "node_clear":
                  tryHandleNodeClear(false/*bWhenArmed*/);
                  return true;

               case "node_clear_armed":
                  tryHandleNodeClear(true/*bWhenArmed*/);
                  return true;

               case "node_seq_prev_bar":
                  if(root_form.isSeqEditorVisible())
                  {
                     if(trySeqHandleKeyLeft(false/*bShift*/))
                        return true;
                  }
                  return true;

               case "node_seq_prev_bar_select":
                  if(root_form.isSeqEditorVisible())
                  {
                     if(trySeqHandleKeyLeft(true/*bShift*/))
                        return true;
                  }
                  return true;

               case "node_seq_next_bar":
                  if(root_form.isSeqEditorVisible())
                  {
                     if(trySeqHandleKeyRight(false/*bShift*/))
                        return true;
                  }
                  return true;

               case "node_seq_next_bar_select":
                  if(root_form.isSeqEditorVisible())
                  {
                     if(trySeqHandleKeyRight(true/*bShift*/))
                        return true;
                  }
                  return true;

               case "node_tracker_prev_step":
                  if(root_form.isTrackerEditorVisible())
                  {
                     k.pressed = VKEY_UP;
                     if(tryTrackerHandleKeyUp(k))
                        return true;
                  }
                  return true;

               case "node_tracker_next_step":
                  if(root_form.isTrackerEditorVisible())
                  {
                     k.pressed = VKEY_DOWN;
                     if(tryTrackerHandleKeyDown(k))
                        return true;
                  }
                  return true;

               case "node_undo":
                  tryHandleNodeUndoRedo(false/*bRedo*/);
                  return true;

               case "node_redo":
                  tryHandleNodeUndoRedo(true/*bRedo*/);
                  return true;

                  // Root / Miscellaneous
               case "note_replay":
                  noteOnLastAbs();
                  TKS.sleep(20);
                  releasePendingNoteOffs();
                  return true;

               case "note_auto_play":
                  toggleNoteAutoPlay();
                  return true;

               case "rotate":
                  toggleRotation();
                  return true;

               case "allow_chord":
                  toggleAllowChord();
                  return true;
            }
            return true;
      }

      return Layer::consumeAction(_action);
   }

}
