module MNA_ClipCtlDialog;

use namespace ui;
use namespace st2;


// <class.png>
class NA_ClipCtlDialog extends Dialog, KeyboardFocusListener {
   protected NodeArrangerEditor *parent_editor;
   protected NodeArranger       *parent_arranger;
   protected NA_TimelineData    *parent_data;
   protected NA_State           *parent_tstate;
   protected NA_Clip            *clip;

   XMLForm xfm;

   // (note) actual target depends on node type
   //         - MARKER: n/a
   //         -  AUDIO: mw/bc/fc/ex/gp?
   //         -    SEQ: tracker: inject CTL_USR1..8
   protected Button     *bt_default;
   protected Button     *bt_ctl_mw;
   protected FloatParam *fp_ctl_mw;
   protected Button     *bt_ctl_bc;
   protected FloatParam *fp_ctl_bc;
   protected Button     *bt_ctl_fc;
   protected FloatParam *fp_ctl_fc;
   protected Button     *bt_ctl_ex;
   protected FloatParam *fp_ctl_ex;
   protected Button     *bt_ctl_gp1;
   protected FloatParam *fp_ctl_gp1;
   protected Button     *bt_ctl_gp2;
   protected FloatParam *fp_ctl_gp2;
   protected Button     *bt_ctl_gp3;
   protected FloatParam *fp_ctl_gp3;
   protected Button     *bt_ctl_gp4;
   protected FloatParam *fp_ctl_gp4;
   protected FloatParam *fp_tmp;

   protected PointerArray a_buttons;
   protected PointerArray a_floatparams;

   protected int def_ctl_idx;  // NA_Clip.INITCTL_xxx
   protected int clip_edit_mode_restore;

   protected StringArray *a_ctl_names_long;
   protected StringArray *a_ctl_names_short;


   // <ui_init.png>
   public method init() : boolean {

      initDialog();

      xfm <= XMLForm.New_PakFile("NA_ClipCtlDialog.xfm");
      if(null == xfm)
         return false;

      xfm.autoResolveIds(this);

      a_buttons.add(bt_ctl_mw);
      a_buttons.add(bt_ctl_bc);
      a_buttons.add(bt_ctl_fc);
      a_buttons.add(bt_ctl_ex);
      a_buttons.add(bt_ctl_gp1);
      a_buttons.add(bt_ctl_gp2);
      a_buttons.add(bt_ctl_gp3);
      a_buttons.add(bt_ctl_gp4);

      a_floatparams.add(fp_ctl_mw);
      a_floatparams.add(fp_ctl_bc);
      a_floatparams.add(fp_ctl_fc);
      a_floatparams.add(fp_ctl_ex);
      a_floatparams.add(fp_ctl_gp1);
      a_floatparams.add(fp_ctl_gp2);
      a_floatparams.add(fp_ctl_gp3);
      a_floatparams.add(fp_ctl_gp4);

      Button *bt;
      foreach bt in a_buttons
         bt.setForegroundColor(lnf_colors.get(LookAndFeel.COLOR_LABEL_CAPTION_FG));

      fp_tmp.setMinMaxValues(-1, 127);
      fp_tmp.setPrecision(3);
      fp_tmp.setNegativeText("-");

      initWindow(xfm,
                 "Clip Ctl",
                 100, 100,
                 180*UI.font_scaling, 100
                 );

      return true;
   }

   // <method_get.png>
   public virtual isPopup() : boolean {
      return true;
   }

   // <method_get.png>
   public virtual isModal():boolean {
      return true;
   }

   // <method_get.png>
   public virtual isResizable() : boolean {
      return false;
   }

   // <ui_show.png>
   public method showClipCtlDialog(NodeArrangerEditor _editor,
                                   NA_Clip            _clip,
                                   int                _ctlIdx,
                                   StringArray        _aCtlNamesLong,
                                   StringArray        _aCtlNamesShort
                                   ) {
      parent_editor     <= _editor;
      parent_arranger   <= _editor.arranger;
      parent_data       <= _editor.timeline.data;
      parent_tstate     <=  parent_data.tstate;
      clip              <= _clip;
      def_ctl_idx        = _ctlIdx;
      a_ctl_names_short <= _aCtlNamesShort;
      a_ctl_names_long  <= _aCtlNamesLong;

      clip_edit_mode_restore = parent_tstate.clip_edit_mode;
      parent_tstate.clip_edit_mode = _ctlIdx + 1;

      updateLabels();
      updateFloatParams();

      showNearMouse(-10*UI.font_scaling, -10*UI.font_scaling);

      UI.SetKeyboardFocusListener(this);
   }

   // <ui_update.png>
   protected method updateLabels() {
      int ctlIdx = 0;
      loop(NA_Clip.NUM_INITCTL/*8*/)
      {
         Button bt <= a_buttons.get(ctlIdx);
         bt.setCaption(a_ctl_names_short.get(ctlIdx));
         ctlIdx++;
      }
   }

   // <ui_update.png>
   protected method updateFloatParams() {
      int ctlIdx = 0;
      loop(NA_Clip.NUM_INITCTL/*8*/)
      {
         FloatParam fp <= a_floatparams.get(ctlIdx);
         fp.setValue(clip.getInitCtl(ctlIdx));
         ctlIdx++;
      }
   }

   // <ui_show.png>
   public virtual postShow() {

      Dialog::postShow();

      resizeToMinimum();
      validateClippedPosition();

      refocusDefault();

      FloatParam fp <= UI.GetKeyboardFocus();
      if(fp instanceof FloatParam)
         fp.onTabFocus();
   }

   // <ui_hide.png>
   public virtual hide() {
      UI.SetKeyboardFocusListener(null);
      Dialog::hide();
      parent_tstate.clip_edit_mode = clip_edit_mode_restore;
      parent_editor.redraw();
   }

   // <ui_kbd.png>
   protected method focusFloatParamByIdx(int _idx) {
      FloatParam fp <= a_floatparams.get(_idx);
      if(null != fp)
      {
         UI.SetKeyboardFocus(fp);
         fp.onTabFocus();
      }
   }

   // <ui_kbd.png>
   protected method refocusDefault() {
      focusFloatParamByIdx(def_ctl_idx);
   }

   // <ui_kbd.png>
   public virtual addTabCycleOverrides(PointerArray layers) {
      layers.joinRR(layers,
                    [
                       bt_default,
                       fp_ctl_mw,
                       fp_ctl_bc,
                       fp_ctl_fc,
                       fp_ctl_ex,
                       fp_ctl_gp1,
                       fp_ctl_gp2,
                       fp_ctl_gp3,
                       fp_ctl_gp4,
                     ]
                    );
   }

   // <method.png>
   protected method toggleCtlDecHex(FloatParam _fp) {
      _fp.toggleHexAction();
      _fp.setMousePrecision((FloatParam.DISPLAY_HEX == _fp.getDisplayType()) ? 0 : 3);
   }

   // <ui_handle.png>
   protected =replay= method handleCtlChanged(String _id, int _ctlIdx, float _value) {
      String msgPrefix <= "Init Ctl ";
      clip.setInitCtl(_ctlIdx, _value);
      parent_editor.redraw();
      loginfo msgPrefix+" \""+_id+"\" is "+((_value >= 0.0f) ? _value : "<unassigned>");
      parent_editor.redraw();
   }

   // <method_get.png>
   public method getInitCtlString(NA_Clip _clip, int _ctlIdx) : String {
      FloatParam fp <= a_floatparams.get(_ctlIdx);
      fp_tmp.setDisplayType(fp.getDisplayType());
      fp_tmp.setValue(_clip.getInitCtl(_ctlIdx));
      return fp_tmp.getDisplayedText();
   }

   // <method_find.png>
   protected method findFocusIdx(Layer _l) {
      int focusIdx = a_floatparams.indexOfPointer(_l, 0);
      if(focusIdx < 0)
         focusIdx = a_buttons.indexOfPointer(_l, 0);
      return focusIdx;
   }

   // <ui_handle.png>
   protected cycleClipEditMode(int _delta) {
      NA_State tstate <= parent_editor.timeline.tstate;
      int focusIdx = findFocusIdx(UI.GetKeyboardFocus());
      Layer *l;
      if(_delta > 0)
      {
         if(focusIdx + 1 < NA_Clip.NUM_INITCTL)
         {
            def_ctl_idx = focusIdx + 1;
            parent_tstate.clip_edit_mode = def_ctl_idx + 1;
            l <= a_floatparams.get(def_ctl_idx);
            UI.SetKeyboardFocus(l);
            l.onTabFocus();
         }
      }
      else if(_delta < 0)
      {
         if(focusIdx > 0)
         {
            def_ctl_idx = focusIdx - 1;
            parent_tstate.clip_edit_mode = def_ctl_idx - 1;
            l <= (focusIdx >= 0) ? a_floatparams.get(def_ctl_idx) : bt_default;
            UI.SetKeyboardFocus(l);
         }
         else
         {
            parent_tstate.clip_edit_mode = NA_State.CLIP_EDIT_MODE_DEFAULT;
            l <= bt_default;
         }
         UI.SetKeyboardFocus(l);
         l.onTabFocus();
      }
      // (note) "Clip edit mode is .." message is printed by handleKeyboardFocusChanged()
   }

   // <ui_kbd.png>
   public virtual handleKeyboardFocusChanged(Layer _newKeyboardLayer) {
      // KeyboardFocusListener
      if(null != _newKeyboardLayer)
      {
         boolean bChanged = false;
         int focusIdx = findFocusIdx(_newKeyboardLayer);
         if(focusIdx >= 0)
         {
            def_ctl_idx = focusIdx;
            parent_tstate.clip_edit_mode = focusIdx + 1;
            bChanged = true;
         }
         else if(@(_newKeyboardLayer) == @(bt_default))
         {
            parent_tstate.clip_edit_mode = NA_State.CLIP_EDIT_MODE_DEFAULT;
            def_ctl_idx = -1;
            bChanged = true;
         }
         if(bChanged)
         {
            loginfo "Clip edit mode is \'"+parent_data.getGridCursorTrackClipEditModeName(false/*bShort*/)+"\'";
            parent_editor.redraw();
         }
      }
   }

   // <method.png>
   protected method handleClear() {
      parent_tstate.undoAdd(parent_data.clip_selection);
      clip.clearInitCtls();
      updateFloatParams();
      parent_tstate.undoEnd(parent_data.clip_selection);
      loginfo "Clear clip ctls";
      parent_editor.redraw();
   }

   // <method.png>
   protected method selectPreviousClip() {
      boolean bEdge = parent_tstate.b_edge_selection_mode;
      int focusIdx = mathMaxi(0, findFocusIdx(UI.GetKeyboardFocus()));
      parent_tstate.b_edge_selection_mode = false;

      hide();
      parent_data.selectClipLeft(false/*bAdd*/, false/*bAllTracks*/);
      local Key k; k.pressed = VKEY_SLASH;
      parent_data.editFirstSelectedClipCtl(true/*bWarpMouse*/, k);
      focusFloatParamByIdx(focusIdx);

      parent_tstate.b_edge_selection_mode = bEdge;
   }

   // <method.png>
   protected method selectNextClip() {
      boolean bEdge = parent_tstate.b_edge_selection_mode;
      int focusIdx = mathMaxi(0, findFocusIdx(UI.GetKeyboardFocus()));
      parent_tstate.b_edge_selection_mode = false;

      hide();
      parent_data.selectClipRight(false/*bAdd*/, false/*bAllTracks*/);
      local Key k; k.pressed = VKEY_SLASH;
      parent_data.editFirstSelectedClipCtl(true/*bWarpMouse*/, k);
      focusFloatParamByIdx(focusIdx);

      parent_tstate.b_edge_selection_mode = bEdge;
   }

   // <ui_kbd.png>
   public virtual onKey(Key _k) : boolean {
      // log2 "NA_ClipCtlDialog: k.name="+_k.name+" pressed="+_k.pressed;
      switch(_k.pressed)
      {
         case VKEY_ESCAPE:
            hide();
            return true;

         case VKEY_BACKSPACE:
         case VKEY_DELETE:
            handleClear();
            return true;

         case VKEY_PAGEUP:
            cycleClipEditMode(-1);
            return true;

         case VKEY_PAGEDOWN:
            cycleClipEditMode(1);
            return true;

         case VKEY_LEFT:
            if(_k.modCtrlOnly())
            {
               selectPreviousClip();
               return true;
            }
            break;

         case VKEY_RIGHT:
            if(_k.modCtrlOnly())
            {
               selectNextClip();
               return true;
            }
            break;

         case 'a':
         case 'q':
         case 's':
            selectPreviousClip();
            break;

         case 'w':
         case 'd':
            selectNextClip();
            break;
      }

      return false;
   }

   // <ui_consume.png>
   public virtual consumeAction(Action _ac) : boolean {
      local String acName = _ac.getActionName();
      ActionProvider ap <= _ac.getActionProvider();
      // log4 "NA_ClipCtlDialog::consumeAction: acName=\""+acName+"\"";

      int focusIdx = findFocusIdx(ap);
      if(focusIdx >= 0)
      {
         if(ap instanceof Button)
         {
            toggleCtlDecHex(a_floatparams.get(focusIdx));
            return true;
         }
         else if(ap instanceof FloatParam)
         {
            FloatParam fp <= ap;
            handleCtlChanged(a_ctl_names_long.get(focusIdx),
                             focusIdx/*ctlIdx*/,
                             fp.getFloatValue()
                             );
            if(FloatParam.ACTION_VALUEENTERED == acName)
               hide();
            return true;
         }
      }

      return Dialog::consumeAction(_ac);
   }

}
