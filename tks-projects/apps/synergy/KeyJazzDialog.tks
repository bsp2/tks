module MKeyJazzDialog;

use namespace ui;
use namespace st2;


// <class.png>
class KeyJazzDialog extends Dialog, RemoteEventListener {

   // <ui_init.png>
   public method init() : boolean {

      initDialog();

      initWindow(keyjazz,
                 "KeyJazz",
                 (root_form.getSizeX()-600)*0.5,
                 (root_form.getSizeY()-600)*0.5,
                 600, 600
                 );

      return true;
   }

   // <ui_show.png>
   public method showKeyJazzDialog() {
      loginfo "Show KeyJazz Dialog";
   }

   // <method_get.png>
   public virtual isPopup() : boolean {
      return true;
   }

   // <method_get.png>
   public virtual isModal():boolean {
      return true;
   }

   // <method_get.png>
   public virtual isResizable() : boolean {
      return false;
   }

   // <ui_show.png>
   protected virtual preShow() {
      keyjazz.parent_dialog <= this;
      resizeToMinimum();
      Dialog::preShow();
   }

   // <ui_show.png>
   protected virtual postShow() {
      Dialog::postShow();
      refocusDefault();
   }

   // <ui_kbd.png>
   protected method refocusDefault() {
      UI.SetKeyboardFocus(keyjazz);
   }

   // <ui_hide.png>
   public virtual hide() {
      Dialog::hide();
      keyjazz.parent_dialog <= null;
   }

   // <ui_kbd.png>
   public virtual onBeginTriadKeyMode() : boolean {
      loginfo "lctrl-x - ";
      return true;
   }

   // <ui_kbd.png>
   public virtual onTriadKey(Key _k) : boolean {
      if(VKEY_BACKSPACE == _k.pressed)
      {
         hide();
         return true;
      }
      return false;
   }

   // <ui_kbd.png>
   public virtual onTriadKeyTimeout() {
      Dialogs.ShowTriadKeyHelpDialog("lctrl-x ..",
"
          BACKSPACE :   Hide dialog
"
                                    ,
                                    this);
      return true;
   }

   // // <ui_kbd.png>
   // public virtual addTabCycleOverrides(PointerArray layers) {
   //    layers.joinRR(layers,
   //                  [
   //                     fp_forced,
   //                     fp_min,
   //                     fp_amount,
   //                     cb_wrap,

   //                     bt_apply_close,
   //                     bt_apply,
   //                     bt_revert,
   //                     bt_close,
   //                   ]
   //                  );

   //    return layers;
   // }

   // <ui_kbd.png>
   public virtual onKey(Key _k) : boolean {
      // log4 "KeyJazzDialog::onKey: pressed="+_k.pressed+" name="+_k.name;
      switch(_k.pressed)
      {
         default:
            break;

         case VKEY_ESCAPE:
            hide();
            return true;

         case VKEY_BACKSPACE:
            if(_k.modAlt())
            {
               hide();
               return true;
            }
            break;
      }
      return false;
   }

   // <ui_consume.png>
   public virtual consumeAction(Action _ac) : boolean {
      String acName = _ac.getActionName();

      switch(@(_ac.getActionProvider()))
      {
      }

      return true;
   }

}
