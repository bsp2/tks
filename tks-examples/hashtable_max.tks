
HashTable ht;  // (note) default capacity = 52 elements (+1 empty)
int i = 0;
loop(53)
{
   ht[String(i)] = i;  // (note) first entry lazy-allocs default capacity
   i++;
}
trace "ht.numElements="+ht.numElements+" ht.maxElements="+ht.maxElements;
trace ht.reparsableString;

Buffer b; b.size = 1024;
b << ht;
HashTable ht2; ht2.alloc(1024);
b.offset = 0;
ht2 << b;  // deserialization changes capacity from 1024 to 53
trace "ht2.numElements="+ht2.numElements+" ht2.maxElements="+ht2.maxElements;
trace ht2.reparsableString;
