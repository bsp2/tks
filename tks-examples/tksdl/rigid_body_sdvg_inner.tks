// 19Jul2026, 23Jul2026
//
// (note) initially generated by gemma4:31b LLM ("C" / SDL2 / OpenGL 4.1 core) (31m 17s)
// (note) refactored (OOP) and ported to TKS (~45m)
//          (+ another hour to realize I forgot glEnableVertexAttribArray() - d'oh!)
//          (also added some tweaks)
// (note) 23Jul2026: replace GL by Minnie / ShaderVG API
//                   add nested 'inner world' bodies

putenv("TKSDL_GLERROR=1");
putenv("TKSDL_GLCORE=1");

use tksdl;
use tkmath;
use tkopengl;
use tkminnie;

World world;

int numframesrendered;
boolean b_all_at_rest;
int all_at_rest_count;  // auto-re-randomize after 7 sec
int scene_frame_count;  // since world.init() (max=30sec)

float cur_world_width;
float cur_world_height;

// ---------------------------------------------------------------------------- Body
class Body {
   Vector2f position;
   Vector2f velocity;
   Vector2f force;

   float orientation;
   float angular_velocity;
   float torque;

   float mass;
   float inv_mass;
   float inertia;
   float inv_inertia;

   float radius;

   float r, g, b;
   boolean b_red;

   public method init(float _px, float _py,
                      float _mass,
                      float _radius,
                      float _velX, float _velY
                      ) {
      position.init(_px, _py);
      mass = _mass;
      radius = _radius;

      inv_mass = (mass > 0) ? 1.0f / mass : 0;

      // For a circle: I = 0.5 * m * r^2
      inertia = 0.5f * mass * radius * radius;
      inv_inertia = (inertia > 0) ? 1.0f / inertia : 0;

      velocity.init(_velX, _velY);
   }

   public method integrate(float _dt) {
      if(0.0f == inv_mass)
         return; // Static body

      // Semi-implicit Euler: v = v + a*dt; p = p + v*dt;
      Vector2f acceleration;
      force.mulf(inv_mass) => acceleration;
      velocity = velocity + acceleration * _dt;
      position = position + velocity * _dt;

      // Angular integration
      float angularAccel = torque * inv_inertia;
      angular_velocity += angularAccel * _dt;
      orientation += angular_velocity * _dt;

      // Reset forces  (todo) fix torque
      force.init(0,0);
      torque = 0;
   }

   public method detectCollision(Body _b, CollisionManifold _m) : boolean {
      Vector2f relative_pos = _b.position - position;
      float dist_sq = relative_pos.absSqr;
      float radius_sum = radius + _b.radius;

      if(dist_sq >= radius_sum * radius_sum)
         return false;

      float dist = sqrt(dist_sq);
      relative_pos.unit() => _m.normal;
      _m.penetration = radius_sum - dist;

      // Correct position to prevent sticking (simple positional correction)
      float total_inv_mass = inv_mass + _b.inv_mass;
      if(total_inv_mass > 0)
      {
         Vector2f correction = _m.normal * (_m.penetration / total_inv_mass);
         position = position - correction * inv_mass;
         _b.position = _b.position +  correction * _b.inv_mass;
      }

      return true;
   }

   public method resolveCollision(Body _b, CollisionManifold _m, float restitution) {
      Vector2f relative_vel = _b.velocity - velocity;
      float vel_along_normal = relative_vel.dot(_m.normal);

      if(vel_along_normal > 0)
         return;  // Moving apart

      float j = -(1.0f + restitution) * vel_along_normal;
      j /= (inv_mass + _b.inv_mass);

      Vector2f impulse = _m.normal * j;
      velocity = velocity - impulse * inv_mass;
      _b.velocity = _b.velocity + impulse * _b.inv_mass;
   }

   public method resolveWallCollision(float _restitution) {
      // Bottom wall
      if(position.y + radius > World.WORLD_HEIGHT)
      {
         position.y = cur_world_height - radius;
         velocity.y = velocity.y * -_restitution;
      }
      else if(position.y - radius < 0)
      {
         position.y = radius;
         velocity.y = velocity.y * -_restitution;
      }

      // Left wall
      if(position.x - radius < 0) {
         position.x = radius;
         velocity.x = velocity.x * -_restitution;
      }
      else if(position.x + radius > cur_world_width) {
         position.x = cur_world_width - radius;
         velocity.x = velocity.x * -_restitution;
      }
   }

   public method bodyPhysicsStep(local float _dt) {
      force = WorldBase.GRAVITY * mass;
      integrate(_dt);
      resolveWallCollision(WorldBase.RESTITUTION);
   }

   protected method calcColor(float _massScl) {
      if(mass < 1.3f*_massScl)      { r = 0.8f*0.85; g = 0.9f*0.85; b = 0.2f*0.85; }
      else if(mass < 2.0f*_massScl) { r = 0.2f*0.6;  g = 0.7f*0.6;  b = 0.3f*0.6;  }
      else if(mass > 4.0f*_massScl) { r = 0.15f;     g = 0.4f;      b = 0.54f;     }
      else                          { r = 0.2f*0.7;  g = 0.7f*0.7;  b = 0.3f*0.7;  }
      if(b_red)
         r = 1.0f;
   }

   protected method updateColor(float _massScl) {
      calcColor(_massScl);
      sdvg_SetFillColor4f(r, g, b, 1);
      sdvg_SetStrokeColor4f(0, 0, 0, 1);
   }

   public method draw() {
      updateColor(1.0f/*massScl*/);
      sdvg_SetStrokeWidth(1.0f);
      sdvg_SetGlobalAlpha(0.8f);
      sdvg_DrawEllipseFillStrokeAA(position.x, position.y,
                                   radius, radius
                                   );
   }
}

// ---------------------------------------------------------------------------- InnerBody
class InnerBody : Body {
   InnerWorldBody *parent_body;

   protected virtual updateColor(float _massScl) {
      Body::calcColor(_massScl);

      r = 0.8f;
      r *= 0.93f;
      g *= 0.93f;
      b *= 0.93f;

      sdvg_SetFillColor4f(r, g, b, 1);
      sdvg_SetStrokeColor4f(r*0.25, g*0.25, b*0.25, 1);
   }

   public virtual resolveWallCollision(float _restitution) {
      // Constrict to circular area
      Vector2f pRel; position.sub(parent_body.position) => pRel;
      float l = pRel.abs;
      if(l > (parent_body.radius - radius))
      {
         Vector2f pNew;
         pRel.unitScale(parent_body.radius - radius);
         velocity.mulf(-_restitution);
         pRel.add(parent_body.position) => position;
      }
   }

   public virtual draw() {
      updateColor(0.1f/*massScl*/);
      if(parent_body.mass > 4.0f)
         sdvg_SetGlobalAlpha(0.55f);
      else
         sdvg_SetGlobalAlpha(0.35f);
      sdvg_DrawEllipseFillStrokeAA(position.x,
                                   position.y,
                                   radius, radius
                                   );
   }
}

// ---------------------------------------------------------------------------- InnerWorldBody
class InnerWorldBody : Body, WorldBase {

   public virtual init(float _px, float _py,
                       float _mass,
                       float _radius,
                       float _velX, float _velY
                       ) {
      Body::init(_px, _py,
                 _mass,
                 _radius,
                 _velX, _velY
                 );

      // Add inner bodies
      int num = 8;
      bodies.alloc(num);
      loop(num)
      {
         float radius = (rand(_radius*0.4)*mathPowerf(rand(1.0),2.3))+_radius*0.056;
         InnerBody b <= new InnerBody;
         b.parent_body <= this;
         b.init(_px + rand(radius) - radius*0.5, _py + rand(radius) - radius*0.5/*position*/,
                // rand(1.5f)+0.05/*mass*/,
                rand(0.1*3.0f)+0.1*0.1/*mass*/,
                radius,
                rand(10)-5, rand(10)-5/*velocity*/
                );
         bodies.add(#(deref b));
      }
   }

   public virtual bodyPhysicsStep(local float _dt) {
      Body::bodyPhysicsStep(_dt);
      WorldBase::worldPhysicsStep(_dt);
   }

   public virtual draw() {
      updateColor(1.0f/*massScl*/);
      sdvg_SetStrokeWidth(1.0f + 2.0f*radius/8.0f);
      sdvg_SetGlobalAlpha(0.8f);
      sdvg_DrawEllipseFillStrokeAA(position.x, position.y,
                                   radius, radius
                                   );

      sdvg_SetStrokeWidth(0.5f);
      drawBodies();
   }
}

// ---------------------------------------------------------------------------- CollisionManifold
class CollisionManifold {
   Vector2f normal;
   float penetration;
}

// ---------------------------------------------------------------------------- WorldBase
class WorldBase {
   static Vector2f GRAVITY = [0, 9.81f];
   define float DT = 0.016f * 2; // ~60 FPS
   define float RESTITUTION = 0.7f;

   Body *[] bodies;
   CollisionManifold collision_manifold;

   public method worldPhysicsStep(local float _dt) {

      // 1. Apply gravity and integrate
      local Body *a;
      foreach a in bodies
         a.bodyPhysicsStep(_dt);

      // 2. Handle collisions between bodies
      local int i = 0;
      loop(bodies.numElements)
      {
         a <= bodies[i];
         local int j = i + 1;
         loop(bodies.numElements - j)
         {
            Body b <= bodies[j];
            if(a.detectCollision(b, collision_manifold))
            {
               a.resolveCollision(b, collision_manifold, RESTITUTION);
            }
            j++;
         }
         if(a.velocity.abs > 3)
            b_all_at_rest = false;
         i++;
      }
   }

   public method drawBodies() {
      Body *a;
      foreach a in bodies
         a.draw();
   }

}

// ---------------------------------------------------------------------------- World
class World : WorldBase {
   define float WORLD_WIDTH = 100.0f;
   define float WORLD_HEIGHT = 75.0f;

   public method init() {
      int num = 64;
      bodies.alloc(num);
      loop(num)
      {
         float radius = (rand(7.5)*mathPowerf(rand(1.0),2.3))+1.5;
         Body *b;
         if(radius > 2.5 && rand(10) > (5-3*radius/8.0f))
         {
            b <= new InnerWorldBody;
            b.b_red = rand(10) > 4;
         }
         else
         {
            b <= new Body;
         }
         b.init(rand(cur_world_width), rand(cur_world_height*0.75)+cur_world_height*0.25/*position*/,
                rand(5.0f)+0.1/*mass*/,
                radius,
                rand(20)-10, rand(20)-10/*velocity*/
                );
         bodies.add(#(deref b));
      }

      all_at_rest_count = 0;
      scene_frame_count = 0;
   }

   public method drawWorld(float _dt) {

      sdvg_ProjInit2D(cur_world_width, cur_world_height);
      b_all_at_rest = true;

      // 1. Physics
      loop(4)
         worldPhysicsStep(_dt * (1.0f / 4));

      drawBodies();

      // Force re-randomization after 30 seconds
      if(++scene_frame_count > (30*60))
      {
         trace "[dbg] force reinit after "+scene_frame_count+" frames";
         scene_frame_count = 0;
         init();
      }
   }
}

// ---------------------------------------------------------------------------- onDraw
function onDraw() {
   float dt = FPS.precision;

   sdvg_SetFramebufferSize(Viewport.width, Viewport.height);
   sdvg_BeginFrame();
   sdvg_SetViewport(0, 0, Viewport.width, Viewport.height);
   sdvg_SetScissor(0, 0, Viewport.width, Viewport.height);
   sdvg_SetEnableAA(true);
   sdvg_SetFillColor4f(0.1f, 0.4f, 0.25f, 1.0f);
   sdvg_SetStrokeColor4f(1.0f, 1.0f, 1.0f, 1.0f);
   sdvg_SetStrokeRadiusAAOffset(1.5f);
   sdvg_PaintSolid();

   sdvg_Clear4f(0, 0.25*0.9, 0.3*0.9, 0);

   if( !(++numframesrendered&127) )
      trace "FPS.real="+FPS.real;

   world.drawWorld(dt * World.DT);

   sdvg_EndFrame();

   // Re-randomize when all objects are at rest
   if(b_all_at_rest)
   {
      if(++all_at_rest_count > (7*60))
      {
         trace "[dbg] reinit after "+all_at_rest_count+" frames (all-at-rest)";
         world.init();
      }
   }
   else
   {
      all_at_rest_count = 0;
   }
}

// ---------------------------------------------------------------------------- onKeyboard
function onKeyboard(Key _k) {
   trace "[...] onKeyboard: k.code="+_k.code+" ("+TKS.constantToString(_k.code, "VKEY_")+") mod="+_k.mod+" pressed="+_k.pressed+" released="+_k.released+" unicode="+_k.unicode+" "+tcchar(_k.unicode);
   switch(_k.pressed)
   {
      case VKEY_ESCAPE:
         SDL.exitEventLoop();
         break;

      case VKEY_SPACE:
         trace "[...] world.init()";
         world.init();
         break;
   }
}

// ---------------------------------------------------------------------------- UpdateWorldSize
function UpdateWorldSize() {
   float aspect = (float(Viewport.width) / Viewport.height) / 1.333;
   float extra = ((World.WORLD_WIDTH*aspect) - World.WORLD_WIDTH) * 0.5f;
   cur_world_width = World.WORLD_WIDTH + 2*extra;
   cur_world_height = World.WORLD_HEIGHT;
}

// ---------------------------------------------------------------------------- onOpen
function onOpen() {
   zglLoadExtensions();
   zglEnableGLCore(true);
   if(!sdvg_OnOpen())
      die "sdvg_OnOpen() failed";
   UpdateWorldSize();
   world.init();
}

// ---------------------------------------------------------------------------- main
function main() {

   use callbacks;

   sdvg_SetScratchBufferSize(256*1024);
   sdvg_SetGLSLVersion(true/*glcore/bV3*/, false/*bGLES*/, null/*sVersionStringOrNull*/);
   if(!sdvg_Init(true/*glcore/v3*/))
      die "[---] sdvg_Init() failed";

   SDL.dpiAwareness = true;  // no OS scaling
   Viewport.openWindow(1600, 900);
   Viewport.swapInterval(1);
   Viewport.caption = "rigid body";

   trace "[...]                   GL_VENDOR = \"" + glGetString(GL_VENDOR) + "\"";
   trace "[...]                  GL_VERSION = \"" + glGetString(GL_VERSION) + "\"";
   trace "[...] GL_SHADING_LANGUAGE_VERSION = \"" + glGetString(GL_SHADING_LANGUAGE_VERSION) + "\"";

   FPS.tickInterval = (1000.0/60);
   FPS.limit = 0;

   SDL.enableUNICODE(true);
   SDL.enableKeyRepeat(0,0);
   SDL.eventLoop();
   sdvg_Exit();
}
