// 19Jul2026
//
// (note) initially generated by gemma4:31b LLM ("C" / SDL2 / OpenGL 4.1 core) (31m 17s)
// (note) refactored (OOP) and ported to TKS (~45m)
//          (+ another hour to realize I forgot glEnableVertexAttribArray() - d'oh!)
//          (also added some tweaks)

putenv("TKSDL_GLERROR=1");
putenv("TKSDL_GLCORE=1");

use tksdl;
use tkmath;
use tkopengl;

World world;
Renderer renderer;

int numframesrendered;
boolean b_all_at_rest;
int all_at_rest_count;  // auto-re-randomize after 7 sec
int scene_frame_count;  // since world.init() (max=30sec)

float cur_world_width;
float cur_world_height;

// ---------------------------------------------------------------------------- Renderer
class Renderer {
   int program;
   int vao;
   int vbo;
   int u_proj;
   int u_pos;
   int u_rad;
   int u_aa_d;
   int u_col;
   int a_pos;

   static String vertex_shader_source =
      "#version 410 core\n"
      "in vec2 a_pos; \n"
      "uniform mat4 u_proj;\n"
      "uniform vec2 u_pos;\n"
      "uniform float u_rad;\n"
      "out vec2 v_localPos;\n"
      "void main() {\n"
      "  v_localPos = a_pos;\n"
      "  vec2 worldPos = u_pos + a_pos * u_rad;\n"
      "  gl_Position = u_proj * vec4(worldPos, 0.0, 1.0);\n"
      "}\n"
      ;

   static String fragment_shader_source =
      "#version 410 core\n"
      "out vec4 FragColor;\n"
      "in vec2 v_localPos;\n"
      "uniform vec3 u_col;\n"
      "uniform float u_rad;\n"
      "uniform float u_aa_d;\n"
      "void main() {\n"
      "  float dist = length(v_localPos);\n"
      "  float a = 1.0 - smoothstep(u_aa_d, 1.0, dist); \n"
      "  FragColor = vec4(u_col, a);\n"
      "}\n"
      ;

   protected method initShader() {
      String log;

      program = glCreateProgram();

      int vert = glCreateShader(GL_VERTEX_SHADER);
      zglShaderSource(vert, vertex_shader_source);
      glCompileShader(vert);
      glGetShaderInfoLog(vert, log);
      trace "[...] vertex shader log=\""+log+"\".";
      glAttachShader(program, vert);

      int frag = glCreateShader(GL_FRAGMENT_SHADER);
      zglShaderSource(frag, fragment_shader_source);
      glCompileShader(frag);
      glGetShaderInfoLog(frag, log);
      trace "[...] fragment shader log=\""+log+"\".";
      glAttachShader(program, frag);

      glBindFragDataLocation(program, 0, "FragColor");

      glLinkProgram(program);

      glGetProgramInfoLog(program, log);
      trace "[...] program log=\""+log+"\".";

      u_proj = glGetUniformLocation(program, "u_proj");
      u_pos  = glGetUniformLocation(program, "u_pos");
      u_rad  = glGetUniformLocation(program, "u_rad");
      u_aa_d = glGetUniformLocation(program, "u_aa_d");
      u_col  = glGetUniformLocation(program, "u_col");

      a_pos = glGetAttribLocation(program, "a_pos");

      trace "[dbg] Renderer::initShader: vert="+vert+" frag="+frag+" program="+program+" u_proj="+u_proj+" u_pos="+u_pos+" u_rad="+u_rad+" u_col="+u_col+" a_pos="+a_pos;

      glDeleteShader(vert);
      glDeleteShader(frag);
   }

   protected method initVBO_VAO() {
      FloatArray vertices = [  // 6 vertices
         -1.0f, -1.0f,
          1.0f, -1.0f,
          1.0f,  1.0f,
         -1.0f, -1.0f,
          1.0f,  1.0f,
         -1.0f,  1.0f
                             ];

      vbo = zglGenBuffer();
      glBindBuffer(GL_ARRAY_BUFFER, vbo);
      zglBufferData(GL_ARRAY_BUFFER, vertices.numElements * 4/*sizeof(float)*/, vertices, GL_STATIC_DRAW);
      glBindBuffer(GL_ARRAY_BUFFER, 0);

      vao = zglGenVertexArray();
      glBindVertexArray(vao);
      glBindBuffer(GL_ARRAY_BUFFER, vbo);
      zglVertexAttribOffset(a_pos, 2/*size*/, GL_FLOAT, GL_FALSE/*normalize*/, 0/*stride*/, 0/*offset*/);
      glBindBuffer(GL_ARRAY_BUFFER, 0);
      glBindVertexArray(0);
   }

   public method init() {
      initShader();
      initVBO_VAO();
   }

   public method beginFrameAndClear(float _r, _g, _b) {
      glClearColor(_r, _g, _b, 1);
      glClear(GL_COLOR_BUFFER_BIT);
      glDisable(GL_SCISSOR_TEST);
      glDisable(GL_DEPTH_TEST);
      glDisable(GL_STENCIL_TEST);
      glDisable(GL_CULL_FACE);
      glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
      glEnable(GL_BLEND);
   }

   public method loadProjection2D() {
      Matrix4f projMatrix;
      projMatrix.initIdentity();

      float projR = cur_world_width;
      float projT = cur_world_height;
      projMatrix.ortho(0/*left*/,     projR/*right*/,
                       0/*bottom*/,   projT/*top*/,
                       0.0f/*znear*/, 10.0f/*zfar*/
                       );
      glUniformMatrix4fv(u_proj, 1/*count*/, GL_TRUE/*transpose*/, projMatrix);
   }

   public method bind() {
      glUseProgram(program);
      glBindVertexArray(vao);
      glEnableVertexAttribArray(a_pos);  // jep, don't forget about that.
   }

   public method updatePositionAndRadius(Vector2f _position, float _radius) {
      glUniform2f(u_pos, _position.x, _position.y);
      glUniform1f(u_rad, _radius);
      float aaDist = mathClampf((_radius / 5.0f) * (Viewport.width / 800.0f), 0.9, 0.97);
      glUniform1f(u_aa_d, aaDist);
   }

   public method updateColor(float _r, _g, _b) {
      glUniform3f(u_col, _r, _g, _b);
   }

   public method drawTriangles() {
      glDrawArrays(GL_TRIANGLES, 0/*first*/, 6/*count*/);
   }

   public method unbind() {
      glDisableVertexAttribArray(a_pos);
      glBindVertexArray(0);
      glUseProgram(0);
   }

   public method endFrame() {
   }
}

// ---------------------------------------------------------------------------- Body
class Body {
   Vector2f position;
   Vector2f velocity;
   Vector2f force;

   float orientation;
   float angular_velocity;
   float torque;

   float mass;
   float inv_mass;
   float inertia;
   float inv_inertia;

   float radius;

   public method init(float _px, float _py,
                      float _mass,
                      float _radius,
                      float _velX, float _velY
                      ) {
      position.init(_px, _py);
      mass = _mass;
      radius = _radius;

      inv_mass = (mass > 0) ? 1.0f / mass : 0;

      // For a circle: I = 0.5 * m * r^2
      inertia = 0.5f * mass * radius * radius;
      inv_inertia = (inertia > 0) ? 1.0f / inertia : 0;

      velocity.init(_velX, _velY);
   }

   public method integrate(float _dt) {
      if(0.0f == inv_mass)
         return; // Static body

      // Semi-implicit Euler: v = v + a*dt; p = p + v*dt;
      Vector2f acceleration;
      force.mulf(inv_mass) => acceleration;
      velocity = velocity + acceleration * _dt;
      position = position + velocity * _dt;

      // Angular integration
      float angularAccel = torque * inv_inertia;
      angular_velocity += angularAccel * _dt;
      orientation += angular_velocity * _dt;

      // Reset forces  (todo) fix torque
      force.init(0,0);
      torque = 0;
   }

   public method detectCollision(Body _b, CollisionManifold _m) : boolean {
      Vector2f relative_pos = _b.position - position;
      float dist_sq = relative_pos.absSqr;
      float radius_sum = radius + _b.radius;

      if(dist_sq >= radius_sum * radius_sum)
         return false;

      float dist = sqrt(dist_sq);
      relative_pos.unit() => _m.normal;
      _m.penetration = radius_sum - dist;

      // Correct position to prevent sticking (simple positional correction)
      float total_inv_mass = inv_mass + _b.inv_mass;
      if(total_inv_mass > 0)
      {
         Vector2f correction = _m.normal * (_m.penetration / total_inv_mass);
         position = position - correction * inv_mass;
         _b.position = _b.position +  correction * _b.inv_mass;
      }

      return true;
   }

   public method resolveCollision(Body _b, CollisionManifold _m, float restitution) {
      Vector2f relative_vel = _b.velocity - velocity;
      float vel_along_normal = relative_vel.dot(_m.normal);

      if(vel_along_normal > 0)
         return;  // Moving apart

      float j = -(1.0f + restitution) * vel_along_normal;
      j /= (inv_mass + _b.inv_mass);

      Vector2f impulse = _m.normal * j;
      velocity = velocity - impulse * inv_mass;
      _b.velocity = _b.velocity + impulse * _b.inv_mass;
   }

   public method resolveWallCollision(float _restitution) {
      // Bottom wall
      if(position.y + radius > World.WORLD_HEIGHT)
      {
         position.y = cur_world_height - radius;
         velocity.y = velocity.y * -_restitution;
      }
      else if(position.y - radius < 0)
      {
         position.y = radius;
         velocity.y = velocity.y * -_restitution;
      }

      // Left wall
      if(position.x - radius < 0) {
         position.x = radius;
         velocity.x = velocity.x * -_restitution;
      }
      else if(position.x + radius > cur_world_width) {
         position.x = cur_world_width - radius;
         velocity.x = velocity.x * -_restitution;
      }
   }

   public method draw() {
      float r, g, b;

      if(mass < 1.3f)        { r = 0.8f*0.85; g = 0.9f*0.85; b = 0.2f*0.85; }
      else if(mass < 2.0f)   { r = 0.2f*0.6;  g = 0.7f*0.6;  b = 0.3f*0.6;  }
      else if(mass > 4.0f)   { r = 0.15f;     g = 0.4f;      b = 0.54f;     }
      else                   { r = 0.2f*0.7;  g = 0.7f*0.7;  b = 0.3f*0.7;  }

      renderer.updatePositionAndRadius(position, radius);
      renderer.updateColor(r, g, b);
      renderer.drawTriangles();
   }
}

// ---------------------------------------------------------------------------- CollisionManifold
class CollisionManifold {
   Vector2f normal;
   float penetration;
}

// ---------------------------------------------------------------------------- World
class World {
   define float WORLD_WIDTH = 100.0f;
   define float WORLD_HEIGHT = 75.0f;
   static Vector2f GRAVITY = [0, -9.81f];
   define float DT = 0.016f * 2; // ~60 FPS
   define float RESTITUTION = 0.7f;

   Body bodies[];

   public method init() {
      int num = 64;
      bodies.alloc(num);
      loop(num)
      {
         Body b <= bodies.nextFree;
         b.init(rand(cur_world_width), rand(cur_world_height*0.75)+cur_world_height*0.25/*position*/,
                rand(5.0f)+0.1/*mass*/,
                (rand(7.5)*mathPowerf(rand(1.0),2.3))+1.5/*radius*/,
                rand(20)-10, rand(20)-10/*velocity*/
                );
      }

      all_at_rest_count = 0;
      scene_frame_count = 0;
   }

   protected method physicsStep(float _dt) {

      // 1. Apply gravity and integrate
      Body *a;
      foreach a in bodies
      {
         a.force = GRAVITY * a.mass;
         a.integrate(_dt);
         a.resolveWallCollision(RESTITUTION);
      }

      // 2. Handle collisions between bodies
      int i = 0;
      b_all_at_rest = true;
      loop(bodies.numElements)
      {
         a <= bodies[i];
         int j = i + 1;
         loop(bodies.numElements - j)
         {
            CollisionManifold m;
            Body b <= bodies[j];
            if(a.detectCollision(b, m))
            {
               a.resolveCollision(b, m, RESTITUTION);
            }
            j++;
         }
         if(a.velocity.abs > 3)
            b_all_at_rest = false;
         i++;
      }
   }

   public method draw(float _dt) {

      // 1. Physics
      loop(4)
         physicsStep(_dt * (1.0f / 4));

      // 2. Render
      renderer.bind();
      renderer.loadProjection2D();

      Body *a;
      foreach a in bodies
         a.draw();

      renderer.unbind();

      // Force re-randomization after 30 seconds
      if(++scene_frame_count > (30*60))
      {
         trace "[dbg] force reinit after "+scene_frame_count+" frames";
         scene_frame_count = 0;
         init();
      }
   }
}

// ---------------------------------------------------------------------------- onDraw
function onDraw() {
   float dt = FPS.precision;

   renderer.beginFrameAndClear(0, 0.25*0.9, 0.3*0.9);

   if( !(++numframesrendered&127) )
      trace "FPS.real="+FPS.real;

   world.draw(dt * World.DT);

   renderer.endFrame();

   // Re-randomize when all objects are at rest
   if(b_all_at_rest)
   {
      if(++all_at_rest_count > (7*60))
      {
         trace "[dbg] reinit after "+all_at_rest_count+" frames (all-at-rest)";
         world.init();
      }
   }
   else
   {
      all_at_rest_count = 0;
   }
}

// ---------------------------------------------------------------------------- onKeyboard
function onKeyboard(Key _k) {
   trace "[...] onKeyboard: k.code="+_k.code+" ("+TKS.constantToString(_k.code, "VKEY_")+") mod="+_k.mod+" pressed="+_k.pressed+" released="+_k.released+" unicode="+_k.unicode+" "+tcchar(_k.unicode);
   switch(_k.pressed)
   {
      case VKEY_ESCAPE:
         SDL.exitEventLoop();
         break;

      case VKEY_SPACE:
         trace "[...] world.init()";
         world.init();
         break;
   }
}

// ---------------------------------------------------------------------------- UpdateWorldSize
function UpdateWorldSize() {
   float aspect = (float(Viewport.width) / Viewport.height) / 1.333;
   float extra = ((World.WORLD_WIDTH*aspect) - World.WORLD_WIDTH) * 0.5f;
   cur_world_width = World.WORLD_WIDTH + 2*extra;
   cur_world_height = World.WORLD_HEIGHT;
}

// ---------------------------------------------------------------------------- onOpen
function onOpen() {
   zglLoadExtensions();
   renderer.init();
   UpdateWorldSize();
   world.init();
}

// ---------------------------------------------------------------------------- main
function main() {

   use callbacks;

   SDL.dpiAwareness = true;  // no OS scaling
   Viewport.openWindow(1024, 768);
   Viewport.swapInterval(1);
   Viewport.caption = "rigid body";

   trace "[...]                   GL_VENDOR = \"" + glGetString(GL_VENDOR) + "\"";
   trace "[...]                  GL_VERSION = \"" + glGetString(GL_VERSION) + "\"";
   trace "[...] GL_SHADING_LANGUAGE_VERSION = \"" + glGetString(GL_SHADING_LANGUAGE_VERSION) + "\"";

   FPS.tickInterval = (1000.0/60);
   FPS.limit = 0;

   SDL.enableUNICODE(true);
   SDL.enableKeyRepeat(0,0);
   SDL.eventLoop();
}
