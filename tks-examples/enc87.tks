
Buffer raw; raw.size = 4567;
loop(raw.size)
  raw.i8 = rand(255);
trace "raw.offset="+raw.offset;

Buffer rawOrig = raw;

Buffer syx; syx.size = 8 + (raw.size * 8) / 7;
syx.offset = 0;
raw.offset = 0;
syx.encode7From8(raw, raw.size);
int numEnc = syx.offset;
trace "numEnc="+numEnc;

raw.offset = 0;
syx.offset = 0;
raw.decode8From7(syx, numEnc);
int numDec = raw.offset;
trace "numDec="+numDec;

if(raw.compareBuffer(rawOrig))
{
   trace "ok";
}
else
{
   trace "NOK (raw.offset="+raw.offset+" rawOrig.size="+rawOrig.size+")";
}
