
// Create random-data nibblestream buffer
Buffer bn; bn.size = 1024;
NibbleStream nw; nw.stream = bn;
nw.i4 = 11;
nw.i8 = 253;
nw.i16 = 50789;
nw.i32 = -10324903;
nw.f32 = 3.1415;
nw.flush();
trace "read nw.offset="+nw.offset+" bn.offset="+bn.offset;

// Read nibblestream buffer
Buffer br; br.size = 1024;
NibbleStream nr; nr.stream = bn;
nr.offset = 0; // rewind 'bn'
br.i32 = nr.u4;
br.i32 = nr.u8;
br.i32 = nr.u16;
br.i32 = nr.i32;
br.f32 = nr.f32;
trace "read nr.offset="+nr.offset+" bn.offset="+bn.offset+" br.offset="+br.offset;

// Compare to original buffer
if(br.peekI32(0)  == 11        &&
   br.peekI32(4)  == 253       &&
   br.peekI32(8)  == 50789     &&
   br.peekI32(12) == -10324903 &&
   br.peekF32(16) == 3.1415
   )
{
   trace "ok";
}
else
{
   trace "NOK";
   exit(10);
}
