//
// $ tks -ll 0 debug_log      overrides 'log4 true;' and removes all log statements
// $ tks -lma debug_log       permits all log messages (default) (default log level is 0, though)
// $ tks -lmn debug_log       forbids all log messages
// $ tks -lmnd debug_log      permits only debug log messages (all log levels)
// $ tks -lmnisef debug_log   permits only info, success, error, and fatal log messages
// $ tks -lmapd debug_log     permits all except profile and debug log messages
//
// (note) comment out the onLog*() functions to fall back to the default implementation
//

log4 true;  // configure log level (unless overridden by cmdline)
trace("logLevel="+Configuration.logLevel
      +"\n    enableLogInfo="+Configuration.enableLogInfo
      +"\n enableLogVerbose="+Configuration.enableLogVerbose
      +"\n enableLogSuccess="+Configuration.enableLogSuccess
      +"\n enableLogWarning="+Configuration.enableLogWarning
      +"\n   enableLogError="+Configuration.enableLogError
      +"\n   enableLogFatal="+Configuration.enableLogFatal
      +"\n enableLogProfile="+Configuration.enableLogProfile
      +"\n   enableLogDebug="+Configuration.enableLogDebug
      );

function onLogInfo(String _s) {
   trace "[...]* "+_s;
}

function onLogVerbose(String _s) {
   trace "[:::]* "+_s;
}

function onLogSuccess(String _s) {
   trace "[+++]* "+_s;
}

function onLogWarning(String _s) {
   trace "[~~~]* "+_s;
}

function onLogError(String _s) {
   trace "[---]* "+_s;
}

function onLogFatal(String _s) {
   trace "[!!!]* "+_s;
}

function onLogProfile(String _s) {
   trace "[pro]* "+_s;
}

function onLog1(String _s) {
   trace "[dbg]* "+_s;
}

function onLog2(String _s) {
   trace "[trc]* "+_s;
}

function onLog3(String _s) {
   trace "[>>>]* "+_s;
}

function onLog4(String _s) {
   trace "[***]* "+_s;
}

use callbacks;

loginfo    "hello, loginfo world";
logverbose "hello, logverbose world";
logsuccess "hello, logsuccess world";
logwarning "hello, logwarning world";
logerror   "hello, logerror world";
logfatal   "hello, logfatal world";
logprofile "hello, logprofile world";

log1 "hello, debug world.";
log2 "hello, verbose debug world.";
log3 "hello, very verbose debug world.";
log4 "hello, very very verbose debug world.";

trace "log2(8)="+log2(8);
