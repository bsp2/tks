
Buffer b; b.size = 1024;
NibbleStream n; n.stream = b;
n.i4  = -8;
n.i12 = -2048;
n.i20 = -524288;
n.i28 = -134217728;
n.flush();

// Read and verify
n.offset = 0;
if(        -8 == n.s4  &&
        -2048 == n.s12 &&
      -524288 == n.s20 &&
   -134217728 == n.s28
           )
{
   trace "ok";
}
else
{
   trace "NOK";
   exit(10);
}
