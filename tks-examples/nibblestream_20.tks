
// Create random-data buffer
Buffer b; b.size = 1024;
loop(255)
   b.i32 = rand(1048575);

// Write 20-bit stream
Buffer bw; bw.size = 1024;
NibbleStream nw; nw.stream = bw;
b.offset = 0;
loop(255)
  nw.i20 = b.i32;
nw.flush();

// Read unsigned 20-bit stream
Buffer br; br.size = 1024;
NibbleStream nr; nr.stream = bw;
nr.offset = 0;  // rewind 'bw'
loop(255)
  br.i32 = nr.u20;

// Compare to original buffer
if(br.compareBuffer(b))
{
   trace "ok";
}
else
{
   trace "NOK";
   exit(10);
}
