
// Create random-data buffer
Buffer b; b.size = 1024;
loop(255)
   b.i8 = rand(15);

// Write nibbles
Buffer bn; bn.size = 1024;
b.offset = 0;
NibbleStream n; n.stream = bn;
int i = 0;
loop(255)
   n.i4 = b.i8;
n.flush();
trace "write n.offset="+n.offset+" b.offset="+b.offset;

// Read nibbles
Buffer br; br.size = 1024;
n.offset = 0;
loop(255)
   br.i8 = n.u4;
trace "read n.offset="+n.offset+" br.offset="+br.offset;

// Compare to original buffer
if(br.compareBuffer(b))
{
   trace "ok";
}
else
{
   trace "NOK";
   exit(10);
}
