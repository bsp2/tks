use tkmath;

Vector2f v;

v.initAngle(0);
trace "v(a=0)="+v+" => v.angle="+v.angle;

v.initAngle(PI*0.5);
trace "v(a="+(PI*0.5)+"=PI/2)="+v+" => v.angle="+v.angle;

v.initAngle(PI);
trace "v(a="+(PI)+"=PI)="+v+" => v.angle="+v.angle;

v.initAngle(2PI);
trace "v(a="+(2PI)+"=2PI)="+v+" => v.angle="+v.angle;

v.initAngle(1.345);
trace "v(a=1.345)="+v+" => v.angle="+v.angle;
