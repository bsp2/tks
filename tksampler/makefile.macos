include ../install_macos.mk

PLUGIN=tksampler

EXTRAFLAGS=
#EXTRAFLAGS+= -DTKSAMPLER_WAVEPATH

EXTRALIBS=

PLAF_OBJ=

MAKEFLAGS= RELEASE=y OPT_SIZE=y

include make.objects

CLEAN_RULES   += clean_plugins
BIN_RULES     += bin_plugins
INSTALL_RULES += install_plugins

.PHONY: clean_plugins
clean_plugins:
	+make -j $(NUMJOBS) -C plugins -f makefile.macos $(MAKEFLAGS) clean 

.PHONY: bin_plugins
bin_plugins:
	+make -j $(NUMJOBS) -C plugins -f makefile.macos $(MAKEFLAGS) bin

.PHONY: install_plugins
install_plugins:
	+make -C plugins -f makefile.macos $(MAKEFLAGS) install

include ../plugin_macos.mk

.PHONY: bin_sr
bin_sr:
	+make -f makefile.macos STFX_SKIP_MAIN_INIT=1 $(MAKEFLAGS) bin
