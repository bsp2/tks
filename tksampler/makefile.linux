include ../install_linux.mk

PLUGIN=tksampler

EXTRAFLAGS=
#EXTRAFLAGS+= -DTKSAMPLER_WAVEPATH

EXTRALIBS=

PLAF_OBJ=

include make.objects

CLEAN_RULES   += clean_plugins
BIN_RULES     += bin_plugins
INSTALL_RULES += install_plugins

.PHONY: clean_plugins
clean_plugins:
	make -j $(NUMJOBS) -C plugins -f makefile.linux clean

.PHONY: bin_plugins
bin_plugins:
	make -j $(NUMJOBS) -C plugins -f makefile.linux bin

.PHONY: install_plugins
install_plugins:
	make -C plugins -f makefile.linux install

include ../plugin_linux.mk
