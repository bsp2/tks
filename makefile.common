.PHONY: tksdl_examples_install
tksdl_examples_install:
	$(MAKE) -C tks-examples/tksdl install


#
# tks
#
.PHONY: tks
tks:
	$(m) -j $(NUM_JOBS) -C tks-source realclean ; $(m) -j $(NUM_JOBS) -C tks-source bin

.PHONY: tks_clean
tks_clean:
	$(m) -j $(NUM_JOBS) -C tks-source realclean

.PHONY: tks_lib
tks_lib:
	$(m) -j $(NUM_JOBS) -C tks-source lib
	$(m) -j $(NUM_JOBS) -C tks-source clean

.PHONY: tks_bin
tks_bin: tks_lib
	$(m) -j $(NUM_JOBS) -C tks-source bin

tks_upx:
	$(m) -j $(NUM_JOBS) -C tks-source upx

tks_install:
	$(m) -j $(NUM_JOBS) -C tks-source install_lib
	$(m) -j $(NUM_JOBS) -C tks-source install

tks_ee:
	$(m) -j $(NUM_JOBS) -C tks-source ee

tks_zip:
	$(RM) "$(TKS_ZIP_PREFIX)/tks-source.zip" ; $(ZIP) -r -9 "$(TKS_ZIP_PREFIX)/tks-source.zip" tks-source


