# ------------------------------------------------------------------------------

.PHONY: tsl_install
tsl_install:
	$(m) -j1 $(ALL_TSL_TARGETS)

.PHONY: tkx_install
tkx_install:
	$(m) -j1 $(ALL_TKX_TARGETS)

.PHONY: all_install_sync
all_install_sync: tks_install plugins_install tsl_install tkx_install
	@echo "tks + plugins + tsl + tkx install finished at `date +%H:%M`."

.PHONY: all_install
all_install:
	( if ! [ -e "$(TKS_PREFIX)/" ]; then mkdir -p "$(TKS_PREFIX)/"; fi )
	$(m) -j1 all_install_sync

.PHONY: all_ee
all_ee: tks_ee plugins_ee

.PHONY: all_zip
all_zip: tks_zip tks_build_zip yac_zip plugins_zip all_tsl_zip all_app_zip all_examples_zip synergy_replay_zip $(EXTRA_ZIP_TARGETS)
	@echo "all_zip finished at `date +%H:%M`."

.PHONY: zip
zip: all_zip

.PHONY: realclean
realclean: all_clean
	$(RM) `$(FIND) . -name \*\~ -o -name \*.o -o -name \*.obj -o -name \*.exp -o -name \*.plg -o -name \*.ncb -o -name \*.manifest -o -name .DS_Store -o -name \*.tmp` -o -name \*.map
