#
# Makefile for minnie lib and 'C' test cases on MSVC platform
#
# (c) 2025 Bastian Spiegel <bs@tkscript.de>
#

STATIC_TARGET=minnie.lib
APP_TARGET_TEST_SHADERVG=test_shadervg

YAC_ROOTPATH=../../../../
include $(YAC_ROOTPATH)/install_msvc.mk

SDL=$(YAC_ROOTPATH)/tksdl2/SDL2-2.32.4

OPTFLAGS= -Os

EXTRAFLAGS+= -DYAC_NO_HOST
EXTRAFLAGS+= -I"$(SDL)/include/" -I"$(DXSDK_INC)"

include ../config_common.mk

ifeq ($(BUILD_64),y)
SDL_LIB="$(SDL)/lib/x64/release/SDL2main.lib" "$(SDL)/lib/x64/release/SDL2.lib"
else
SDL_LIB="$(SDL)/lib/x86/release/SDL2main.lib" "$(SDL)/lib/x86/release/SDL2.lib"
endif

EXTRALIBS= $(SDL_LIB) user32.lib shell32.lib opengl32.lib -LIBPATH:"$(DXSDK_LIB)" ddraw.lib comctl32.lib

PLAF_OBJ=

include ../make.objects

TEST_SHADERVG_OBJ += ../../gl_ext.o

$(APP_TARGET_TEST_SHADERVG): static_target $(TEST_SHADERVG_OBJ)
	$(LD) $(LDFLAGS_SIZE) /SUBSYSTEM:Console /ENTRY:wmainCRTStartup -INCREMENTAL:NO -OUT:$(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ) $(STATIC_TARGET) $(LDFLAGS) $(EXTRALIBS)
	ls -ld $(APP_TARGET_TEST_SHADERVG)

CLEAN_RULES+= clean_app_target_test_shadervg
.PHONY: clean_app_target_test_shadervg
clean_app_target_test_shadervg:
	rm -f $(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ)

.PHONY: bin
bin: $(APP_TARGET_TEST_SHADERVG)
	@echo "minnie build finished at `date +%H:%M`."

include $(YAC_ROOTPATH)/plugin_msvc.mk
