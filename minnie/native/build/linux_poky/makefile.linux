#
# Makefile for minnie lib and 'C' test cases on Poky Linux / GCC platform
#
# (c) 2025-2026 Bastian Spiegel <bs@tkscript.de>
#

STATIC_TARGET=minnie.a
APP_TARGET_TEST_SHADERVG=test_shadervg
APP_TARGET_TEST_MIN=test_min
APP_TARGET_TEST_MIB=test_mib

include ${TKS_ROOT}/install_linux.mk

BOARD_PATH:=/home/root/minnie/bin
BOARD_USER:=root

EXTRAFLAGS+= -DSHADERVG_GLES
#EXTRAFLAGS+= -DSHADERVG_NO_ZS
#EXTRAFLAGS+= -DSHADERVG_NO_DISPLAY
#EXTRAFLAGS+= -DSHADERVG_MSAA
#EXTRAFLAGS+= -DSHADERVG_AUTO_EXIT_FRAMES=100

EXTRAFLAGS+= -DMIB_PATH=\"resources/mib/\"

EXTRAFLAGS+= -DYAC_NO_HOST
EXTRAFLAGS+= -Wno-deprecated-declarations
EXTRAFLAGS+= -ffunction-sections
##EXTRAFLAGS+= -I/usr/include -I/usr/local/include

LDFLAGS+= -Wl,--gc-sections

include ../config_common.mk

EXTRALIBS= -lpthread -lEGL -lGLESv2 -ldrm -ldisplay

include ../make.objects

PLAF_OBJ= \
	../../gl_ext.o \
	../../hal_dnx_poky.o

STATIC_TARGET_OBJ += $(PLAF_OBJ)

$(APP_TARGET_TEST_SHADERVG): static_target $(TEST_SHADERVG_OBJ)
	$(CPP) -o $(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ) $(STATIC_TARGET) $(LDFLAGS) $(EXTRALIBS)
	#objdump -h ../../../shadervg/shadervg.o
ifneq ($(DEBUG),y)
	$(STRIP) $(APP_TARGET_TEST_SHADERVG)
endif
	ls -ld `find ../../../ -name \*.o`
	#objdump -h $(APP_TARGET_TEST_SHADERVG)
	ls -ld $(APP_TARGET_TEST_SHADERVG)

CLEAN_RULES+= clean_app_target_test_shadervg
.PHONY: clean_app_target_test_shadervg
clean_app_target_test_shadervg:
	rm -f $(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ)

$(APP_TARGET_TEST_MIN): static_target $(TEST_MIN_OBJ)
	$(CPP) -o $(APP_TARGET_TEST_MIN) $(TEST_MIN_OBJ) $(STATIC_TARGET) $(LDFLAGS) $(EXTRALIBS)
ifneq ($(DEBUG),y)
	$(STRIP) $(APP_TARGET_TEST_MIN)
endif
	#objdump -h $(APP_TARGET_TEST_MIN)
	ls -ld $(APP_TARGET_TEST_MIN)

CLEAN_RULES+= clean_app_target_test_min
.PHONY: clean_app_target_test_min
clean_app_target_test_min:
	rm -f $(APP_TARGET_TEST_MIN) $(TEST_MIN_OBJ)

$(APP_TARGET_TEST_MIB): static_target $(TEST_MIB_OBJ)
	$(CPP) -o $(APP_TARGET_TEST_MIB) $(TEST_MIB_OBJ) $(STATIC_TARGET) $(LDFLAGS) $(EXTRALIBS)
ifneq ($(DEBUG),y)
	$(STRIP) $(APP_TARGET_TEST_MIB)
endif
	#objdump -h $(APP_TARGET_TEST_MIB)
	ls -ld $(APP_TARGET_TEST_MIB)

CLEAN_RULES+= clean_app_target_test_mib
.PHONY: clean_app_target_test_mib
clean_app_target_test_mib:
	rm -f $(APP_TARGET_TEST_MIB) $(TEST_MIB_OBJ)

.PHONY: bin
bin: $(APP_TARGET_TEST_SHADERVG) $(APP_TARGET_TEST_MIN) $(APP_TARGET_TEST_MIB)
	@echo "minnie build finished at `date +%H:%M`."

include ${TKS_ROOT}/plugin_linux.mk

.PHONY: deploy_res
deploy_res:
	ssh $(BOARD_USER)@$(BOARD_IP) "mkdir -p $(BOARD_PATH)/resources/mib"
	$(RSYNC_CMD) ../../../tools/mib/mib $(BOARD_USER)@$(BOARD_IP):$(BOARD_PATH)/resources/

.PHONY: deploy
deploy: bin deploy_res
	scp $(APP_TARGET_TEST_SHADERVG) root@${BOARD_IP}:$(BOARD_PATH)
	scp $(APP_TARGET_TEST_MIN)      root@${BOARD_IP}:$(BOARD_PATH)
	scp $(APP_TARGET_TEST_MIB)      root@${BOARD_IP}:$(BOARD_PATH)
