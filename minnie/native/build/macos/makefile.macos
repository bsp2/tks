#
# Makefile for minnie lib and 'C' test cases on macOS / Clang platform
#
# (c) 2025-2026 Bastian Spiegel <bs@tkscript.de>
#

STATIC_TARGET=minnie.a
APP_TARGET_TEST_SHADERVG=test_shadervg

YAC_ROOTPATH=../../../../
include $(YAC_ROOTPATH)/install_macos.mk

OPTFLAGS= -Os

#EXTRAFLAGS+= -DSHADERVG_GLES
#EXTRAFLAGS+= -DSHADERVG_NO_ZS
#EXTRAFLAGS+= -DSHADERVG_NO_DISPLAY
#EXTRAFLAGS+= -DSHADERVG_MSAA
#EXTRAFLAGS+= -DSHADERVG_AUTO_EXIT_FRAMES=100

EXTRAFLAGS+= -DYAC_NO_HOST
EXTRAFLAGS+= -Wno-deprecated-declarations

# (note) not supported on macOS / Clang:
# (note)   https://developer.apple.com/library/archive/documentation/Performance/Conceptual/CodeFootprint/Articles/MachOOverview.html
#EXTRAFLAGS+= -ffunction-sections

LDFLAGS+= -Wl,-dead_strip

include ../config_common.mk

EXTRALIBS= -lSDL2 -framework OpenGL

PLAF_OBJ=

include ../make.objects

TEST_SHADERVG_OBJ += ../../hal_sdl2.o

$(APP_TARGET_TEST_SHADERVG): static_target $(TEST_SHADERVG_OBJ) $(ALL_OBJ)
	$(CPP) -o $(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ) $(ALL_OBJ) $(LDFLAGS) $(EXTRALIBS)
#	objdump -h ../../../shadervg/shadervg.o
ifneq ($(DEBUG),y)
	$(STRIP) $(APP_TARGET_TEST_SHADERVG)
endif
	ls -ld `find ../../../ -name \*.o`
	size -m ../../minnie_impl.o
#	objdump -t ../../../shadervg/shadervg.o | grep " F __TEXT"
#	nm -n ../../../shadervg/shadervg.o|grep ' _'|grep -v 'U _'
	nm -n ../../../shadervg/shadervg.o|grep ' _sdvg'
#	objdump --disassemble-symbols=_sdvg_SetPointRadius ../../../shadervg/shadervg.o
	objdump --disassemble-symbols=_sdvg_SetPointSize ../../../shadervg/shadervg.o
#	objdump --disassemble-symbols=_sdvg_End ../../../shadervg/shadervg.o
#	objdump --disassemble-symbols=_sdvg_Clear4f ../../../shadervg/shadervg.o
	strip $(APP_TARGET_TEST_SHADERVG) ; objdump -h $(APP_TARGET_TEST_SHADERVG)
	ls -ld $(APP_TARGET_TEST_SHADERVG)

CLEAN_RULES+= clean_app_target_test_shadervg
.PHONY: clean_app_target_test_shadervg
clean_app_target_test_shadervg:
	rm -f $(APP_TARGET_TEST_SHADERVG) $(TEST_SHADERVG_OBJ)

.PHONY: bin
bin: $(APP_TARGET_TEST_SHADERVG)
	@echo "minnie build finished at `date +%H:%M`."

include $(YAC_ROOTPATH)/plugin_macos.mk
