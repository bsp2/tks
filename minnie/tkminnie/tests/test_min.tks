// ----------------------------------------------------------------------------
function Test_17(boolean _bFill, boolean _bStroke) {
   // ellipse filled+stroked (tesselated)

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float rx = 4+40 + sin(anim_1) * 40;
   float ry = 4+30 + cos(anim_2) * 30;
   float sx = 320 + sin(anim_4*0.25) * 200;
   float sy = 240 + cos(anim_5*0.25) * 150;

   if(b_sym_radius)
   {
      rx = mathMinf(rx, ry);
      ry = rx;

      sx = mathMinf(sx, sy);
      sy = sx;
   }

   if(rx > (sx*0.495))
      rx = (sx*0.495);
   if(ry > (sy*0.495))
      ry = (sy*0.495);

   int pid = minBeginPath();
   minSeg(64);
   minMoveTo(400.0f*vpSclX, 300.0f*vpSclY);
   minEllipse(sx*0.5f*vpSclX, sy*0.5f*vpSclY);
   minEndPath(true/*bClosed*/);

   if(_bFill)
   {
      minColor(#ff324f75);  // green=6bd2b7
      minFill();
      minDrawPath(pid);
   }

   if(_bStroke)
   {
      minColor(#ffffffff);
      minStrokeWidth( (sinf(anim_3)*2.0f+3.0f)*vpSclX );
      minJoinBevel();
      minDrawPath(pid);
   }
}

