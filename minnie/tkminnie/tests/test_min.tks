//
//          UP : next test
//        DOWN : previous test
//       SPACE : toggle animation
// lctrl-SPACE : toggle slow-motion
//        LEFT : decrement stroke scale
//       RIGHT : increment stroke scale
//           c : toggle draw-copy
//           g : toggle draw-gl
//           l : toggle symmetry lock
//           m : toggle MSAA
//           o : cycle fill/stroke modes
//           p : save screenshot to "screenshots/api/minnie_api_test.png"
//           s : toggle line strips (off=tesselate via CPU)
//           t : toggle texture filter
//           v : toggle vsync
//

module Main;

use tksdl;
use tkopengl;
use tkminnie;
use tkmath;

namespace default;

boolean b_glcore = 1;

putenv("TKSDL_GLERROR=1");
if(b_glcore) putenv("TKSDL_GLCORE=1");   // select 4.1 core profile on macOS

// float VP_W = 800;  float VP_H = 600;
float VP_W = 454;  float VP_H = 454;
float vp_scale = 1;

boolean b_draw_gl       = 1;  // 'g'
boolean b_gl_buf_once   = 0;
boolean b_vsync         = 1;  // 'v'
boolean b_rotate        = 1;  // SPACE  (RETURN resets rot_angle)
boolean b_msaa          = 0;  // 1=use MSAA

boolean b_anim          = 1;  // SPACE
boolean b_slomo         = 0;  // lctrl-SPACE
int     fill_mode       = 3;  // 'o'  bit0:fill bit1:stroke
int     test_idx        = 0;  // UP/DOWN
int     auto_cycle_num_frames = 0; //200;  // >0:auto-cycle tests (any key stroke interrupts this)

boolean b_sym_radius    = 1;     // 'l'  (rx=ry)
float   stroke_scale    = 1.0f;  // LEFT/RIGHT
boolean b_line_strip    = 1;     // 's'  (0=tesselate via CPU)
boolean b_tex_filter    = 1;     // 't'
boolean b_copy          = 0;     // 'c'  draw shifted copy (mvp translatef)

String RES_PATH = "res/";


MinnieDrawable drawable;
drawable.init();
drawable.alloc(6*1024*1024/*maxGLBufSize*/,
                   32*1024/*maxDrawBufSize*/
               );

int tex_id;
Texture tex_data;

boolean b_reopen;  // 1=reopen window after exiting event loop (e.g. toggle MSAA)


// ---------------------------------------------------------------------------- vars
int num_frames_rendered = 0;

float anim_1;
float anim_2;
float anim_3;  // w
float anim_4;
float anim_5;
float anim_6;  // seg

boolean b_queued_screenshot;

StringArray test_names = ["00: concave path",
                          "01: sub-path",
                          "02: textured, flat shaded rectangles",
                          "03: textured, gouraud shaded rectangles",
                          "04: sine lines",
                          "05: round-rect filled+stroked (tesselated)",
                          "06: round-rect filled+stroked (shadervg)",
                          "07: round-rect stroked (tesselated)",
                          "08: round-rect stroked (shadervg)",
                          "09: round-rect filled (tesselated)",
                          "10: round-rect filled (shadervg)",
                          "11: rect filled+stroked (tesselated)",
                          "12: rect filled+stroked (shadervg)",
                          "13: rect stroked (tesselated)",
                          "14: rect stroked (shadervg)",
                          "15: rect filled (tesselated)",
                          "16: rect filled (shadervg)",
                          "17: ellipse filled+stroked (tesselated)",
                          "18: ellipse filled+stroked (shadervg)",
                          "19: ellipse stroked (tesselated)",
                          "20: ellipse stroked (shadervg)",
                          "21: ellipse filled (tesselated)",
                          "22: ellipse filled (shadervg)",
                          "23: arc filled",
                          "24: arc stroked",
                          "25: arc filled+stroked",
                          "26: arc stroke+pattern",
                          ];


// ----------------------------------------------------------------------------
function Test_00() {
   // concave path

   int pid = minBeginPath();
   minSeg(32);

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float rx = sin(anim_1) * 40;
   float ry = cos(anim_2) * 30;
   float sx = sin(anim_4) * 140;
   float sy = cos(anim_5) * 130;

   minMoveTo((100+rx)*vpSclX, (300+ry)*vpSclY);

   minCubicTo((300+sx)*vpSclX, (100+sy)*vpSclY,  // c1
              (500-sy)*vpSclX, (100-sx)*vpSclY,  // c2
              (700-ry)*vpSclX, (300-rx)*vpSclY   // dst
              );

   minCubicTo((500+sx)*vpSclX, (300+sy)*vpSclY,  // c1
              (250-sy)*vpSclX, (500-sx)*vpSclY,  // c2
              (100+rx)*vpSclX, (300+ry)*vpSclY   // dst
              );

   minEndPath(true/*bClosed*/);

   if(fill_mode & 1)
   {
      minFill();
      minColor(#ff324f75);  // green=6bd2b7
      minDrawPath(pid);
   }

   if(fill_mode & 2)
   {
      minStrokeWidth( (sin(anim_3)*2+3)*vpSclX );
      minColor(#ffffffff);
      minJoinBevel();
      minDrawPath(pid);
   }
}

// ----------------------------------------------------------------------------
function Test_01() {
   // sub-path

   int pid = minBeginPath();

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float segAmt = 0.5 + 0.5*sin(anim_6);
   segAmt *= segAmt;
   segAmt *= segAmt;
   minSeg(8 + 120*segAmt);

   float rx = sin(anim_1) * 40;
   float ry = cos(anim_2) * 30;
   float sx = sin(anim_4) * 140;
   float sy = cos(anim_5) * 130;

   // main
   minMoveTo((100+rx)*vpSclX, (300+ry)*vpSclY);

   float relx1 = (300 + sx) - (100 + rx);
   float rely1 = (100 + sy) - (300 + ry);
   minCubicTo((300 + sx)*vpSclX, (100 + sy)*vpSclY,
              (500 - sy)*vpSclX, (100 - sx)*vpSclY,
              (700 - ry)*vpSclX, (300 - rx)*vpSclY
              );

   float relx2 = (700-ry) - (500-sy);
   float rely2 = (300-rx) - (100-sx);
   minCubicTo((700-ry+relx2)*vpSclX, (300-rx+rely2)*vpSclY,
              (100+rx-relx1)*vpSclX, (300+ry-rely1)*vpSclY,
              (100+rx)*vpSclX,       (300+ry)*vpSclY
              );

   // sub 1
   minBeginSub();
   minMoveTo((300-ry)*vpSclX, (250+rx)*vpSclY);
   minEllipse(150*vpSclX, 150*vpSclY);
   minEndSubClosed();

   minEndPathClosed();

   if(fill_mode & 1)
   {
      minFill();
      minColor(#ff324f75);  // green=6bd2b7
      minDrawPath(pid);
   }

   if(fill_mode & 2)
   {
      minStrokeWidth( (sin(anim_3)*2+3)*vpSclX );
      minColor(#ffffffff);
      minJoinBevel();
      minDrawPath(pid);
   }

}

// ----------------------------------------------------------------------------
function Test_02() {
   // textured, flat shaded rectangles

   minBindTexture(tex_id, false/*bRepeat*/, b_tex_filter);
   minColor(#ffffffff);

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float x = sin(anim_1) * 400.0f - 400.0f + 125.0f/4;
   float y = cos(anim_2) * 300.0f - 300.0f + 100.0f/4;
   // trace "xxx t=("+x+";"+y+")";
   float ty = y;
   float ang5 = anim_5;
   loop(16)
   {
      float tx = x;
      float ang4 = anim_4;
      loop(16)
      {
         float nx = abs((tx - 400.0f) / 400.0f);
         float ny = abs((ty - 300.0f) / 300.0f);
         nx = 1.0 - nx;
         ny = 1.0 - ny;
         nx = 2.0 * nx - 1.0;
         ny = 2.0 * ny - 1.0;

         ang4 = PI*0.5;
         ang5 = 0;
         float w = (125/2) + (sin(ang4) * (75/2)) * nx;
         float h = (100/2) + (cos(ang5) * (50/2)) * ny;

         minRectTexUVFlat((tx - w*0.5)*vpSclX, (ty - h*0.5)*vpSclY, w*vpSclX, h*vpSclY,
                          0, 0,
                          1, 1
                          );
         tx += (200.0/2);
         ang4 += 0.9323;
      }
      ty += (150.0/2);
      ang5 += 0.715;
   }
}

// ----------------------------------------------------------------------------
function Test_03_calc_c32_at(float x, float y) {
   float nx = abs((x - 400.0f) / (400.0f));  // => -1..1
   float ny = abs((y - 300.0f) / (300.0f));
   nx = mathMaxf(0.0f, cos(nx * PI * 0.5));
   ny = mathMaxf(0.0f, cos(ny * PI * 0.5));
   float a = mathClampf(nx * ny, 0,1);
   return argb(a*255, 255, 255, 255);
}

function Test_03() {
   // textured, gouraud shaded rectangles

   minBindTexture(tex_id, false/*bRepeat*/, b_tex_filter);
   minColor(#ffffffff);

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float x = sin(anim_1) * 400.0f - 400.0f + (125/4);
   float y = cos(anim_2) * 300.0f - 300.0f + (100/4);
   float ty = y;
   float ang5 = anim_5;
   loop(16)
   {
      float tx = x;
      float ang4 = anim_4;
      loop(16)
      {
         float nx = abs((tx - 400.0f) / 400.0f);
         float ny = abs((ty - 300.0f) / 300.0f);
         nx = 1.0 - nx;
         ny = 1.0 - ny;
         nx = 2.0 * nx - 1.0;
         ny = 2.0 * ny - 1.0;

         ang4 = PI*0.5;
         ang5 = 0;
         float w = (125/2) + (sin(ang4) * (75/2)) * nx;
         float h = (100/2) + (cos(ang5) * (50/2)) * ny;

         minRectTexUVGouraud((tx - w*0.5)*vpSclX, (ty - h*0.5)*vpSclY, w*vpSclX, h*vpSclY,
                             0, 0,
                             1, 1,
                             Test_03_calc_c32_at(tx - w*0.5, ty - h*0.5),  // lt
                             Test_03_calc_c32_at(tx + w*0.5, ty - h*0.5),  // rt
                             Test_03_calc_c32_at(tx + w*0.5, ty + h*0.5),  // rb
                             Test_03_calc_c32_at(tx - w*0.5, ty + h*0.5)   // lb
                             );
         tx += (200.0/2);
         ang4 += 0.9323;
      }
      ty += (150.0/2);
      ang5 += 0.715;
   }
}

// ----------------------------------------------------------------------------
function Test_04() {
   // sine lines

   int pid = minBeginPath();

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   int numSeg = 64;
   int numPoints = numSeg + 1;
   float w = (2PI / numSeg);
   float a = anim_1;
   float x = 100.0f;
   float xStep = 600.0f / numSeg;
   int segIdx = 0;
   loop(numPoints)
   {
      float y = sin(a) * 150.0f + 300.0f;
      if(0 == segIdx++)
         minMoveTo(x*vpSclX, y*vpSclY);
      else
         minLineTo(x*vpSclX, y*vpSclY);
      a += w;
      x += xStep;
   }

   minEndPathOpen();

   minColor(#ffffffff);
   minStrokeWidth(4.0*vpSclX);
   minJoinBevel();
   minCapNone();
   minDrawPath(pid);
}

// ----------------------------------------------------------------------------
function Test_05(boolean _bFill, boolean _bStroke) {
   // round-rect filled+stroked (tesselated)

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float rx = 4.0f+40.0f + sinf(anim_1) * 40.0f;
   float ry = 4.0f+30.0f + cosf(anim_2) * 30.0f;
   float sx = 320.0f + sinf(anim_4*0.25f) * 200.0f;
   float sy = 240.0f + cosf(anim_5*0.25f) * 150.0f;

   if(b_sym_radius)
   {
      rx = mathMinf(rx, ry);
      ry = rx;
   }

   if(rx > (sx*0.495))
      rx = (sx*0.495);
   if(ry > (sy*0.495))
      ry = (sy*0.495);

   int pid = minBeginPath();
   minSeg(8);
   minMoveTo((400.0f-sx*0.5f)*vpSclX, (300.0f-sy*0.5f)*vpSclY);
   minRoundRect(sx*vpSclX, sy*vpSclY, rx*vpSclX, ry*vpSclY);
   minEndPath(true/*bClosed*/);

   if(_bFill)
   {
      minColor(#ff324f75);  // green=6bd2b7
      minFill();
      minDrawPath(pid);
   }

   if(_bStroke)
   {
      minColor(#ffffffff);
      minStrokeWidth( (sin(anim_3)*2+3)*vpSclX );
      minJoinMiter();
      minDrawPath(pid);
   }
}

// ----------------------------------------------------------------------------
function Test_06(boolean _bFill, boolean _bStroke) {
   // round-rect filled+stroked (shadervg)

   float vpSclX = Viewport.width  / 800.0f;
   float vpSclY = Viewport.height / 600.0f;

   float rx = 4.0f+40.0f + sinf(anim_1) * 40.0f;
   float ry = 4.0f+30.0f + cosf(anim_2) * 30.0f;
   float sx = 320.0f + sinf(anim_4*0.25f) * 200.0f;
   float sy = 240.0f + cosf(anim_5*0.25f) * 150.0f;

   if(b_sym_radius)
   {
      rx = mathMinf(rx, ry);
      ry = rx;
   }

   if(rx > (sx*0.495))
      rx = (sx*0.495);
   if(ry > (sy*0.495))
      ry = (sy*0.495);

   minBeginImmediate();
   minMoveTo((400.0f-sx*0.5f)*vpSclX, (300.0f-sy*0.5f)*vpSclY);

   if(_bFill)
   {
      minColor(#ff324f75);  // green=6bd2b7
      minFill();
      minRoundRect(sx*vpSclX, sy*vpSclY, rx*vpSclX, ry*vpSclY);
   }

   if(_bStroke)
   {
      minColor(#ffffffff);
      minStrokeWidth( (sin(anim_3)*2+3)*vpSclX );
      minRoundRect(sx*vpSclX, sy*vpSclY, rx*vpSclX, ry*vpSclY);
   }

   minEndImmediate();
}

