//
//          UP : next test
//        DOWN : previous test
//       SPACE : toggle animation
// lctrl-SPACE : toggle slow-motion
//        LEFT : decrement stroke scale
//       RIGHT : increment stroke scale
//           c : toggle draw-copy
//           g : toggle draw-gl
//           l : toggle symmetry lock (**removed**)
//           m : toggle MSAA
//           o : cycle fill/stroke modes
//           p : save screenshot to "screenshots/min/<testname>.png"
//           s : toggle line strips (off=tesselate via CPU)
//           t : toggle texture filter
//           v : toggle vsync
//

module Main;

use tksdl;
use tkopengl;
use tkminnie;
use tkmath;

namespace default;

boolean b_glcore = 1;

putenv("TKSDL_GLERROR=1");
if(b_glcore) putenv("TKSDL_GLCORE=1");   // select 4.1 core profile on macOS

float VP_W = 800;  float VP_H = 600;
// float VP_W = 454;  float VP_H = 454;
float vp_scale = 1;

boolean b_draw_gl       = 1;  // 'g'
boolean b_gl_buf_once   = 0;
boolean b_vsync         = 1;  // 'v'
boolean b_rotate        = 1;  // SPACE  (RETURN resets rot_angle)
boolean b_msaa          = 0;  // 1=use MSAA

boolean b_anim          = 1;  // SPACE
boolean b_slomo         = 0;  // lctrl-SPACE
int     fill_mode       = 3;  // 'o'  bit0:fill bit1:stroke
int     test_idx        = 0;  // UP/DOWN

int     auto_cycle_num_frames = 0; //200;  // >0:auto-cycle tests (any key stroke interrupts this)

int     auto_exit_frames  = 0;  // auto-exit after <n> frames (benchmark single test)
int     num_iter          = 1;
boolean b_benchmark       = 0;

boolean b_sym_radius    = 1;     // 'l'(removed)  (rx=ry)
float   stroke_scale    = 1.0f;  // LEFT/RIGHT
boolean b_tex_filter    = 1;     // 't'
boolean b_copy          = 0;     // 'c'  draw shifted copy (mvp translatef)

String RES_PATH = "res/";


MinnieDrawable drawable;
drawable.init();
drawable.alloc(6*1024*1024/*maxGLBufSize*/,
                   32*1024/*maxDrawBufSize*/
               );

int tex_id;
Texture tex_data;

IntArray gradient_colors = [#FFFF0000, #FFFFFF00, #FF00FF00, #FF00FFff, #FF0000ff];
IntArray gradient_starts = [0,         200,       400,       500,       1000];
Texture tex_gradient;
tex_gradient.alloc(256,1,4);
int tex_gradient_id;

boolean b_reopen;  // 1=reopen window after exiting event loop (e.g. toggle MSAA)


