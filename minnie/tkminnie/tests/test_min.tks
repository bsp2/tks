// ---------------------------------------------------------------------------- rand
UnsignedInteger loc_rand = 0;
Buffer b_f2i; b_f2i.size = 4;
function loc_rand_seed(int _seed) {
   loc_rand = _seed ^ 78163;
}

function loc_randu() {
   UnsignedInteger x = ( (loc_rand >> 16) + 3715436908 ) * 0x1fd8dae7;
   loc_rand += x;
   return loc_rand;
}

function loc_randf(float _max) {
   UnsignedInteger r = 0x3f800000;
   r |= (loc_randu() & ((1 << 23) - 1));
   b_f2i.pokeI32(0, r);
   return (b_f2i.peekF32(0) - 1.0f) * _max;
}

// ----------------------------------------------------------------------------
function Test_00() {
   // concave path

   int pid = minBeginPath();
   minSeg(32);

   float rx = sin(anim_1) * 40;
   float ry = cos(anim_2) * 30;
   float sx = sin(anim_4) * 140;
   float sy = cos(anim_5) * 130;

   minMoveTo(100+rx, 300+ry);

   minCubicTo(300 + sx, 100 + sy,  // c1
              500 - sy, 100 - sx,  // c2
              700 - ry, 300 - rx   // dst
              );

   minCubicTo(500 + sx, 300 + sy,  // c1
              250 - sy, 500 - sx,  // c2
              100 + rx, 300 + ry   // dst
              );

   minEndPathClosed();

   if(fill_mode & 1)
   {
      minFill();
      minColor(#ff324f75);  // green=6bd2b7
      minDrawPath(pid);
   }

   if(fill_mode & 2)
   {
      minStrokeWidth( 2.0f * (sin(anim_3)*2+3) );
      minColor(#ffffffff);
      minJoinBevel();
      minDrawPath(pid);
   }
}

// ----------------------------------------------------------------------------
function Test_01() {
   // sub-path

   int pid = minBeginPath();

   float segAmt = 0.5 + 0.5*sin(anim_6);
   segAmt *= segAmt;
   segAmt *= segAmt;
   minSeg(8 + 120*segAmt);

   float rx = sin(anim_1) * 40;
   float ry = cos(anim_2) * 30;
   float sx = sin(anim_4) * 140;
   float sy = cos(anim_5) * 130;

   // main
   minMoveTo(100 + rx, 300 + ry);

   float relx1 = (300 + sx) - (100 + rx);
   float rely1 = (100 + sy) - (300 + ry);
   minCubicTo(300 + sx, 100 + sy,
              500 - sy, 100 - sx,
              700 - ry, 300 - rx
              );

   float relx2 = (700 - ry) - (500 - sy);
   float rely2 = (300 - rx) - (100 - sx);
   minCubicTo(700 - ry + relx2, 300 - rx + rely2,
              100 + rx - relx1, 300 + ry - rely1,
              100 + rx,         300 + ry
              );

   // sub 1
   minBeginSub();
   minMoveTo(300 - ry, 250 + rx);
   minEllipse(150, 150);
   minEndSubClosed();

   minEndPathClosed();

   if(fill_mode & 1)
   {
      minFill();
      minColor(#ff324f75);  // green=6bd2b7
      minDrawPath(pid);
   }

   if(fill_mode & 2)
   {
      minStrokeWidth( 2.0f * (sin(anim_3)*2+3) );
      minColor(#ffffffff);
      minJoinBevel();
      minDrawPath(pid);
   }

}

// ----------------------------------------------------------------------------
function Test_02() {
   // textured, flat shaded rectangles

   minBindTexture(tex_id, false/*bRepeat*/, b_tex_filter);
   minColor(#ffffffff);

   float x = sin(anim_1) * 400.0f - 400.0f + 125.0f/4;
   float y = cos(anim_2) * 300.0f - 300.0f + 100.0f/4;
   // trace "xxx t=("+x+";"+y+")";
   float ty = y;
   float ang5 = anim_5;
   loop(16)
   {
      float tx = x;
      float ang4 = anim_4;
      loop(16)
      {
         float nx = abs((tx - 400.0f) / 400.0f);
         float ny = abs((ty - 300.0f) / 300.0f);
         nx = 1.0 - nx;
         ny = 1.0 - ny;
         nx = 2.0 * nx - 1.0;
         ny = 2.0 * ny - 1.0;

         ang4 = PI*0.5;
         ang5 = 0;
         float w = (125/2) + (sin(ang4) * (75/2)) * nx;
         float h = (100/2) + (cos(ang5) * (50/2)) * ny;

         minRectTexUVFlat(tx - w*0.5, ty - h*0.5, w, h,
                          0, 0,
                          1, 1
                          );
         tx += (200.0/2);
         ang4 += 0.9323;
      }
      ty += (150.0/2);
      ang5 += 0.715;
   }
}

// ----------------------------------------------------------------------------
function Test_03_calc_c32_at(float x, float y) {
   float nx = abs((x - 400.0f) / (400.0f));  // => -1..1
   float ny = abs((y - 300.0f) / (300.0f));
   nx = mathMaxf(0.0f, cos(nx * PI * 0.5));
   ny = mathMaxf(0.0f, cos(ny * PI * 0.5));
   float a = mathClampf(nx * ny, 0,1);
   return argb(a*255, 255, 255, 255);
}

function Test_03() {
   // textured, gouraud shaded rectangles

   minBindTexture(tex_id, false/*bRepeat*/, b_tex_filter);
   minColor(#ffffffff);

   float x = sin(anim_1) * 400.0f - 400.0f + (125/4);
   float y = cos(anim_2) * 300.0f - 300.0f + (100/4);
   float ty = y;
   float ang5 = anim_5;
   loop(16)
   {
      float tx = x;
      float ang4 = anim_4;
      loop(16)
      {
         float nx = abs((tx - 400.0f) / 400.0f);
         float ny = abs((ty - 300.0f) / 300.0f);
         nx = 1.0 - nx;
         ny = 1.0 - ny;
         nx = 2.0 * nx - 1.0;
         ny = 2.0 * ny - 1.0;

         ang4 = PI*0.5;
         ang5 = 0;
         float w = (125/2) + (sin(ang4) * (75/2)) * nx;
         float h = (100/2) + (cos(ang5) * (50/2)) * ny;

         minRectTexUVGouraud(tx - w*0.5, ty - h*0.5,
                             w, h,
                             0, 0,
                             1, 1,
                             Test_03_calc_c32_at(tx - w*0.5, ty - h*0.5),  // lt
                             Test_03_calc_c32_at(tx + w*0.5, ty - h*0.5),  // rt
                             Test_03_calc_c32_at(tx + w*0.5, ty + h*0.5),  // rb
                             Test_03_calc_c32_at(tx - w*0.5, ty + h*0.5)   // lb
                             );
         tx += (200.0/2);
         ang4 += 0.9323;
      }
      ty += (150.0/2);
      ang5 += 0.715;
   }
}

// ----------------------------------------------------------------------------
function Test_04() {
   // sine lines

   int pid = minBeginPath();

   int numSeg = 64;
   int numPoints = numSeg + 1;
   float w = (2PI / numSeg);
   float a = anim_1;
   float x = 100.0f;
   float xStep = 600.0f / numSeg;
   int segIdx = 0;
   loop(numPoints)
   {
      float y = sin(a) * 150.0f + 300.0f;
      if(0 == segIdx++)
         minMoveTo(x, y);
      else
         minLineTo(x, y);
      a += w;
      x += xStep;
   }

   minEndPathOpen();

   minColor(#ffffffff);
   minStrokeWidth(2.0f * 4.0);
   minJoinBevel();
   minCapRound();
   minDrawPath(pid);
}

// ----------------------------------------------------------------------------
function Test_05(boolean _bFill, boolean _bStroke) {
   // round-rect filled+stroked (tesselated)

   float rx = 4.0f+40.0f + sinf(anim_1) * 40.0f;
   float ry = 4.0f+30.0f + cosf(anim_2) * 30.0f;
   float sx = 320.0f + sinf(anim_4*0.25f) * 200.0f;
   float sy = 240.0f + cosf(anim_5*0.25f) * 150.0f;

   if(b_sym_radius)
   {
      rx = mathMinf(rx, ry);
      ry = rx;
   }

   if(rx > (sx*0.495))
      rx = (sx*0.495);
   if(ry > (sy*0.495))
      ry = (sy*0.495);

   int pid = minBeginPath();
   minSeg(8);
   minMoveTo(400.0f - sx * 0.5f,
             300.0f - sy * 0.5f
             );
   minRoundRect(sx, sy, rx, ry);
   minEndPathClosed();

   if(_bFill)
   {
      minColor(#ff324f75);  // green=6bd2b7
      minFill();
      minDrawPath(pid);
   }

   if(_bStroke)
   {
      minColor(#ffffffff);
      minStrokeWidth( 2.0f * (sin(anim_3)*2+3) );
      minJoinMiter();
      minDrawPath(pid);
   }
}

// ----------------------------------------------------------------------------
function Test_06(boolean _bFill, boolean _bStroke) {
   // round-rect filled+stroked (shadervg)

   float rx = 4.0f+40.0f + sinf(anim_1) * 40.0f;
   float ry = 4.0f+30.0f + cosf(anim_2) * 30.0f;
   float sx = 320.0f + sinf(anim_4*0.25f) * 200.0f;
   float sy = 240.0f + cosf(anim_5*0.25f) * 150.0f;

   if(b_sym_radius)
   {
      rx = mathMinf(rx, ry);
      ry = rx;
   }

   if(rx > (sx*0.495))
      rx = (sx*0.495);
   if(ry > (sy*0.495))
      ry = (sy*0.495);

   minBeginImmediate();
   minMoveTo(400.0f - sx * 0.5f,
             300.0f - sy * 0.5f
             );

   if(_bFill)
   {
      minColor(#ff324f75);  // green=6bd2b7
      minFill();
      minRoundRect(sx, sy, rx, ry);
   }

   if(_bStroke)
   {
      minColor(#ffffffff);
      minStrokeWidth( 2.0f * (sin(anim_3)*2+3) );
      minRoundRect(sx, sy, rx, ry);
   }

   minEndImmediate();
}

